                        Tween(Check, 0.15, {BackgroundColor3 = T().ToggleOff}); Tween(cStroke, 0.15, {Color = T().Stroke})
                    else
                        table.insert(selected, opt)
                        Tween(Check, 0.15, {BackgroundColor3 = T().Accent}); Tween(cStroke, 0.15, {Color = T().AccentStroke})
                    end
                    updateCount()
                    pcall(callback, selected)
                end)
            end
            updateCount()
            RegisterRerender(function()
                local theme = T()
                Multi.BackgroundColor3 = theme.Element
                stroke.Color = theme.Stroke
                lbl.TextColor3 = theme.Text
                CountLbl.TextColor3 = theme.SubText
                Sign.TextColor3 = theme.SubText
                List.BackgroundColor3 = theme.ListBackground
                List.ScrollBarImageColor3 = theme.Stroke
                if iconLbl then iconLbl.ImageColor3 = theme.Text end
                for _, item in ipairs(optionButtons) do
                    if item.btn.Parent then
                        item.btn.BackgroundColor3 = theme.Element
                        item.label.TextColor3 = theme.SubText
                        local isSel = table.find(selected, item.opt) ~= nil
                        item.check.BackgroundColor3 = isSel and theme.Accent or theme.ToggleOff
                        item.stroke.Color = isSel and theme.AccentStroke or theme.Stroke
                    end
                end
            end)
            local obj = {}
            function obj:Set(vals) selected = vals or {}; updateCount(); pcall(callback, selected) end
            function obj:Get() return selected end
            if flag then Library.Flags[flag] = selected; Library.Options[flag] = obj end
            return obj
        end

        function Elements:ColorPicker(arg1, arg2, arg3, arg4, arg5)
            local o = ParseArgs(arg1, arg2, arg3, arg4)
            local name, default, callback, flag, tooltip, icon = o.Title, o.Color, o.Callback, o.Flag, o.Description, o.Icon
            local hasIcon = icon and icon ~= ""
            local h, s, v = Color3.toHSV(default)
            local color = default
            local Picker = New("Frame", {Parent = NewTab, BackgroundColor3 = T().Element, Size = UDim2.new(1, 0, 0, 112), ClipsDescendants = true})
            Corner(Picker, 5)
            local pStroke = Stroke(Picker, T().Stroke)
            local iconLbl, textX
            if hasIcon then
                iconLbl, textX = ElementIcon(Picker, icon)
            else
                textX = 12
            end
            local lbl = New("TextLabel", {Parent = Picker, BackgroundTransparency = 1, Size = UDim2.new(1, -(textX + 50), 0, 20), Position = UDim2.new(0, textX, 0, 18), Font = Enum.Font.Gotham, Text = name, TextColor3 = T().Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
            local Preview = New("Frame", {Parent = Picker, AnchorPoint = Vector2.new(1,0), BackgroundColor3 = color, Position = UDim2.new(1, -12, 0, 18), Size = UDim2.new(0, 30, 0, 20)})
            Corner(Preview, 4)
            local pvStroke = Stroke(Preview, T().Stroke)
            local tracks = {}
            local function makeTrack(yPos, gradient)
                local track = New("Frame", {Parent = Picker, BackgroundColor3 = T().SliderTrack, Position = UDim2.new(0, 12, 0, yPos), Size = UDim2.new(1, -24, 0, 16)})
                Corner(track, 8)
                if gradient then New("UIGradient", {Parent = track, Color = gradient}) end
                local knob = New("Frame", {Parent = track, AnchorPoint = Vector2.new(0.5,0.5), BackgroundColor3 = T().Text, Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 18, 0, 18), ZIndex = 2})
                Corner(knob, 9)
                local ks = Stroke(knob, T().StrokeHover, 2)
                table.insert(tracks, {track = track, knob = knob, stroke = ks})
                return track, knob
            end
            local hT, hK = makeTrack(46, ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)), ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)), ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)), ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0))})
            local sT, sK = makeTrack(68, ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromHSV(h,0,1)), ColorSequenceKeypoint.new(1, Color3.fromHSV(h,1,1))})
            local vT, vK = makeTrack(90, ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)), ColorSequenceKeypoint.new(1, Color3.fromHSV(h,s,1))})
            RegisterRerender(function()
                local theme = T()
                Picker.BackgroundColor3 = theme.Element
                pStroke.Color = theme.Stroke
                lbl.TextColor3 = theme.Text
                pvStroke.Color = theme.Stroke
                if iconLbl then iconLbl.ImageColor3 = theme.Text end
                for _, tr in ipairs(tracks) do tr.track.BackgroundColor3 = theme.SliderTrack; tr.knob.BackgroundColor3 = theme.Text; tr.stroke.Color = theme.StrokeHover end
            end)
            local function updateColor()
                color = Color3.fromHSV(h, s, v)
                Preview.BackgroundColor3 = color
                hK.Position = UDim2.new(h, 0, 0.5, 0)
                sK.Position = UDim2.new(s, 0, 0.5, 0)
                vK.Position = UDim2.new(v, 0, 0.5, 0)
                local sg = sT:FindFirstChildOfClass("UIGradient"); if sg then sg.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromHSV(h,0,1)), ColorSequenceKeypoint.new(1, Color3.fromHSV(h,1,1))} end
                local vg = vT:FindFirstChildOfClass("UIGradient"); if vg then vg.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)), ColorSequenceKeypoint.new(1, Color3.fromHSV(h,s,1))} end
                if flag then Library.Flags[flag] = color end
                pcall(callback, color)
            end
            local function bind(track, setter)
                local dragging = false
                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1); setter(rel); updateColor() end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1); setter(rel); updateColor() end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
                end)
            end
            bind(hT, function(r) h = r end); bind(sT, function(r) s = r end); bind(vT, function(r) v = r end)
            updateColor()
            AttachTooltip(lbl, tooltip)
            local obj = {}
            function obj:Set(c) color = c; h, s, v = Color3.toHSV(c); updateColor() end
            function obj:Get() return color end
            if flag then Library.Flags[flag] = color; Library.Options[flag] = obj end
            return obj
        end

