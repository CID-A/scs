                if iconLbl then iconLbl.ImageColor3 = theme.Text end
            end)
            local dragging = false
            local function visualUpdate(x)
                local rel = math.clamp((x - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                value = math.floor((minv + (maxv - minv) * rel) * 100 + 0.5) / 100
                Fill.Size = UDim2.new(rel, 0, 1, 0)
                Knob.Position = UDim2.new(rel, 0, 0.5, 0)
                ValueLbl.Text = tostring(value)
            end
            local function commit()
                if flag then Library.Flags[flag] = value end
                pcall(callback, value)
            end
            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    visualUpdate(input.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    visualUpdate(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        visualUpdate(input.Position.X)
                        commit()
                    end
                end
            end)
            AttachTooltip(lbl, tooltip)
            local obj = {}
            function obj:Set(v, fire)
