function Library:AddIcon(name, id)
    if type(name) == "string" and name ~= "" and type(id) == "string" then
        Library.Icons[name] = id
        return true
    end
    return false
end

function Library:GetIcon(name)
    if not name or name == "" then return "" end
    if type(name) ~= "string" then return "" end
    if name:sub(1, 10) == "rbxassetid" then return name end
    if name:sub(1, 4) == "http" then return name end
    if Library.Icons[name] then return Library.Icons[name] end
    local aliased = ICON_ALIASES[name]
    if aliased and Library.Icons[aliased] then return Library.Icons[aliased] end
    local cap = name:sub(1, 1):upper() .. name:sub(2)
    if Library.Icons[cap] then return Library.Icons[cap] end
    return ""
end

