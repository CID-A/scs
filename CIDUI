function Library:Create(TitleText, Options)
    Options = Options or {}
    return Library:CreateWindow({
        Title = TitleText or "Universal GUI",
        Subtitle = Options.Subtitle,
        Name = Options.Name or "CID_UI",
        Size = Options.Size,
        Theme = Options.Theme,
        ToggleKey = Options.ToggleKey,
        OpenButton = Options.OpenButton,
        PlayerInfo = Options.PlayerInfo,
    })
end

function Library:ToggleUI()
    if not self._libName then return end
    local gui = CoreGui:FindFirstChild(self._libName)
    if not gui then return end
    gui.Enabled = not gui.Enabled
    self.Open = gui.Enabled
end

function Library:DestroyUI(skipConfirm)
    if not self._libName then return end
    local gui = CoreGui:FindFirstChild(self._libName)
    if not gui then return end
    if skipConfirm then
        Library:RunCleanups(self._libName)
        Library._activeUIs[self._libName] = nil
        gui:Destroy()
    else
        Library:Confirm("DESTRUIR SCRIPT", "Estas seguro de destruir el script?", function()
            Library:RunCleanups(Library._libName)
            Library._activeUIs[Library._libName] = nil
            gui:Destroy()
        end, function() end, "Si", "No")
    end
end

function Library:DestroyAll()
    for name, _ in pairs(Library._activeUIs) do
        Library:RunCleanups(name)
        local g = CoreGui:FindFirstChild(name)
        if g then g:Destroy() end
        local tg = CoreGui:FindFirstChild("UniversalGUI_Toggle_" .. name)
        if tg then tg:Destroy() end
    end
    Library._activeUIs = {}
    for _, n in ipairs({"UniversalGUI_Notify", "UniversalGUI_Tooltip", "UniversalGUI_Dialog"}) do
        local g = CoreGui:FindFirstChild(n)
        if g then g:Destroy() end
    end
    for _, v in ipairs(CoreGui:GetChildren()) do
        if v.Name:sub(1, 19) == "UniversalGUI_Toggle" then v:Destroy() end
    end
    Library._rerenders = {}
    Library._notifications = {}
end

return Library
