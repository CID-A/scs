function Library:AddTheme(name, themeTable)
    if type(name) ~= "string" or type(themeTable) ~= "table" or name == "" then return false end
    local base = Library.Themes.Dark
    local merged = {}
    for k, v in pairs(base) do
        if themeTable[k] ~= nil and typeof(themeTable[k]) == "Color3" then merged[k] = themeTable[k]
        else merged[k] = v end
    end
    Library.Themes[name] = merged
    return true
end

function Library:RemoveTheme(name)
    if name == "Dark" then return false end
    if Library.Themes[name] then
        Library.Themes[name] = nil
        if Library._currentTheme == name then Library:SetTheme("Dark") end
        return true
    end
    return false
end

function Library:SetTheme(name)
    if not Library.Themes[name] then return false end
    Library._currentTheme = name
    local i = 1
    while i <= #Library._rerenders do
        local ok = pcall(Library._rerenders[i])
        if not ok then table.remove(Library._rerenders, i) else i = i + 1 end
    end
    return true
end

function Library:GetThemes()
    local list = {}
    for k in pairs(Library.Themes) do table.insert(list, k) end
    table.sort(list)
    return list
end

function Library:GetTheme() return Library._currentTheme end

local function T() return Library.Themes[Library._currentTheme] or Library.Themes.Dark end
local function RegisterRerender(fn) table.insert(Library._rerenders, fn); return fn end

local function New(class, props)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then o[k] = v end
        end
        if props.Parent then o.Parent = props.Parent end
    end
    return o
end

local function Tween(o, t, props, style, dir)
    if not o or not o.Parent then return end
    local ti = TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.InOut)
    local ok, tw = pcall(TweenService.Create, TweenService, o, ti, props)
    if ok and tw then tw:Play() end
    return tw
end

local function Corner(parent, r) return New("UICorner", {CornerRadius = UDim.new(0, r or 6), Parent = parent}) end

local function Stroke(parent, color, thickness)
    return New("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = color or Color3.fromRGB(81,81,81),
        Thickness = thickness or 1,
        LineJoinMode = Enum.LineJoinMode.Round,
        Parent = parent
    })
end

local function SafeDestroy(o) if o and o.Parent then o:Destroy() end end

local function CreateRipple(btn)
    if not btn or not btn.Parent then return end
    local sample = New("ImageLabel", {
        Parent = btn, BackgroundTransparency = 1, Image = "rbxassetid://4560909609",
        ImageColor3 = Color3.fromRGB(0,0,0), ImageTransparency = 0.6,
        Size = UDim2.new(0, 0, 0, 0), ZIndex = 5
    })
    local absX, absY = btn.AbsolutePosition.X, btn.AbsolutePosition.Y
    local mx, my
    if UserInputService.MouseEnabled and UserInputService:GetLastInputType() ~= Enum.UserInputType.Touch then
        local loc = UserInputService:GetMouseLocation()
        mx, my = loc.X, loc.Y
    else
        mx, my = absX + btn.AbsoluteSize.X/2, absY + btn.AbsoluteSize.Y/2
    end
    sample.Position = UDim2.new(0, mx - absX, 0, my - absY)
    local size = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 1.5
    sample:TweenSizeAndPosition(UDim2.new(0, size, 0, size), UDim2.new(0.5, -size/2, 0.5, -size/2), "Out", "Quad", 0.35, true)
    task.spawn(function()
        for _ = 1, 10 do
            if not sample.Parent then return end
            sample.ImageTransparency = sample.ImageTransparency + 0.05
            task.wait(0.03)
        end
        SafeDestroy(sample)
    end)
end

function Library:DraggingEnabled(handle, target)
    local dragging, dragInput, startPos, startFrame = false, nil, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startFrame = true, input.Position, target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and target.Parent then
            local delta = input.Position - startPos
            target.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + delta.X, startFrame.Y.Scale, startFrame.Y.Offset + delta.Y)
        end
    end)
end

function Library:ResizingEnabled(handle, target, minSize, maxSize)
    minSize = minSize or Vector2.new(480, 320)
    maxSize = maxSize or Vector2.new(1600, 900)
    local dragging, startPos, startSize = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startSize = true, input.Position, target.AbsoluteSize
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and target.Parent and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startPos
            local newX = math.clamp(startSize.X + delta.X, minSize.X, maxSize.X)
            local newY = math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
            target.Size = UDim2.new(0, newX, 0, newY)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

function Library:AddCleanup(fn, uiName)
    uiName = uiName or Library._libName or "global"
    Library.Cleanups[uiName] = Library.Cleanups[uiName] or {}
    table.insert(Library.Cleanups[uiName], fn)
    return fn
end

function Library:RemoveCleanup(fn, uiName)
    uiName = uiName or Library._libName or "global"
    local list = Library.Cleanups[uiName]
    if list then
        for i, f in ipairs(list) do
            if f == fn then table.remove(list, i); return true end
        end
    end
    return false
end

function Library:RunCleanups(uiName)
    uiName = uiName or Library._libName
    local list = Library.Cleanups[uiName]
    if list then
        for _, fn in ipairs(list) do pcall(fn) end
        Library.Cleanups[uiName] = nil
    end
end

local function EnsureFolder()
    if isfolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
end

function Library:SaveConfig(name)
    if not writefile then return false end
    EnsureFolder()
    local data = {}
    for flag, val in pairs(Library.Flags) do
        if typeof(val) == "Color3" then
            data[flag] = {__t = "Color3", R = val.R, G = val.G, B = val.B}
        elseif typeof(val) == "EnumItem" then
            data[flag] = {__t = "Enum", Type = tostring(val.EnumType), Name = val.Name}
        elseif typeof(val) == "table" then
            local safe = true
            for _, v in pairs(val) do
                local tv = typeof(v)
                if tv ~= "string" and tv ~= "number" and tv ~= "boolean" then safe = false; break end
            end
            if safe then data[flag] = val end
        else
            data[flag] = val
        end
    end
    data.__theme = Library._currentTheme
    local ok = pcall(function() writefile(CONFIG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(data)) end)
    return ok
end

function Library:LoadConfig(name)
    if not readfile or not isfile then return false end
    EnsureFolder()
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or typeof(decoded) ~= "table" then return false end
    if decoded.__theme and Library.Themes[decoded.__theme] then Library:SetTheme(decoded.__theme) end
    for flag, val in pairs(decoded) do
        if flag ~= "__theme" then
            if typeof(val) == "table" and val.__t == "Color3" then
                val = Color3.new(val.R, val.G, val.B)
            elseif typeof(val) == "table" and val.__t == "Enum" then
                local ok2, enum = pcall(function() return Enum[val.Type][val.Name] end)
                if ok2 then val = enum end
            end
            Library.Flags[flag] = val
            local opt = Library.Options[flag]
            if opt and opt.Set then pcall(function() opt:Set(val) end) end
        end
    end
    return true
end

function Library:GetConfigs()
    if not listfiles then return {} end
    EnsureFolder()
    local list = {}
    local ok, files = pcall(listfiles, CONFIG_FOLDER)
    if ok then
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(list, n) end
        end
    end
    return list
end

function Library:DeleteConfig(name)
    if not delfile then return false end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if isfile and isfile(path) then return pcall(delfile, path) end
    return false
end

local function RepositionNotifications()
    local n = #Library._notifications
    for i, item in ipairs(Library._notifications) do
        if item.frame and item.frame.Parent then
            local y = NOTIFY_BASE_Y - ((n - i) * (NOTIFY_HEIGHT + NOTIFY_GAP))
            Tween(item.frame, 0.3, {Position = UDim2.new(1, -320, 1, y)})
        end
    end
end

local function RemoveNotification(item, fast)
    for i, v in ipairs(Library._notifications) do
        if v == item then table.remove(Library._notifications, i); break end
    end
    if item.frame and item.frame.Parent then
        local dur = fast and 0.15 or 0.3
        local curY = item.frame.Position.Y.Offset
        Tween(item.frame, dur, {Position = UDim2.new(1, 320, 1, curY), BackgroundTransparency = 1})
        for _, v in ipairs(item.frame:GetDescendants()) do
            if v:IsA("GuiObject") then
                local p = {BackgroundTransparency = 1}
                if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then p.TextTransparency = 1 end
                if v:IsA("ImageLabel") or v:IsA("ImageButton") then p.ImageTransparency = 1 end
                Tween(v, dur, p)
            end
        end
        task.delay(dur + 0.1, function() SafeDestroy(item.frame) end)
    end
    RepositionNotifications()
end

function Library:Notify(title, content, duration, image)
    title = title or "Notificacion"
    content = content or ""
    duration = duration or 4
    while #Library._notifications >= NOTIFY_MAX do
        RemoveNotification(Library._notifications[1], true)
    end
    local gui = CoreGui:FindFirstChild("UniversalGUI_Notify")
    if not gui then
        gui = New("ScreenGui", {
            Name = "UniversalGUI_Notify", Parent = CoreGui, ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = Library.DisplayOrder
        })
    end
    local th = T()
    local N = New("Frame", {
        Parent = gui, Size = UDim2.new(0, 300, 0, NOTIFY_HEIGHT),
        Position = UDim2.new(1, 320, 1, NOTIFY_BASE_Y),
        BackgroundColor3 = th.Element, BackgroundTransparency = 1
    })
    Corner(N, 6)
    local strk = Stroke(N, th.Stroke); strk.Transparency = 1
    local Ind = New("Frame", {Parent = N, Size = UDim2.new(0, 4, 1, -12), Position = UDim2.new(0, 6, 0, 6), BackgroundColor3 = th.Accent, BackgroundTransparency = 1})
    Corner(Ind, 4)
    local TitleLbl = New("TextLabel", {Parent = N, BackgroundTransparency = 1, Size = UDim2.new(1, -30, 0, 20), Position = UDim2.new(0, 20, 0, 8), Font = Enum.Font.GothamBold, Text = title, TextColor3 = th.Text, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1})
    local ContentLbl = New("TextLabel", {Parent = N, BackgroundTransparency = 1, Size = UDim2.new(1, -30, 1, -32), Position = UDim2.new(0, 20, 0, 26), Font = Enum.Font.Gotham, Text = content, TextColor3 = th.SubText, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextTransparency = 1})
    if image then
        local I = New("ImageLabel", {Parent = N, BackgroundTransparency = 1, Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -30, 0, 8), Image = Library:GetIcon(image), ImageTransparency = 1, ScaleType = Enum.ScaleType.Fit})
        Tween(I, 0.25, {ImageTransparency = 0})
    end
    local item = {frame = N}
    table.insert(Library._notifications, item)
    RepositionNotifications()
    Tween(N, 0.25, {BackgroundTransparency = 0})
    Tween(strk, 0.25, {Transparency = 0})
    Tween(Ind, 0.25, {BackgroundTransparency = 0})
    Tween(TitleLbl, 0.25, {TextTransparency = 0})
    Tween(ContentLbl, 0.25, {TextTransparency = 0})
    task.delay(duration, function()
        RemoveNotification(item)
    end)
end

function Library:ChooseDialog(title, content, buttons)
    title = title or "Confirmar"
    content = content or ""
    local gui = CoreGui:FindFirstChild("UniversalGUI_Dialog")
    if gui then gui:Destroy() end
    gui = New("ScreenGui", {
        Name = "UniversalGUI_Dialog", Parent = CoreGui, ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = Library.DisplayOrder + 10
    })
    local th = T()
    local Overlay = New("TextButton", {
        Parent = gui, Size = UDim2.new(1,0,1,0),
        BackgroundColor3 = Color3.fromRGB(0,0,0),
        BackgroundTransparency = 0.75, Text = "", AutoButtonColor = false, ZIndex = 100
    })
    Tween(Overlay, 0.25, {BackgroundTransparency = 0.75})

    local BOX_W = 440
    local BOX_H = 200

    local Box = New("Frame", {
        Parent = Overlay, AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(0.5,0,0.5,0),
        Size = UDim2.new(0, BOX_W, 0, BOX_H),
        BackgroundColor3 = th.Background, BackgroundTransparency = 1, ZIndex = 101
    })
    Corner(Box, 8)
    local strk = Stroke(Box, th.Stroke); strk.Transparency = 1
    Box.Size = UDim2.new(0, 0, 0, 0)
    Tween(Box, 0.25, {Size = UDim2.new(0, BOX_W, 0, BOX_H), BackgroundTransparency = 0}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(strk, 0.25, {Transparency = 0})

    New("TextLabel", {Parent = Box, BackgroundTransparency = 1, Size = UDim2.new(1,-28,0,30), Position = UDim2.new(0,14,0,14), Font = Enum.Font.GothamBold, Text = title, TextColor3 = th.Text, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left})
    New("TextLabel", {Parent = Box, BackgroundTransparency = 1, Size = UDim2.new(1,-28,0,70), Position = UDim2.new(0,14,0,52), Font = Enum.Font.Gotham, Text = content, TextColor3 = th.SubText, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true})

    local function close()
        Tween(Box, 0.2, {Size = UDim2.new(0,0,0,0), BackgroundTransparency = 1})
        Tween(strk, 0.2, {Transparency = 1})
        Tween(Overlay, 0.2, {BackgroundTransparency = 1})
        task.wait(0.22)
        SafeDestroy(gui)
    end

    buttons = buttons or {
        {Text = "Cancelar", Color = th.ElementActive, Callback = function() end},
        {Text = "Confirmar", Color = th.Accent, Callback = function() end},
    }

    local n = #buttons
    local bw = 120
    local gap = 12
    local totalW = n * bw + (n - 1) * gap
    local startX = (BOX_W - totalW) / 2

    for i, b in ipairs(buttons) do
        local btn = New("TextButton", {
            Parent = Box, AnchorPoint = Vector2.new(0,1),
            Position = UDim2.new(0, startX + (i-1)*(bw+gap), 1, -16),
            Size = UDim2.new(0, bw, 0, 38),
            BackgroundColor3 = b.Color or th.ElementActive,
            Text = b.Text or "OK", Font = Enum.Font.GothamBold,
            TextColor3 = th.Text, TextSize = 13, AutoButtonColor = false,
            ZIndex = 102
        })
        Corner(btn, 6)
        btn.MouseEnter:Connect(function()
            local base = b.Color or th.ElementActive
            Tween(btn, 0.1, {BackgroundColor3 = Color3.new(math.min(base.R+0.1,1), math.min(base.G+0.1,1), math.min(base.B+0.1,1))})
        end)
        btn.MouseLeave:Connect(function() Tween(btn, 0.1, {BackgroundColor3 = b.Color or th.ElementActive}) end)
        btn.MouseButton1Click:Connect(function()
            close()
            if b.Callback then task.spawn(function() pcall(b.Callback) end) end
        end)
    end
    return gui
end

