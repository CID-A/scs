local function CreateToggleButton(lib, cfg)
    cfg = cfg or {}
    if cfg.Enabled == false then return end
    local text = cfg.Text
    local icon = cfg.Icon or ""
    local size = cfg.Size or UDim2.fromOffset(78, 34)
    local pos = cfg.Position or UDim2.new(0.02, 0, 0.45, 0)
    local bgColor = cfg.BackgroundColor
    local textColor = cfg.TextColor
    local iconColor = cfg.IconColor
    local draggable = cfg.Draggable
    if draggable == nil then draggable = true end
    local hasIcon = icon ~= "" and icon ~= nil
    if not hasIcon and not text then text = "ABRIR" end
    local gui = New("ScreenGui", {
        Name = "UniversalGUI_Toggle_" .. (lib._libName or "x"), Parent = CoreGui,
        ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = Library.DisplayOrder
    })
    local Btn = New("TextButton", {
        Parent = gui, Name = "Toggle",
        BackgroundColor3 = bgColor or T().Element,
        BackgroundTransparency = bgColor and 0 or 0.15,
        Position = pos, Size = size,
        Font = Enum.Font.GothamBold,
        Text = hasIcon and "" or (text or "ABRIR"),
        TextColor3 = textColor or T().Text, TextSize = 14,
        AutoButtonColor = false, Active = true
    })
    Corner(Btn, 8)
    local strk = Stroke(Btn, T().Stroke)
    local iconLbl
    if hasIcon then
        iconLbl = New("ImageLabel", {
            Parent = Btn, AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0.65, 0, 0.65, 0),
            BackgroundTransparency = 1,
            Image = Library:GetIcon(icon),
            ImageColor3 = iconColor or T().Accent,
            ScaleType = Enum.ScaleType.Fit
        })
    end
    RegisterRerender(function()
        local theme = T()
        Btn.BackgroundColor3 = bgColor or theme.Element
        Btn.BackgroundTransparency = bgColor and 0 or 0.15
        if not hasIcon then Btn.TextColor3 = textColor or theme.Text end
        if iconLbl then iconLbl.ImageColor3 = iconColor or theme.Accent end
        strk.Color = theme.Stroke
    end)
    if draggable then lib:DraggingEnabled(Btn, Btn) end
    Btn.MouseEnter:Connect(function()
        local theme = T()
        if not bgColor then Tween(Btn, 0.15, {BackgroundColor3 = theme.ElementHover}) end
        Tween(strk, 0.15, {Color = theme.StrokeHover})
        if not hasIcon and not textColor then Tween(Btn, 0.15, {TextColor3 = theme.Text}) end
    end)
    Btn.MouseLeave:Connect(function()
        local theme = T()
        if not bgColor then Tween(Btn, 0.15, {BackgroundColor3 = theme.Element}) end
        Tween(strk, 0.15, {Color = theme.Stroke})
        if not hasIcon and not textColor then Tween(Btn, 0.15, {TextColor3 = theme.Text}) end
    end)
    Btn.MouseButton1Click:Connect(function() lib:ToggleUI() end)
    return gui
end

