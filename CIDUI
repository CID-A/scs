local function ParseArgs(a, b, c, d, e, f)
    if type(a) == "table" then
        local t = a
        return {
            Title = t.Title or t.title or t.Name or t.name or "Untitled",
            Callback = t.Callback or t.CallBack or t.callback or t.Func or t.func or t.Function or function() end,
            OnChange = t.OnChange or t.onChange or t.OnChanged,
            Flag = t.Flag or t.flag,
            Description = t.Description or t.description or t.Tooltip or t.tooltip or t.Tip or t.tip,
            Icon = t.Icon or t.icon,
            Default = t.Default or t.default,
            Placeholder = t.Placeholder or t.placeholder,
            Options = t.Options or t.options or {},
            Min = t.Min or t.min or 0,
            Max = t.Max or t.max or 100,
            Key = t.Key or t.key or Enum.KeyCode.F,
            Height = t.Height or t.height or 120,
            Image = t.Image or t.image or "",
            Color = t.Color or t.color or Color3.fromRGB(255,255,255),
            Text = t.Text or t.text or "",
            Value = t.Value or t.value,
        }
    end
    return {
        Title = a or "Untitled",
        Callback = b or function() end,
        Flag = c,
        Description = d,
        Icon = nil,
        Default = e,
        Placeholder = f,
    }
end

function Library:CreateWindow(config)
    config = config or {}
    local title = config.Title or "Universal GUI"
    local subtitle = config.Subtitle or ""
    local uiName = config.Name or "CID_UI"
    if uiName == "" then uiName = "CID_UI" end
    if config.Theme and Library.Themes[config.Theme] then Library:SetTheme(config.Theme) end
    if config.ToggleKey then Library.ToggleKey = config.ToggleKey end
    local winSize = config.Size or UDim2.fromOffset(620, 420)
    if typeof(winSize) == "Vector2" then winSize = UDim2.fromOffset(winSize.X, winSize.Y) end

    local function findExisting(name)
        if Library._activeUIs[name] and Library._activeUIs[name].gui and Library._activeUIs[name].gui.Parent then
            return Library._activeUIs[name]
        end
        local inCore = CoreGui:FindFirstChild(name)
        if inCore then return {gui = inCore, cleanups = Library.Cleanups[name] or {}} end
        return nil
    end

    local existing = findExisting(uiName)
    if existing then
        local choice
        local ev = Instance.new("BindableEvent")
        local th = T()
        Library:ChooseDialog("YA EXISTE UN SCRIPT", "Ya hay una UI llamada '" .. uiName .. "'. Que quieres hacer?", {
            {Text = "Cancelar", Color = th.ElementActive, Callback = function() choice = "cancel"; ev:Fire() end},
            {Text = "Reemplazar", Color = th.Danger, Callback = function() choice = "replace"; ev:Fire() end},
            {Text = "Ambos", Color = th.Accent, Callback = function() choice = "both"; ev:Fire() end},
        })
