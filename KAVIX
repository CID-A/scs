                    if sub then sub.ImageColor3 = theme.Text end
                end
                for _, item in ipairs(optionButtons) do
                    if item.btn.Parent then
                        item.btn.BackgroundColor3 = theme.Element
                        item.label.TextColor3 = theme.SubText
                        local isSel = table.find(selected, item.opt) ~= nil
                        item.check.BackgroundColor3 = isSel and theme.Accent or theme.ToggleOff
                        item.stroke.Color = isSel and theme.AccentStroke or theme.Stroke
                    end
                end
            end)
            local obj = {}
            function obj:Set(vals)
                selected = vals or {}
                updateCount()
                pcall(callback, selected)
            end
            function obj:Get()
                return selected
            end
