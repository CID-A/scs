function Library:LoadLucide()
    local ok, result = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/lucide/dist/Icons.lua"))()
    end)
    if not ok or type(result) ~= "table" then
        return false
    end
    for k, v in pairs(result) do
        Library.LucideIcons[k] = v
    end
    Library.IconPacksLoaded = true
    return true
end

function Library:AddIcon(name, id)
    if type(name) == "string" and name ~= "" and type(id) == "string" then
        Library.Icons[name] = id
        return true
    end
    return false
end

function Library:GetIcon(name)
    if not name or name == "" then return "" end
    if type(name) ~= "string" then return "" end
    if name:sub(1, 10) == "rbxassetid" then return name end
    if name:sub(1, 4) == "http" then return name end
    if Library.Icons[name] then return Library.Icons[name] end
    if Library.LucideIcons[name] then return Library.LucideIcons[name] end
    local cap = name:sub(1, 1):upper() .. name:sub(2)
    if Library.Icons[cap] then return Library.Icons[cap] end
    if Library.LucideIcons[cap] then return Library.LucideIcons[cap] end
    if Library.LucideIcons[name:lower()] then return Library.LucideIcons[name:lower()] end
    return ""
end

