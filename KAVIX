    while #Library._notifications >= NOTIFY_MAX do
        RemoveNotif(Library._notifications[1], true)
    end
    local th = T()
    local glass = th.Glass or 0
    local N = New("Frame", {
        Parent = folder,
        Size = UDim2.new(0, 300, 0, NOTIFY_HEIGHT),
        Position = UDim2.new(1, 320, 1, NOTIFY_BASE_Y),
