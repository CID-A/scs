    if uiName == "" then uiName = "CID_UI" end
    if config.Theme and Library.Themes[config.Theme] then
        Library:SetTheme(config.Theme)
    end
    if config.ToggleKey then
        Library.ToggleKey = config.ToggleKey
    end
    local winSize = config.Size or UDim2.fromOffset(620, 420)
    if typeof(winSize) == "Vector2" then
        winSize = UDim2.fromOffset(winSize.X, winSize.Y)
    end
    local function findExisting(name)
        if Library._activeUIs[name] and Library._activeUIs[name].gui and Library._activeUIs[name].gui.Parent then
            return Library._activeUIs[name]
        end
        local inContainer = UI_CONTAINER:FindFirstChild(name)
        if inContainer then
            return { gui = inContainer, cleanups = Library.Cleanups[name] or {} }
        end
        return nil
    end
    local existing = findExisting(uiName)
    if existing then
        local choice
        local ev = Instance.new("BindableEvent")
        local th = T()
        Library:ChooseDialog(
            "YA EXISTE UN SCRIPT",
            "Ya hay una UI llamada '" .. uiName .. "'. Que quieres hacer?",
            {
                { Text = "Cancelar", Color = th.ElementActive, Callback = function() choice = "cancel"; ev:Fire() end },
                { Text = "Reemplazar", Color = th.Danger, Callback = function() choice = "replace"; ev:Fire() end },
                { Text = "Ambos", Color = th.Accent, Callback = function() choice = "both"; ev:Fire() end },
            }
        )
        ev.Event:Wait()
        if choice == "cancel" then return nil end
        if choice == "replace" then
            Library:RunCleanups(uiName)
            Kill(existing.gui)
            Library._activeUIs[uiName] = nil
        elseif choice == "both" then
            local i = 2
            while findExisting(uiName .. i) do
                i = i + 1
            end
