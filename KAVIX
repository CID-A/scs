function Library:Create(TitleText, Options)
    Options = Options or {}
    return Library:CreateWindow({
        Title = TitleText or "Universal GUI",
        Subtitle = Options.Subtitle,
        Name = Options.Name or "CID_UI",
        Size = Options.Size,
        Theme = Options.Theme,
        ToggleKey = Options.ToggleKey,
        OpenButton = Options.OpenButton,
        PlayerInfo = Options.PlayerInfo,
    })
end

function Library:ToggleUI()
    if not self._mainGui then return end
    local Main = self._mainGui:FindFirstChild("Main")
    if not Main then return end
    Main.Visible = not Main.Visible
    self.Open = Main.Visible
    Library:UpdateBlur()
end

function Library:DestroyUI(skipConfirm)
    if not self._mainGui then return end
    local gui = self._mainGui
    local function doDestroy()
        Library:RunCleanups(Library._libName)
        Library._activeUIs[Library._libName] = nil
        Library._mainGui = nil
        Kill(gui)
        local tempDialog = UI_CONTAINER:FindFirstChild("CID_TempDialog")
        if tempDialog then tempDialog:Destroy() end
        Library:UpdateBlur()
    end
    if skipConfirm then
        doDestroy()
    else
        Library:Confirm("DESTRUIR SCRIPT", "Estas seguro de destruir el script?", doDestroy, function() end, "Si", "No")
    end
end

function Library:DestroyAll()
    for name, _ in pairs(Library._activeUIs) do
        Library:RunCleanups(name)
        local g = UI_CONTAINER:FindFirstChild(name)
        if g then g:Destroy() end
    end
    local tg = UI_CONTAINER:FindFirstChild("CID_TempDialog")
    if tg then tg:Destroy() end
    Library._activeUIs = {}
    Library._mainGui = nil
    Library._rerenders = {}
    Library._notifications = {}
    local blur = Lighting:FindFirstChild("UniversalGUI_Blur")
    if blur then blur:Destroy() end
end

Library:LoadLucide()

return Library
