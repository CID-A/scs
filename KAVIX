    }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(strk, 0.25, { Transparency = 0 })
    New("TextLabel", {
        Parent = Box,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -28, 0, 30),
        Position = UDim2.new(0, 14, 0, 14),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = th.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    New("TextLabel", {
        Parent = Box,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -28, 0, 70),
        Position = UDim2.new(0, 14, 0, 52),
        Font = Enum.Font.Gotham,
        Text = content,
        TextColor3 = th.SubText,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
    })
    local function close()
        Tween(Box, 0.2, {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
        })
        Tween(strk, 0.2, { Transparency = 1 })
        Tween(Overlay, 0.2, { BackgroundTransparency = 1 })
        task.wait(0.22)
        Kill(Overlay)
        if useTemp then
            local tg = UI_CONTAINER:FindFirstChild("CID_TempDialog")
            if tg then tg:Destroy() end
        end
    end
    buttons = buttons or {
        { Text = "Cancelar", Color = th.ElementActive, Callback = function() end },
        { Text = "Confirmar", Color = th.Accent, Callback = function() end },
    }
    local n = #buttons
    local bw = 120
    local gap = 10
    local totalW = n * bw + (n - 1) * gap
    local startX = (BOX_W - totalW) / 2
    for i, b in ipairs(buttons) do
        local btn = New("TextButton", {
            Parent = Box,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, startX + (i - 1) * (bw + gap), 1, -16),
            Size = UDim2.new(0, bw, 0, 38),
            BackgroundColor3 = b.Color or th.ElementActive,
            BackgroundTransparency = glass,
            Text = b.Text or "OK",
            Font = Enum.Font.GothamBold,
            TextColor3 = th.Text,
            TextSize = 13,
            AutoButtonColor = false,
            ZIndex = 102,
        })
        Corner(btn, 6)
        btn.MouseEnter:Connect(function()
            local base = b.Color or th.ElementActive
            Tween(btn, 0.1, {
                BackgroundColor3 = Color3.new(
                    math.min(base.R + 0.1, 1),
                    math.min(base.G + 0.1, 1),
                    math.min(base.B + 0.1, 1)
                ),
                BackgroundTransparency = math.max(0, glass - 0.1),
            })
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, 0.1, {
                BackgroundColor3 = b.Color or th.ElementActive,
                BackgroundTransparency = glass,
            })
        end)
        btn.MouseButton1Click:Connect(function()
            close()
            if b.Callback then
                task.spawn(function() pcall(b.Callback) end)
            end
        end)
    end
    return Overlay
end

