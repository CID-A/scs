        Library.Cleanups[uiName] = nil
    end
end

local function EnsureFolder()
    if isfolder and not isfolder(CONFIG_FOLDER) then
        makefolder(CONFIG_FOLDER)
    end
end

function Library:SaveConfig(name)
    if not writefile then return false end
    EnsureFolder()
    local data = {}
    for flag, val in pairs(Library.Flags) do
        if typeof(val) == "Color3" then
            data[flag] = { __t = "Color3", R = val.R, G = val.G, B = val.B }
        elseif typeof(val) == "EnumItem" then
            data[flag] = { __t = "Enum", Type = tostring(val.EnumType), Name = val.Name }
        elseif typeof(val) == "table" then
            local safe = true
            for _, v in pairs(val) do
                local tv = typeof(v)
                if tv ~= "string" and tv ~= "number" and tv ~= "boolean" then
                    safe = false
                    break
                end
            end
            if safe then data[flag] = val end
        else
            data[flag] = val
        end
    end
    data.__theme = Library._currentTheme
    local ok = pcall(function()
        writefile(CONFIG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    end)
    return ok
end

function Library:LoadConfig(name)
    if not readfile or not isfile then return false end
    EnsureFolder()
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok or typeof(decoded) ~= "table" then return false end
    if decoded.__theme and Library.Themes[decoded.__theme] then
        Library:SetTheme(decoded.__theme)
    end
    for flag, val in pairs(decoded) do
        if flag ~= "__theme" then
            if typeof(val) == "table" and val.__t == "Color3" then
                val = Color3.new(val.R, val.G, val.B)
            elseif typeof(val) == "table" and val.__t == "Enum" then
                local ok2, enum = pcall(function()
                    return Enum[val.Type][val.Name]
                end)
                if ok2 then val = enum end
            end
            Library.Flags[flag] = val
            local opt = Library.Options[flag]
            if opt and opt.Set then
                pcall(function() opt:Set(val) end)
            end
        end
    end
    return true
end

function Library:GetConfigs()
    if not listfiles then return {} end
    EnsureFolder()
    local list = {}
    local ok, files = pcall(listfiles, CONFIG_FOLDER)
    if ok then
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(list, n) end
        end
    end
    table.sort(list)
    return list
end

function Library:DeleteConfig(name)
    if not delfile then return false end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if isfile and isfile(path) then
        return pcall(delfile, path)
    end
    return false
end

local function RepositionNotifications()
    local n = #Library._notifications
    for i, item in ipairs(Library._notifications) do
        if item.frame and item.frame.Parent then
            local y = NOTIFY_BASE_Y - ((n - i) * (NOTIFY_HEIGHT + NOTIFY_GAP))
            Tween(item.frame, 0.3, { Position = UDim2.new(1, -320, 1, y) })
        end
    end
end

local function RemoveNotif(item, fast)
    for i, v in ipairs(Library._notifications) do
        if v == item then
            table.remove(Library._notifications, i)
            break
        end
    end
    if item.frame and item.frame.Parent then
        local dur = fast and 0.15 or 0.3
        local cy = item.frame.Position.Y.Offset
        Tween(item.frame, dur, {
            Position = UDim2.new(1, 320, 1, cy),
            BackgroundTransparency = 1,
        })
        for _, v in ipairs(item.frame:GetDescendants()) do
            if v:IsA("GuiObject") then
                local p = { BackgroundTransparency = 1 }
                if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
                    p.TextTransparency = 1
                end
                if v:IsA("ImageLabel") or v:IsA("ImageButton") then
                    p.ImageTransparency = 1
                end
                Tween(v, dur, p)
            end
        end
        task.delay(dur + 0.1, function() Kill(item.frame) end)
    end
    RepositionNotifications()
end

function Library:Notify(title, content, duration, image)
    title = title or "Notificacion"
    content = content or ""
    duration = duration or 4
    local folder = Library._notifyFolder
    if not folder or not folder.Parent then
        if Library._mainGui then
            folder = New("Folder", { Name = "NotifyContainer", Parent = Library._mainGui })
            Library._notifyFolder = folder
        else
            return
        end
