function Library:AddTheme(name, themeTable)
    if type(name) ~= "string" or type(themeTable) ~= "table" or name == "" then
        return false
    end
    local base = Library.Themes.Dark
    local merged = {}
    for k, v in pairs(base) do
        if themeTable[k] ~= nil then
            merged[k] = themeTable[k]
        else
            merged[k] = v
        end
    end
    Library.Themes[name] = merged
    return true
end

function Library:RemoveTheme(name)
    if name == "Dark" then return false end
    if Library.Themes[name] then
        Library.Themes[name] = nil
        if Library._currentTheme == name then
            Library._currentTheme = "Dark"
        end
        return true
    end
    return false
end

function Library:UpdateBlur()
    local theme = Library.Themes[Library._currentTheme] or Library.Themes.Dark
    local blur = Lighting:FindFirstChild("UniversalGUI_Blur")
    if theme.Blur then
        if not blur then
            blur = Instance.new("BlurEffect")
            blur.Name = "UniversalGUI_Blur"
            blur.Size = 24
            blur.Parent = Lighting
        end
        blur.Enabled = Library._mainGui ~= nil and Library.Open
    elseif blur then
        blur.Enabled = false
    end
end

function Library:SetTheme(name)
    if not Library.Themes[name] then return false end
    Library._currentTheme = name
    local i = 1
    while i <= #Library._rerenders do
        local ok = pcall(Library._rerenders[i])
        if not ok then
            table.remove(Library._rerenders, i)
        else
            i = i + 1
        end
    end
    Library:UpdateBlur()
    return true
end

