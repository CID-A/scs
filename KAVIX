                local ks = Stroke(knob, T().StrokeHover, 2)
                table.insert(tracks, { track = track, knob = knob, stroke = ks })
                return track, knob
            end
            local hT, hK = makeTrack(46, ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
            }))
            local sT, sK = makeTrack(68, ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(h, 0, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(h, 1, 1)),
            }))
            local vT, vK = makeTrack(90, ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(h, s, 1)),
            }))
            Reg(function()
                local theme = T()
                Picker.BackgroundColor3 = theme.Element
                Picker.BackgroundTransparency = theme.Glass or 0
                pStroke.Color = theme.Stroke
                lbl.TextColor3 = theme.Text
                pvStroke.Color = theme.Stroke
                if iconLbl then
                    local sub = iconLbl:FindFirstChildOfClass("ImageLabel")
                    if sub then sub.ImageColor3 = theme.Text end
                end
                for _, tr in ipairs(tracks) do
                    tr.track.BackgroundColor3 = theme.SliderTrack
                    tr.track.BackgroundTransparency = (theme.Glass or 0) * 0.5
                    tr.knob.BackgroundColor3 = theme.Text
                    tr.stroke.Color = theme.StrokeHover
                end
            end)
            local function visualUpdate()
                color = Color3.fromHSV(h, s, v)
                Preview.BackgroundColor3 = color
                hK.Position = UDim2.new(h, 0, 0.5, 0)
                sK.Position = UDim2.new(s, 0, 0.5, 0)
                vK.Position = UDim2.new(v, 0, 0.5, 0)
                local sg = sT:FindFirstChildOfClass("UIGradient")
                if sg then
                    sg.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromHSV(h, 0, 1)),
                        ColorSequenceKeypoint.new(1, Color3.fromHSV(h, 1, 1)),
                    })
                end
                local vg = vT:FindFirstChildOfClass("UIGradient")
                if vg then
                    vg.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                        ColorSequenceKeypoint.new(1, Color3.fromHSV(h, s, 1)),
                    })
                end
            end
            local function commit()
                if flag then Library.Flags[flag] = color end
                pcall(callback, color)
            end
            local function bind(track, setter)
                local dragging = false
                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        setter(rel)
                        visualUpdate()
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging then
                        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                            setter(rel)
                            visualUpdate()
                        end
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if dragging then
                            dragging = false
                            commit()
                        end
                    end
                end)
            end
            bind(hT, function(r) h = r end)
            bind(sT, function(r) s = r end)
            bind(vT, function(r) v = r end)
            visualUpdate()
            AttachTooltip(lbl, tooltip)
            local obj = {}
            function obj:Set(c, fire)
                color = c
                h, s, v = Color3.toHSV(c)
                visualUpdate()
                if flag then Library.Flags[flag] = color end
                if fire == true then pcall(callback, color) end
            end
            function obj:Get()
                return color
            end
            obj:Set(default, false)
            if flag then Library.Options[flag] = obj end
            return obj
        end
