local function CreateToggleButton(parentGui, cfg)
    cfg = cfg or {}
    if cfg.Enabled == false then return end
    local pcAllowed = cfg.Pc
    if pcAllowed == nil then pcAllowed = true end
    if not pcAllowed and not IsTouchDevice() then
        return nil
    end
    local targetParent = parentGui or Library._mainGui
    if not targetParent or not targetParent.Parent then return nil end
    local text = cfg.Text
    local icon = cfg.Icon or ""
    local size = cfg.Size or UDim2.fromOffset(48, 48)
    local pos = cfg.Position or UDim2.new(0.02, 0, 0.45, 0)
    local bgColor = cfg.BackgroundColor
    local textColor = cfg.TextColor
    local iconColor = cfg.IconColor
    local draggable = cfg.Draggable
    if draggable == nil then draggable = true end
    local hasIcon = icon ~= "" and icon ~= nil
    if not hasIcon and not text then text = "ABRIR" end
    local glass = T().Glass or 0
    local Btn = New("TextButton", {
        Parent = targetParent,
        Name = "Toggle",
        BackgroundColor3 = bgColor or T().Element,
        BackgroundTransparency = bgColor and glass or glass + 0.15,
        Position = pos,
        Size = size,
        Font = Enum.Font.GothamBold,
        Text = hasIcon and "" or (text or "ABRIR"),
        TextColor3 = textColor or T().Text,
        TextSize = 14,
        AutoButtonColor = false,
        Active = true,
        ZIndex = 100,
    })
    Corner(Btn, 8)
    local strk = Stroke(Btn, T().Stroke)
    if hasIcon then
        local iconHolder = New("Frame", {
            Parent = Btn,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0.6, 0, 0.6, 0),
            BackgroundTransparency = 1,
            Name = "Icon",
        })
        local iconImg = New("ImageLabel", {
            Parent = iconHolder,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Image = Library:GetIcon(icon),
            ImageColor3 = iconColor or T().Accent,
            ScaleType = Enum.ScaleType.Fit,
        })
        Reg(function()
            iconImg.ImageColor3 = iconColor or T().Accent
        end)
    end
    Reg(function()
        local theme = T()
        Btn.BackgroundColor3 = bgColor or theme.Element
        Btn.BackgroundTransparency = bgColor and (theme.Glass or 0) or ((theme.Glass or 0) + 0.15)
        if not hasIcon then Btn.TextColor3 = textColor or theme.Text end
        strk.Color = theme.Stroke
    end)
    if draggable then
        Library:DraggingEnabled(Btn, Btn)
    end
    Btn.MouseEnter:Connect(function()
        local theme = T()
        if not bgColor then
            Tween(Btn, 0.15, { BackgroundColor3 = theme.ElementHover })
        end
        Tween(strk, 0.15, { Color = theme.StrokeHover })
    end)
    Btn.MouseLeave:Connect(function()
        local theme = T()
        if not bgColor then
            Tween(Btn, 0.15, { BackgroundColor3 = theme.Element })
        end
        Tween(strk, 0.15, { Color = theme.Stroke })
    end)
    Btn.MouseButton1Click:Connect(function()
        Library:ToggleUI()
    end)
    return Btn
end

local function ParseArgs(a, b, c, d, e, f)
    if type(a) == "table" then
        local t = a
        return {
            Title = t.Title or t.title or t.Name or t.name or "Untitled",
            Callback = t.Callback or t.CallBack or t.callback or t.Func or t.func or t.Function or function() end,
            Flag = t.Flag or t.flag,
            Description = t.Description or t.description or t.Tooltip or t.tooltip or t.Tip or t.tip,
            Icon = t.Icon or t.icon,
            Default = t.Default or t.default,
            Placeholder = t.Placeholder or t.placeholder,
            Options = t.Options or t.options or {},
            Min = t.Min or t.min or 0,
            Max = t.Max or t.max or 100,
            Key = t.Key or t.key or Enum.KeyCode.F,
            Height = t.Height or t.height or 120,
            Image = t.Image or t.image or "",
            Color = t.Color or t.color or Color3.fromRGB(255, 255, 255),
            Text = t.Text or t.text or "",
            Value = t.Value or t.value,
        }
    end
    return {
        Title = a or "Untitled",
        Callback = b or function() end,
        Flag = c,
        Description = d,
        Icon = nil,
        Default = e,
        Placeholder = f,
    }
end

function Library:CreateWindow(config)
    config = config or {}
