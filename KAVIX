    if image then
        local I = New("ImageLabel", {
            Parent = N,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(1, -30, 0, 8),
            Image = Library:GetIcon(image),
            ImageTransparency = 1,
            ScaleType = Enum.ScaleType.Fit,
        })
        Tween(I, 0.25, { ImageTransparency = 0 })
    end
    local item = { frame = N }
    table.insert(Library._notifications, item)
    RepositionNotifications()
    Tween(N, 0.25, { BackgroundTransparency = glass })
    Tween(strk, 0.25, { Transparency = 0 })
    Tween(Ind, 0.25, { BackgroundTransparency = 0 })
    Tween(TitleLbl, 0.25, { TextTransparency = 0 })
    Tween(ContentLbl, 0.25, { TextTransparency = 0 })
    task.delay(duration, function() RemoveNotif(item) end)
end

