local function Ripple(btn)
    if not btn or not btn.Parent then return end
    local s = New("ImageLabel", {
        Parent = btn,
        BackgroundTransparency = 1,
        Image = "rbxassetid://4560909609",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 0.6,
        Size = UDim2.new(0, 0, 0, 0),
        ZIndex = 5,
    })
    local ax, ay = btn.AbsolutePosition.X, btn.AbsolutePosition.Y
    local mx, my
    if UserInputService.MouseEnabled and UserInputService:GetLastInputType() ~= Enum.UserInputType.Touch then
        local loc = UserInputService:GetMouseLocation()
        mx, my = loc.X, loc.Y
    else
        mx = ax + btn.AbsoluteSize.X / 2
        my = ay + btn.AbsoluteSize.Y / 2
    end
    s.Position = UDim2.new(0, mx - ax, 0, my - ay)
    local size = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 1.5
    s:TweenSizeAndPosition(
        UDim2.new(0, size, 0, size),
        UDim2.new(0.5, -size / 2, 0.5, -size / 2),
        "Out", "Quad", 0.35, true
    )
    task.spawn(function()
        for _ = 1, 10 do
            if not s.Parent then return end
            s.ImageTransparency = s.ImageTransparency + 0.05
            task.wait(0.03)
        end
        Kill(s)
    end)
end

function Library:DraggingEnabled(handle, target)
    local dragging, dragInput, startPos, startFrame = false, nil, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPos = input.Position
            startFrame = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and target.Parent then
            local delta = input.Position - startPos
            target.Position = UDim2.new(
                startFrame.X.Scale,
                startFrame.X.Offset + delta.X,
                startFrame.Y.Scale,
                startFrame.Y.Offset + delta.Y
            )
        end
    end)
end

function Library:ResizingEnabled(handle, target, minSize, maxSize)
    minSize = minSize or Vector2.new(480, 320)
    maxSize = maxSize or Vector2.new(1600, 900)
    local dragging, startPos, startSize = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPos = input.Position
            startSize = target.AbsoluteSize
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and target.Parent then
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - startPos
                local nx = math.clamp(startSize.X + delta.X, minSize.X, maxSize.X)
                local ny = math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
                target.Size = UDim2.new(0, nx, 0, ny)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

