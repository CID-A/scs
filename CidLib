            keyLabel.TextXAlignment = Enum.TextXAlignment.Right

            local listening = false

            connect(frame.MouseEnter, function()
                frame.BackgroundColor3 = Library.Theme.Hover
            end)

            connect(frame.MouseLeave, function()
                frame.BackgroundColor3 = Library.Theme.Panel
            end)

            connect(frame.MouseButton1Click, function()
                listening = true
                keyLabel.Text = "..."
            end)

            connect(UIS.InputBegan, function(input, processed)
                if listening then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        key = input.KeyCode
                        keyLabel.Text = key.Name
                        listening = false

                        invoke(options.OnChanged, key)
                    end

                    return
                end

                if not processed
                    and input.UserInputType == Enum.UserInputType.Keyboard
                    and input.KeyCode == key then

                    invoke(options.Callback, key)
                end
            end)

            return {
                Frame = frame,

                Set = function(_, newKey)
                    if typeof(newKey) == "EnumItem"
                        and newKey.EnumType == Enum.KeyCode then

                        key = newKey
                        keyLabel.Text = key.Name
                        invoke(options.OnChanged, key)
                    end
                end,

                Get = function()
                    return key
                end
            }
        end

