                        end
                    end,
                    ClearAll = function()
                        selectedSet = {}
                        selectedLabel.Text = getSummary()
                        if opened then
                            for opt, btn in pairs(optionButtons) do refreshOption(opt, btn) end
                        end
                        invoke(options.Callback, {})
                    end,
                    Close = closeDropdown
                }
            end

            return self:MultiDropdown({
