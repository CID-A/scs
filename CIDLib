                Font.Medium, 13, windowTheme.Text, "Text")
            if hasDesc then
                label(frame, options.Description,
                    UDim2.fromOffset(14, 29), UDim2.new(.7, 0, 0, 17),
                    Font.Regular, 12, windowTheme.Sub, "Sub")
            end

            local key = options.KeyCode or Enum.KeyCode.F
            local keyLabel = label(frame, key.Name,
                UDim2.new(.7, 0, 0, 8), UDim2.new(.3, -14, 0, 20),
                Font.Code, 11, windowTheme.Sub, "Sub")
            keyLabel.TextXAlignment = Enum.TextXAlignment.Right

            local listening = false

            connect(frame.MouseEnter, function()
                frame.BackgroundColor3 = windowTheme.Hover
            end)
            connect(frame.MouseLeave, function()
                frame.BackgroundColor3 = windowTheme.Panel
            end)
            connect(frame.MouseButton1Click, function()
                listening = true
                keyLabel.Text = "..."
            end)

            connect(UIS.InputBegan, function(input, processed)
                if listening then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        key = input.KeyCode
                        keyLabel.Text = key.Name
                        listening = false
                        invoke(options.OnChanged, key)
                    end
                    return
                end
                if not processed and input.UserInputType == Enum.UserInputType.Keyboard
                and input.KeyCode == key then
                    invoke(options.Callback, key)
                end
            end)

            return {
                Frame = frame,
                Set = function(_, newKey)
                    if typeof(newKey) == "EnumItem" and newKey.EnumType == Enum.KeyCode then
                        key = newKey
                        keyLabel.Text = key.Name
                        invoke(options.OnChanged, key)
                    end
                end,
                Get = function() return key end
            }
        end

        function tab:Button(name, cbOrDesc, callback)
            if type(name) == "table" then return self:CreateButton(name) end
            local desc
            if type(cbOrDesc) == "function" then callback = cbOrDesc
            else desc = cbOrDesc end
            return self:CreateButton({ Title = tostring(name or "Button"), Description = desc, Callback = callback })
        end
        function tab:Toggle(name, default, callback, description)
            if type(name) == "table" then return self:CreateToggle(name) end
            return self:CreateToggle({
                Title = tostring(name or "Toggle"), Description = description,
                Default = default == true, Callback = callback
            })
        end
        function tab:Dropdown(name, options, callback, description)
            if type(name) == "table" then return self:CreateDropdown(name) end
            return self:CreateDropdown({
                Title = tostring(name or "Dropdown"), Description = description,
                Options = options or {}, Callback = callback
            })
        end
        function tab:MultiDropdown(name, options, callback, description)
            if type(name) == "table" then return self:CreateMultiDropdown(name) end
            return self:CreateMultiDropdown({
                Title = tostring(name or "Multi Select"), Description = description,
                Options = options or {}, Callback = callback
            })
        end
        function tab:Input(name, callback, placeholder, description)
            if type(name) == "table" then return self:CreateInput(name) end
            return self:CreateInput({
                Title = tostring(name or "Input"), Description = description,
                Placeholder = placeholder or "Escribe algo...", Callback = callback
            })
        end
        function tab:Slider(name, min, max, default, callback, description)
            if type(name) == "table" then return self:CreateSlider(name) end
            return self:CreateSlider({
                Title = tostring(name or "Slider"), Description = description,
                Min = min, Max = max, Default = default, Callback = callback
            })
        end
        function tab:Section(name)
            return self:CreateSection(type(name) == "table" and name or name)
        end
        function tab:Label(text, options) return self:CreateLabel(text, options) end
        function tab:Paragraph(options) return self:CreateParagraph(options) end
        function tab:Divider() return self:CreateDivider() end
        function tab:Keybind(name, keyCode, callback, onChanged)
            if type(name) == "table" then return self:CreateKeybind(name) end
            return self:CreateKeybind({
                Title = tostring(name or "Keybind"), KeyCode = keyCode or Enum.KeyCode.F,
                Callback = callback, OnChanged = onChanged
            })
        end

        return tab
    end

    function window:Dialog(options)
        options = safe(options)

        local overlay = Instance.new("Frame")
        overlay.Name = "DialogOverlay"
        overlay.Size = UDim2.fromScale(1, 1)
        overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        overlay.BackgroundTransparency = 1
        overlay.BorderSizePixel = 0
        overlay.Active = true
        overlay.ZIndex = 200
        overlay.Parent = gui
        themeRole(overlay, "DialogOverlay")

        local dialog = Instance.new("Frame")
        dialog.Name = "Dialog"
        dialog.AnchorPoint = Vector2.new(.5, .5)
        dialog.Position = UDim2.fromScale(.5, .5)
        dialog.Size = UDim2.fromOffset(
            math.min(420, math.max(300, width - 50)),
            options.Height or 220
        )
        dialog.BackgroundColor3 = windowTheme.Panel
        dialog.BorderSizePixel = 0
        dialog.ZIndex = 201
        dialog.Parent = overlay
        themeRole(dialog, "Dialog")
        corner(dialog, 12)
        stroke(dialog, windowTheme.Stroke, .15)

        local dialogScale = Instance.new("UIScale")
        dialogScale.Scale = 0.85
        dialogScale.Parent = dialog

        local title = label(dialog, options.Title or "Confirm",
            UDim2.fromOffset(22, 18), UDim2.new(1, -70, 0, 25),
            Font.Title, 17, windowTheme.Text, "Text")
        title.ZIndex = 202

        local closeButton = Instance.new("TextButton")
        closeButton.Size = UDim2.fromOffset(30, 30)
        closeButton.Position = UDim2.new(1, -44, 0, 14)
        closeButton.BackgroundColor3 = windowTheme.Button
        closeButton.BorderSizePixel = 0
        closeButton.Text = "X"
        closeButton.Font = Font.Medium
        closeButton.TextSize = 14
        closeButton.TextColor3 = windowTheme.Sub
        closeButton.AutoButtonColor = false
        closeButton.ZIndex = 202
        closeButton.Parent = dialog
        themeRole(closeButton, "DialogButton")
        corner(closeButton, 8)

        local content = label(dialog, options.Content or options.Message or "",
            UDim2.fromOffset(22, 55), UDim2.new(1, -44, 0, 78),
            Font.Regular, 12, windowTheme.Sub, "Sub")
        content.TextWrapped = true
        content.TextYAlignment = Enum.TextYAlignment.Top
        content.ZIndex = 202

        local buttonHolder = Instance.new("Frame")
        buttonHolder.AnchorPoint = Vector2.new(0, 1)
        buttonHolder.Position = UDim2.new(0, 22, 1, -18)
        buttonHolder.Size = UDim2.new(1, -44, 0, 38)
        buttonHolder.BackgroundTransparency = 1
        buttonHolder.ZIndex = 202
        buttonHolder.Parent = dialog

        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, 8)
        layout.Parent = buttonHolder

        local closed = false
        local result = {}
        local dialogObject
        local escapeConn

        local function closeDialog()
            if closed then return end
            closed = true
            result.Closed = true
            if escapeConn then
                pcall(function() escapeConn:Disconnect() end)
                escapeConn = nil
            end
            tween(dialogScale, .14, { Scale = 0.85 }):Play()
            local fadeOverlay = tween(overlay, .14, { BackgroundTransparency = 1 })
            fadeOverlay:Play()
            fadeOverlay.Completed:Wait()
            if overlay.Parent then overlay:Destroy() end
        end

        local buttons = options.Buttons
        if type(buttons) ~= "table" or #buttons == 0 then
            buttons = {
                {Title = "Cancel"},
                {Title = "Accept", Primary = true}
            }
        end

        for _, buttonConfig in ipairs(buttons) do
            if type(buttonConfig) == "string" then
                buttonConfig = {Title = buttonConfig}
            else
                buttonConfig = safe(buttonConfig)
            end

            local isPrimary = buttonConfig.Primary == true
            local button = Instance.new("TextButton")
            button.Size = UDim2.fromOffset(tonumber(buttonConfig.Width) or 92, 36)
            button.BackgroundColor3 = isPrimary and windowTheme.Accent or windowTheme.Button
            button.BorderSizePixel = 0
            button.Text = tostring(buttonConfig.Title or "OK")
            button.Font = Font.Medium
            button.TextSize = 12
            button.TextColor3 = isPrimary and windowTheme.AccentText or windowTheme.Text
            button.AutoButtonColor = false
            button.ZIndex = 203
            button.Parent = buttonHolder
            themeRole(button, isPrimary and "DialogPrimary" or "DialogButton")
            corner(button, 8)

            connect(button.MouseEnter, function()
                if isPrimary then
                    button.BackgroundColor3 = windowTheme.Accent:Lerp(windowTheme.Hover, .35)
                else
                    button.BackgroundColor3 = windowTheme.Hover
                end
            end)
            connect(button.MouseLeave, function()
                button.BackgroundColor3 = isPrimary and windowTheme.Accent or windowTheme.Button
            end)
            connect(button.MouseButton1Click, function()
                result.Button = buttonConfig.Title
                invoke(buttonConfig.Callback, dialogObject)
                if buttonConfig.Close ~= false then closeDialog() end
            end)
        end

        connect(closeButton.MouseButton1Click, closeDialog)
        escapeConn = connect(UIS.InputBegan, function(input, processed)
            if processed or closed then return end
            if input.KeyCode == Enum.KeyCode.Escape and options.CloseOnEscape ~= false then
                closeDialog()
            end
        end)

        dialogObject = {
            Frame = dialog,
            Overlay = overlay,
            Close = closeDialog,
            IsOpen = function()
                return not closed and overlay.Parent ~= nil
            end,
            GetResult = function()
                return result.Button
            end
        }

        task.defer(function()
            if overlay.Parent then
                tween(overlay, .18, {
                    BackgroundTransparency = windowTheme.DialogOverlayTransparency or .42
                }):Play()
                tween(dialogScale, .22, { Scale = 1 }):Play()
            end
        end)

        return dialogObject
    end

    function window:Confirm(title, content, callback)
        return self:Dialog({
            Title = title,
            Content = content,
            Buttons = {
                {Title = "Cancel"},
                {Title = "Accept", Primary = true, Callback = callback}
            }
        })
    end

    function window:Tab(options) return self:CreateTab(options) end
    function window:Notify(options, content, duration)
        if type(options) == "string" then
            options = { Title = options, Content = content, Duration = duration }
        end
        return Library:Notify(options)
    end

    function window:Open()
        setMinimized(false)
        setOpen(true)
    end
    function window:Close() setOpen(false) end
    function window:Toggle()
        if main.Visible then setOpen(false) else self:Open() end
    end
    function window:Minimize() setMinimized(true) end
    function window:Hide() setOpen(false) end
    function window:IsOpen() return main.Visible end
    function window:IsMinimized() return self.IsWindowMinimized end
    function window:IsDestroyed() return self.Destroyed end

    function window:SetScale(value)
        scale.Scale = math.clamp(tonumber(value) or 1, .5, 1.5)
    end
    function window:GetScale() return scale.Scale end

    function window:SetTitle(value) title.Text = tostring(value or "") end
    function window:SetSubtitle(value) subtitle.Text = tostring(value or "") end
    function window:SetToggleKey(value)
        if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
            toggleKey = value
        end
    end
    function window:GetToggleKey() return toggleKey end

    function window:GetTab(name)
        for _, tab in ipairs(self.Tabs) do
            if tab.Name == tostring(name) then return tab end
        end
    end
    function window:SelectTab(name)
        local tab = self:GetTab(name)
        if tab then selectTab(tab); return true end
        return false
    end

    function window:SetUserProfileVisible(value)
        if profile then profile.Visible = value == true end
    end
    function window:IsUserProfileVisible()
        return profile and profile.Visible or false
    end

    function window:SetOpenButtonText(value)
        if openButton then openButton.Text = tostring(value or "") end
    end
    function window:SetOpenButtonVisible(value)
        if openButton then openButton.Visible = value == true end
    end
    function window:SetOpenButtonPosition(value)
        if openButton and typeof(value) == "UDim2" then
            openButton.Position = value
        end
    end

    function window:_ApplyTheme(theme)
        window._Theme = theme
        if not config.Transparency then
            transparency = math.clamp(tonumber(theme.Transparency) or transparency, 0, .85)
        end
        main.BackgroundColor3 = theme.Bg
        main.BackgroundTransparency = transparency
        sidebar.BackgroundColor3 = theme.Content
        sidebar.BackgroundTransparency = math.clamp(
            tonumber(theme.ContentTransparency) or transparency, 0, .92)
        pages.BackgroundColor3 = theme.Content
        pages.BackgroundTransparency = math.clamp(
            tonumber(theme.ContentTransparency) or transparency, 0, .92)
        applyThemeToRoot(gui, theme)
        if profile then
            profile.BackgroundColor3 = theme.Bg
            profile.BackgroundTransparency = math.clamp(
                tonumber(theme.ProfileTransparency) or 1, 0, 1)
        end
        if openButton then
            openButton.BackgroundColor3 = theme.Accent
            openButton.TextColor3 = theme.AccentText
            if openButtonGradient then
                openButtonGradient.Color = buildGradientColors(theme.Accent)
            end
            if openButtonStroke then
                openButtonStroke.Color = theme.Accent
            end
        end
        if window.SelectedTab then selectTab(window.SelectedTab) end
    end

    function window:Destroy()
        if self.Destroyed then return end
        self.Destroyed = true
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        for _, c in ipairs(resizeConns) do pcall(function() c:Disconnect() end) end
        connections = {}
        resizeConns = {}
        if outsideConn then pcall(function() outsideConn:Disconnect() end) end
        if openButton then pcall(function() openButton:Destroy() end) end
        if main then pcall(function() main:Destroy() end) end
        for i = #Library._Windows, 1, -1 do
            if Library._Windows[i] == self then table.remove(Library._Windows, i) end
        end
    end

    table.insert(Library._Windows, window)
    return window
end

function Library:SetTheme(name)
    local themeName = tostring(name or "")
    local source = self._Themes[themeName]
    if not source then return false end
    self.Theme = copyTheme(source)
    self._ActiveTheme = themeName
    for i = #self._Windows, 1, -1 do
        local w = self._Windows[i]
        if not w or w.Destroyed then table.remove(self._Windows, i)
        elseif w._ApplyTheme then w:_ApplyTheme(self.Theme) end
    end
    return true
end

function Library:GetTheme() return self._ActiveTheme end

function Library:AddTheme(theme)
    if type(theme) ~= "table" then return false end
    local name = tostring(theme.Name or "")
    if name == "" then return false end
    local custom = {}
    for k, v in pairs(theme) do
        if k ~= "Name" then custom[k] = v end
    end
    local base = custom.Parent and self._Themes[custom.Parent] or DefaultTheme
    local built = mergeTheme(base, custom)
    built.Name = nil
    self._Themes[name] = built
    return true
end

function Library:RemoveTheme(name)
    name = tostring(name or "")
    if name == "Dark" or name == "Glass" or name == "Midnight"
    or name == "Rose" or name == "Slate" then return false end
    if self._Themes[name] then
        self._Themes[name] = nil
        return true
    end
    return false
end

function Library:ResetTheme() return self:SetTheme("Dark") end

function Library:GetThemes()
    local result = {}
    for name in pairs(self._Themes) do table.insert(result, name) end
    table.sort(result)
    return result
end

function Library:GetName() return self.Name end
function Library:GetVersion() return self.Version end

function Library:SetMaxNotifications(n)
    self._MaxNotifications = math.max(1, math.floor(tonumber(n) or 5))
end

function Library:GetWindows()
    local list = {}
    for _, w in ipairs(self._Windows) do
        if w and not w.Destroyed then table.insert(list, w) end
    end
    return list
end

function Library:Destroy()
    for i = #self._Windows, 1, -1 do
        local w = self._Windows[i]
        if w and not w.Destroyed then pcall(function() w:Destroy() end) end
    end
    self._Windows = {}
    for i = #self._NotificationQueue, 1, -1 do
        local n = self._NotificationQueue[i]
        if n and n.Parent then pcall(function() n:Destroy() end) end
    end
    self._NotificationQueue = {}
    if self._ScreenGui and self._ScreenGui.Parent then
        pcall(function() self._ScreenGui:Destroy() end)
    end
    self._ScreenGui = nil
    pcall(function()
        if _G.CID_UI_Instance == self then
            _G.CID_UI_Instance = nil
        end
    end)
end

return Library
