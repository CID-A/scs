                    optionButton.AutoButtonColor = false
                    optionButton.Parent = optionScroller
                    themeRole(optionButton, "Button")
                    corner(optionButton, 8)
                    padding(optionButton, 10, 10, 0, 0)
                    optionButton.TextXAlignment = Enum.TextXAlignment.Left
                    optionButtons[option] = optionButton

                    connect(optionButton.MouseEnter, function()
                        if option ~= selected then
                            optionButton.BackgroundColor3 = windowTheme.Hover
                        end
                    end)
                    connect(optionButton.MouseLeave, function()
                        if option ~= selected then
                            optionButton.BackgroundColor3 = windowTheme.Button
                        end
                    end)
                    connect(optionButton.MouseButton1Click, function()
                        selected = option
                        selectedLabel.Text = tostring(option)
                        invoke(options.Callback, option)
                        closeDropdown()
                    end)
                end

                refreshOptionHighlight()

                local visibleHeight = math.min(#optionsList * 36 + 10, maxVisibleHeight)
                tween(optionScroller, .18, { Size = UDim2.new(1, -18, 0, visibleHeight) }):Play()
                tween(frame, .18, { Size = UDim2.new(1, 0, 0, 61 + visibleHeight) }):Play()
                arrow.Text = "-"
                registerDropdown(frame, closeDropdown)
                task.delay(.2, function()
                    if opened then updateScrolling(page, layout) end
                end)
            end

            connect(headerButton.MouseButton1Click, function()
                if opened then closeDropdown() else openDropdown() end
            end)

            return {
                Frame = frame,
                Set = function(_, value)
                    for _, option in ipairs(optionsList) do
                        if option == value then
                            selected = value
                            selectedLabel.Text = tostring(value)
                            invoke(options.Callback, value)
                            if opened then refreshOptionHighlight() end
                            return true
                        end
                    end
                    return false
                end,
                Get = function() return selected end,
                SetOptions = function(_, newOptions)
                    optionsList = type(newOptions) == "table" and newOptions or {}
                    if not table.find(optionsList, selected) then
                        selected = optionsList[1]
                        selectedLabel.Text = tostring(selected or "None")
                    end
                    if opened then closeDropdown() end
                end,
                Close = closeDropdown
            }
        end

