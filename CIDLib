local function getSharedGui(name, forceFresh)
    if Library._ScreenGui and Library._ScreenGui.Parent and not forceFresh then
        return Library._ScreenGui
    end
    local parent = getParent()

    if forceFresh then
        local stale = parent:FindFirstChild(name)
        if stale then pcall(function() stale:Destroy() end) end
    end

    local existing = parent:FindFirstChild(name)
    if existing and not forceFresh then
        for _, child in ipairs(existing:GetChildren()) do
            pcall(function() child:Destroy() end)
        end
        Library._ScreenGui = existing
        return existing
    end

    local gui = Instance.new("ScreenGui")
