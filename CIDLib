                optionLayout.Parent = optionScroller

                local opened = false
                local maxVisibleHeight = 184
                local previousPageScrolling = true
                local optionButtons = {}

                local function clearOptions()
                    for _, child in ipairs(optionScroller:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    optionButtons = {}
                end

                local function refreshHighlight()
                    for opt, btn in pairs(optionButtons) do
                        if opt == selected then
                            btn.BackgroundColor3 = windowTheme.Hover
                            btn.TextColor3 = windowTheme.Accent
                        else
                            btn.BackgroundColor3 = windowTheme.Button
                            btn.TextColor3 = windowTheme.Text
                        end
                    end
                end

                local function closeDropdown()
                    if not opened then return end
                    opened = false
                    page.ScrollingEnabled = previousPageScrolling
                    clearOptions()
                    optionScroller.CanvasPosition = Vector2.new(0, 0)
                    tween(optionScroller, .18, { Size = UDim2.new(1, -18, 0, 0) }):Play()
                    tween(frame, .18, { Size = UDim2.new(1, 0, 0, 56) }):Play()
                    arrow.Text = "+"
                    unregisterDropdown(closeDropdown)
                    task.delay(.2, function()
                        if not opened then updateScrolling(page, layout) end
                    end)
                end

                local function openDropdown()
                    if #opts == 0 then return end
                    opened = true
                    previousPageScrolling = page.ScrollingEnabled
                    page.ScrollingEnabled = false
                    clearOptions()
                    optionScroller.CanvasPosition = Vector2.new(0, 0)

                    for index, option in ipairs(opts) do
                        local optionButton = Instance.new("TextButton")
                        optionButton.Size = UDim2.new(1, 0, 0, 32)
                        optionButton.BackgroundColor3 = windowTheme.Button
                        optionButton.BorderSizePixel = 0
                        optionButton.Text = tostring(option)
                        optionButton.Font = Font.Regular
                        optionButton.TextSize = 11
                        optionButton.TextColor3 = windowTheme.Text
                        optionButton.LayoutOrder = index
                        optionButton.AutoButtonColor = false
                        optionButton.Parent = optionScroller
                        themeRole(optionButton, "Button")
                        corner(optionButton, 8)
                        padding(optionButton, 10, 10, 0, 0)
                        optionButton.TextXAlignment = Enum.TextXAlignment.Left
                        optionButtons[option] = optionButton

                        connect(optionButton.MouseEnter, function()
                            if option ~= selected then
                                optionButton.BackgroundColor3 = windowTheme.Hover
                            end
                        end)
                        connect(optionButton.MouseLeave, function()
                            if option ~= selected then
                                optionButton.BackgroundColor3 = windowTheme.Button
                            end
                        end)
                        connect(optionButton.MouseButton1Click, function()
                            selected = option
                            selectedLabel.Text = tostring(option)
                            invoke(options.Callback, option)
                            closeDropdown()
                        end)
                    end

                    refreshHighlight()

                    local visibleHeight = math.min(#opts * 36 + 10, maxVisibleHeight)
                    tween(optionScroller, .18, { Size = UDim2.new(1, -18, 0, visibleHeight) }):Play()
                    tween(frame, .18, { Size = UDim2.new(1, 0, 0, 61 + visibleHeight) }):Play()
                    arrow.Text = "-"
                    registerDropdown(frame, closeDropdown)
                    task.delay(.2, function()
                        if opened then updateScrolling(page, layout) end
                    end)
                end

                connect(headerButton.MouseButton1Click, function()
                    if opened then closeDropdown() else openDropdown() end
                end)

                return {
                    Frame = frame,
                    Set = function(_, value)
                        for _, option in ipairs(opts) do
                            if option == value then
                                selected = value
                                selectedLabel.Text = tostring(value)
                                invoke(options.Callback, value)
                                if opened then refreshHighlight() end
                                return true
                            end
                        end
                        return false
                    end,
                    Get = function() return selected end,
                    SetOptions = function(_, newOptions)
                        opts = type(newOptions) == "table" and newOptions or {}
                        if not table.find(opts, selected) then
                            selected = opts[1]
                            selectedLabel.Text = tostring(selected or "None")
                        end
                        if opened then closeDropdown() end
                    end,
                    Close = closeDropdown
                }
            end

            return self:Dropdown({
                Title = tostring(optionsOrName or "Dropdown"),
                Description = description,
                Options = optionsList or {},
                Callback = callback
            })
        end

