local function resolveIcon(icon)
    if type(icon) ~= "string" then return icon end
    if icon == "" then return icon end
    if icon:match("^rbxassetid://") then return icon end
    if icon:match("^rbxasset://") then return icon end
    if icon:match("^https?://") then return icon end
    if icon:match("^%d+$") then return "rbxassetid://" .. icon end
    return Library.Icons[icon] or icon
end

local function copyTheme(source)
    local r = {}
    for k, v in pairs(source or {}) do r[k] = v end
    return r
end

local function mergeTheme(base, custom)
    local r = copyTheme(base)
    for k, v in pairs(custom or {}) do
        if r[k] ~= nil or k == "Name" then r[k] = v end
    end
    return r
end

local function safe(value)
    return type(value) == "table" and value or {}
end

local function debounce(fn, delay)
    if type(fn) ~= "function" then return fn end
    local timer
    return function(...)
        local args = table.pack(...)
        if timer then task.cancel(timer) end
        timer = task.delay(delay or 0.1, function()
            timer = nil
            fn(table.unpack(args, 1, args.n))
        end)
    end
end

local function throttle(fn, interval)
    if type(fn) ~= "function" then return fn end
    local last = 0
    return function(...)
        local now = os.clock()
        if now - last >= (interval or 0.05) then
            last = now
            fn(...)
        end
    end
end

local function invoke(fn, ...)
    if type(fn) ~= "function" then return end
    local args = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(function()
            fn(table.unpack(args, 1, args.n))
        end)
        if not ok then warn("[CID UI] Callback:", err) end
    end)
end

local function tween(object, duration, properties)
    return TweenService:Create(
        object,
        TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        properties
    )
end

local function corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = object
    return c
end

local function stroke(object, color, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Transparency = transparency or 0
    s.Parent = object
    return s
end

local function padding(object, l, r, t, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.Parent = object
    return p
end

local function label(parent, text, pos, size, font, textSize, color, role, richText)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = tostring(text or "")
    l.Position = pos
    l.Size = size
    l.Font = font
    l.TextSize = textSize
    l.TextColor3 = color
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.RichText = richText == true
    l.Parent = parent
    if role then l:SetAttribute("CIDThemeRole", role) end
    return l
end

local function isPointInFrame(point, frame)
    if not frame or not frame.Parent then return false end
    local ok, pos, size = pcall(function()
        return frame.AbsolutePosition, frame.AbsoluteSize
    end)
    if not ok then return false end
    return point.X >= pos.X and point.X <= pos.X + size.X
       and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end

local function themeRole(object, role)
    if object and object:IsA("Instance") then
        object:SetAttribute("CIDThemeRole", role)
    end
    return object
end

local function applyThemeRole(object, role, theme)
    if not object or not object.Parent then return end

    if role == "Stroke" and object:IsA("UIStroke") then
        object.Color = theme.Stroke
        if theme.StrokeTransparency ~= nil then
            object.Transparency = theme.StrokeTransparency
        end
        return
    end

    if object:IsA("ImageLabel") and role == "Icon" then
        object.ImageColor3 = theme.Sub
        return
    end

    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
        if role == "Text" then object.TextColor3 = theme.Text
        elseif role == "Sub" then object.TextColor3 = theme.Sub
        elseif role == "AccentText" then object.TextColor3 = theme.AccentText
        elseif role == "Accent" and object:IsA("TextButton") then object.TextColor3 = theme.Accent
        elseif role == "DialogPrimary" and object:IsA("TextButton") then object.TextColor3 = theme.AccentText
        elseif role == "DialogButton" and object:IsA("TextButton") then object.TextColor3 = theme.Text
        end
    end

    if object:IsA("GuiObject") then
        local color = theme[role]
        if role == "Notification" or role == "Dialog" then color = theme.Panel
        elseif role == "DialogButton" then color = theme.Button
        elseif role == "DialogPrimary" then color = theme.Accent
        end
        if typeof(color) == "Color3" then
            object.BackgroundColor3 = color
        end
    end
end

local function applyThemeTransparency(object, role, theme)
    if not object or not object.Parent or not object:IsA("GuiObject") then return end
    local value
    if role == "Bg" then value = theme.Transparency
    elseif role == "Panel" then value = theme.PanelTransparency
    elseif role == "Content" then value = theme.ContentTransparency
    elseif role == "Button" then value = theme.ButtonTransparency
    elseif role == "Input" then value = theme.InputTransparency
    elseif role == "Notification" then value = theme.NotificationTransparency
    elseif role == "DialogOverlay" then value = theme.DialogOverlayTransparency
    end
    if value ~= nil then
        object.BackgroundTransparency = value
    end
end

local function applyThemeToRoot(root, theme)
    if not root then return end
    for _, obj in ipairs(root:GetDescendants()) do
        local role = obj:GetAttribute("CIDThemeRole")
        if role then
            applyThemeRole(obj, role, theme)
            applyThemeTransparency(obj, role, theme)
        end
    end
end

local function getParent()
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and typeof(result) == "Instance" then return result end
    end
    if LocalPlayer then
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pg then return pg end
    end
    return CoreGui
end

local function makeStub()
    local stub = {}
    local mt = {
        __index = function() return stub end,
        __call = function() return stub end
    }
    return setmetatable(stub, mt)
end

local function getRegistry()
    if type(_G) ~= "table" then return {} end
    if type(_G.CID_UI_Registry) ~= "table" then
        _G.CID_UI_Registry = {}
    end
    return _G.CID_UI_Registry
end

local function pruneRegistry()
    local reg = getRegistry()
    for i = #reg, 1, -1 do
        local entry = reg[i]
        if type(entry) ~= "table"
        or type(entry.Library) ~= "table"
        or entry.Library._Destroyed then
            table.remove(reg, i)
        end
    end
    return reg
end

