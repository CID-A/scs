        connect(profile.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                pressStart = input.Position
                pressTime = tick()
            end
        end)
        connect(profile.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                if pressStart then
                    local delta = (input.Position - pressStart).Magnitude
                    if delta < 5 and (tick() - pressTime) < 0.5 then
                        invoke(profileConfig.OnClick or config.OnProfileClick, profile)
                    end
                end
            end
        end)
    end

    if openButton and openConfig.Draggable ~= false then
        local dragging = false
        local dragStart, startPos
        connect(openButton.InputBegan, function(input)
