function Library:Notify(options, content, duration)
    if type(options) == "string" then
        options = { Title = options, Content = content, Duration = duration }
    end
    options = safe(options)
    local notifType = NotificationTypes[options.Type or "info"] or NotificationTypes.info
    local container = ensureNotificationContainer()

    while #Library._NotificationQueue >= Library._MaxNotifications do
        local oldest = table.remove(Library._NotificationQueue, 1)
        if oldest and oldest.Parent then oldest:Destroy() end
    end

    local notification = Instance.new("Frame")
    notification.Size = UDim2.fromOffset(360, 92)
    notification.BackgroundColor3 = Library.Theme.Panel
    notification.BackgroundTransparency = 1
    notification.BorderSizePixel = 0
    notification.Parent = container
    themeRole(notification, "Notification")
    corner(notification, 10)
    stroke(notification, Library.Theme.Stroke, .15)

    local accentBar = Instance.new("Frame")
    accentBar.Size = UDim2.fromOffset(3, 60)
    accentBar.Position = UDim2.fromOffset(0, 16)
    accentBar.BackgroundColor3 = notifType.Color
    accentBar.BorderSizePixel = 0
    accentBar.Parent = notification
    corner(accentBar, 2)

    local dismiss = Instance.new("TextButton")
    dismiss.Size = UDim2.fromOffset(26, 26)
    dismiss.Position = UDim2.new(1, -34, 0, 8)
    dismiss.BackgroundTransparency = 1
    dismiss.Text = "X"
    dismiss.Font = Font.Medium
    dismiss.TextSize = 14
    dismiss.TextColor3 = Library.Theme.Sub
    dismiss.AutoButtonColor = false
    dismiss.Parent = notification
    themeRole(dismiss, "Sub")

    local titleLabel = label(notification, options.Title or "CID UI",
        UDim2.fromOffset(16, 12), UDim2.new(1, -50, 0, 20),
        Font.Title, 13, Library.Theme.Text, "Text")

    local contentLabel = label(notification, options.Content or "",
        UDim2.fromOffset(16, 36), UDim2.new(1, -32, 0, 46),
        Font.Regular, 11, Library.Theme.Sub, "Sub")
    contentLabel.TextWrapped = true
    contentLabel.TextYAlignment = Enum.TextYAlignment.Top

    task.defer(function()
        if notification.Parent then
            tween(notification, .22, {
                BackgroundTransparency = Library.Theme.NotificationTransparency or 0
            }):Play()
        end
    end)

    table.insert(Library._NotificationQueue, notification)

    local removed = false
    local function remove()
        if removed or not notification.Parent then return end
        removed = true
        local fade = tween(notification, .2, { BackgroundTransparency = 1 })
        fade:Play()
        fade.Completed:Wait()
        if notification.Parent then notification:Destroy() end
        for i = #Library._NotificationQueue, 1, -1 do
            if Library._NotificationQueue[i] == notification then
                table.remove(Library._NotificationQueue, i)
            end
        end
    end

    dismiss.MouseButton1Click:Connect(remove)
    task.delay(tonumber(options.Duration) or 4, remove)

    return notification
end

