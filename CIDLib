    local dismiss = Instance.new("TextButton")
    dismiss.Size = UDim2.fromOffset(26, 26)
    dismiss.Position = UDim2.new(1, -34, 0, 8)
    dismiss.BackgroundTransparency = 1
    dismiss.Text = "X"
    dismiss.Font = Font.Medium
    dismiss.TextSize = 14
    dismiss.TextColor3 = Library.Theme.Sub
    dismiss.AutoButtonColor = false
    dismiss.Parent = notification
    themeRole(dismiss, "Sub")

    label(notification, options.Title or "CID UI",
        UDim2.fromOffset(16, 12), UDim2.new(1, -50, 0, 20),
        Font.Title, 13, Library.Theme.Text, "Text")

    local contentLabel = label(notification, options.Content or "",
        UDim2.fromOffset(16, 36), UDim2.new(1, -32, 0, 46),
        Font.Regular, 11, Library.Theme.Sub, "Sub")
    contentLabel.TextWrapped = true
    contentLabel.TextYAlignment = Enum.TextYAlignment.Top

    task.defer(function()
        if notification.Parent then
            tween(notification, .22, {
                BackgroundTransparency = Library.Theme.NotificationTransparency or 0
            }):Play()
        end
    end)

    table.insert(Library._NotificationQueue, notification)

    local removed = false
    local function remove()
        if removed or not notification.Parent then return end
        removed = true
        local fade = tween(notification, .2, { BackgroundTransparency = 1 })
        fade:Play()
        fade.Completed:Wait()
        if notification.Parent then notification:Destroy() end
        for i = #Library._NotificationQueue, 1, -1 do
            if Library._NotificationQueue[i] == notification then
                table.remove(Library._NotificationQueue, i)
            end
        end
    end

    dismiss.MouseButton1Click:Connect(remove)
    local waitTime = tonumber(options.Wait) or tonumber(options.Duration) or 4
    task.delay(waitTime, remove)

    return notification
end

function Library:CreateWindow(config)
    config = safe(config)

    local resolvedName
    local forceFreshGui = false

    if Library._ForceName then
        resolvedName = Library._ForceName
        forceFreshGui = true
    elseif config.ForceName and config.Name then
        resolvedName = tostring(config.Name)
        Library._InstanceName = resolvedName
        Library._ForceName = resolvedName
        forceFreshGui = true
        for i = #getRegistry(), 1, -1 do
            local entry = getRegistry()[i]
            if entry.ResolvedName == resolvedName and entry.Library ~= Library then
                pcall(function() entry.Library:Destroy() end)
                table.remove(getRegistry(), i)
            end
        end
    elseif Library._InstanceName then
        resolvedName = Library._InstanceName
    else
        local baseName = tostring(config.Name or "CID_UI")

        if forceCoexist then
            local reg = getRegistry()
            local taken = {}
            for _, entry in ipairs(reg) do
                taken[entry.ResolvedName] = true
            end
            if not taken[baseName] then
                resolvedName = baseName
            else
                local i = 2
                while taken[baseName .. i] do i = i + 1 end
                resolvedName = baseName .. i
            end
        else
            resolvedName = baseName
        end

        Library._InstanceName = resolvedName

        table.insert(getRegistry(), {
            Library = Library,
            ResolvedName = resolvedName
        })

        pcall(function()
            _G.CID_UI_Instance = Library
        end)
    end

    if forceFreshGui then
        table.insert(getRegistry(), {
            Library = Library,
            ResolvedName = resolvedName
