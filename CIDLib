                local knob = Instance.new("Frame")
                knob.Size = UDim2.fromOffset(18, 18)
                knob.Position = UDim2.fromOffset(3, 3)
                knob.BackgroundColor3 = windowTheme.ToggleKnob
                knob.Parent = switch
                corner(knob, 100)

                local value = options.Default == true

                local function render(animate)
                    local switchColor = value and windowTheme.Accent or windowTheme.ToggleOff
                    local knobPos = value and UDim2.new(1, -21, 0, 3) or UDim2.fromOffset(3, 3)
                    local knobColor = value and windowTheme.Bg or windowTheme.ToggleKnob
                    if animate then
                        tween(switch, .15, { BackgroundColor3 = switchColor }):Play()
                        tween(knob, .15, { Position = knobPos, BackgroundColor3 = knobColor }):Play()
                    else
                        switch.BackgroundColor3 = switchColor
                        knob.Position = knobPos
                        knob.BackgroundColor3 = knobColor
                    end
                end
                render(false)

                connect(btn.MouseButton1Click, function()
                    value = not value
                    render(true)
                    invoke(options.Callback, value)
                end)

                return {
                    Frame = frame,
                    Set = function(_, nv)
                        value = nv == true
                        render(true)
                        invoke(options.Callback, value)
                    end,
                    Get = function() return value end
                }
            end

            return self:Toggle({
                Title = tostring(optionsOrName or "Toggle"),
                Description = description,
                Default = default == true,
