        -- Short API. Old Create* API remains fully supported.
        -- Description is optional and can be supplied without breaking old scripts.
        function tab:Button(name, callbackOrDescription, callback)
            if type(name) == "table" then
                return self:CreateButton(name)
            end

            local description
            if type(callbackOrDescription) == "function" then
                callback = callbackOrDescription
            else
                description = callbackOrDescription
            end

            return self:CreateButton({
                Title = tostring(name or "Button"),
                Description = description,
                Callback = callback
            })
        end

        function tab:Toggle(name, default, callback, description)
            if type(name) == "table" then
                return self:CreateToggle(name)
            end

            return self:CreateToggle({
                Title = tostring(name or "Toggle"),
                Description = description,
                Default = default == true,
                Callback = callback
            })
        end

        function tab:Dropdown(name, options, callback, description)
            if type(name) == "table" then
                return self:CreateDropdown(name)
            end

            return self:CreateDropdown({
                Title = tostring(name or "Dropdown"),
                Description = description,
                Options = options or {},
                Callback = callback
            })
        end

        function tab:Input(name, callback, placeholder, description)
            if type(name) == "table" then
                return self:CreateInput(name)
            end

            return self:CreateInput({
                Title = tostring(name or "Input"),
                Description = description,
                Placeholder = placeholder or "Escribe algo...",
                Callback = callback
            })
        end

        function tab:Slider(name, min, max, default, callback, description)
            if type(name) == "table" then
                return self:CreateSlider(name)
            end

            return self:CreateSlider({
                Title = tostring(name or "Slider"),
                Description = description,
                Min = min,
                Max = max,
                Default = default,
                Callback = callback
            })
        end

        function tab:Section(name)
            if type(name) == "table" then
                return self:CreateSection(name)
            end
            return self:CreateSection(name)
        end

        function tab:Label(text)
            return self:CreateLabel(text)
        end

        function tab:Paragraph(options)
            return self:CreateParagraph(options)
        end

        function tab:Divider()
            return self:CreateDivider()
        end

        function tab:Keybind(name, keyCode, callback, onChanged)
            if type(name) == "table" then
                return self:CreateKeybind(name)
            end

            return self:CreateKeybind({
                Title = tostring(name or "Keybind"),
                KeyCode = keyCode or Enum.KeyCode.F,
                Callback = callback,
                OnChanged = onChanged
            })
        end

        return tab
    end

    -- Short aliases for the window API.
    function window:Tab(options)
        return self:CreateTab(options)
    end

    function window:Settings(options)
        return self:CreateSettingsTab(options)
    end

    function window:Notify(options, content, duration)
        if type(options) == "string" then
            options = {
                Title = options,
                Content = content,
                Duration = duration
            }
        end

        options = safe(options)

        local notification = Instance.new("Frame")
        notification.Size = UDim2.fromOffset(360, 96)
        notification.BackgroundColor3 = Library.Theme.Panel
        notification.BackgroundTransparency = 1
        notification.BorderSizePixel = 0
        notification.Parent = notifications
        themeRole(notification, "Notification")

        corner(notification, 10)

        local notificationStroke = stroke(
            notification,
            Library.Theme.Stroke,
            .15
        )

        local accentBar = Instance.new("Frame")
        accentBar.Size = UDim2.fromOffset(3, 54)
        accentBar.Position = UDim2.fromOffset(0, 21)
        accentBar.BackgroundColor3 = Library.Theme.Accent
        accentBar.BorderSizePixel = 0
        accentBar.Parent = notification
        themeRole(accentBar, "Accent")
        corner(accentBar, 2)

        local dismiss = Instance.new("TextButton")
        dismiss.Size = UDim2.fromOffset(24, 24)
        dismiss.Position = UDim2.new(1, -32, 0, 8)
        dismiss.BackgroundTransparency = 1
        dismiss.Text = "×"
        dismiss.Font = Font.Medium
        dismiss.TextSize = 18
        dismiss.TextColor3 = Library.Theme.Sub
        dismiss.AutoButtonColor = false
        dismiss.Parent = notification
        themeRole(dismiss, "Sub")

        local titleLabel = label(
            notification,
            options.Title or "CID UI",
            UDim2.fromOffset(16, 10),
            UDim2.new(1, -62, 0, 23),
            Font.Title,
            13,
            Library.Theme.Text
        )

        local content = label(
            notification,
            options.Content or "",
            UDim2.fromOffset(16, 38),
            UDim2.new(1, -32, 0, 46),
            Font.Regular,
            11,
            Library.Theme.Sub
        )

        content.TextWrapped = true
        content.TextYAlignment = Enum.TextYAlignment.Top

        local notificationTransparency = math.clamp(
            tonumber(Library.Theme.NotificationTransparency) or transparency,
            0,
            .9
        )

        tween(notification, .2, {
            BackgroundTransparency = notificationTransparency
        }):Play()

        task.delay(tonumber(options.Duration) or 3, function()
            if notification.Parent then
                local fade = tween(notification, .2, {
                    BackgroundTransparency = 1
                })

                fade:Play()
                fade.Completed:Wait()

                if notification.Parent then
                    notification:Destroy()
                end
            end
        end)

        return notification
    end

    function window:Dialog(options)
        options = safe(options)

        local overlay = Instance.new("Frame")
        overlay.Name = "DialogOverlay"
        overlay.Size = UDim2.fromScale(1, 1)
        overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        overlay.BackgroundTransparency = Library.Theme.DialogOverlayTransparency or .42
        overlay.BorderSizePixel = 0
        overlay.Active = true
        overlay.ZIndex = 100
        overlay.Parent = gui
        themeRole(overlay, "DialogOverlay")

        local dialog = Instance.new("Frame")
        dialog.Name = "Dialog"
        dialog.AnchorPoint = Vector2.new(.5, .5)
        dialog.Position = UDim2.fromScale(.5, .5)
        dialog.Size = UDim2.fromOffset(
            math.min(420, math.max(300, width - 50)),
            options.Height or 220
        )
        dialog.BackgroundColor3 = Library.Theme.Panel
        dialog.BorderSizePixel = 0
        dialog.ZIndex = 101
        dialog.Parent = overlay
        themeRole(dialog, "Dialog")
        corner(dialog, 12)
        stroke(dialog, Library.Theme.Stroke, .15)

        local title = label(
            dialog,
            options.Title or "Confirm",
            UDim2.fromOffset(22, 18),
            UDim2.new(1, -70, 0, 25),
            Font.Title,
            17,
            Library.Theme.Text
        )
        title.ZIndex = 102

        local closeButton = Instance.new("TextButton")
        closeButton.Size = UDim2.fromOffset(30, 30)
        closeButton.Position = UDim2.new(1, -44, 0, 14)
        closeButton.BackgroundColor3 = Library.Theme.Button
        closeButton.BorderSizePixel = 0
        closeButton.Text = "×"
        closeButton.Font = Font.Medium
        closeButton.TextSize = 18
        closeButton.TextColor3 = Library.Theme.Sub
        closeButton.AutoButtonColor = false
        closeButton.ZIndex = 102
        closeButton.Parent = dialog
        themeRole(closeButton, "DialogButton")
        corner(closeButton, 8)

        local content = label(
            dialog,
            options.Content or options.Message or "",
            UDim2.fromOffset(22, 55),
            UDim2.new(1, -44, 0, 78),
            Font.Regular,
            12,
            Library.Theme.Sub
        )
        content.TextWrapped = true
        content.TextYAlignment = Enum.TextYAlignment.Top
        content.ZIndex = 102

        local buttonHolder = Instance.new("Frame")
        buttonHolder.AnchorPoint = Vector2.new(0, 1)
        buttonHolder.Position = UDim2.new(0, 22, 1, -18)
        buttonHolder.Size = UDim2.new(1, -44, 0, 38)
        buttonHolder.BackgroundTransparency = 1
        buttonHolder.ZIndex = 102
        buttonHolder.Parent = dialog

        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, 8)
        layout.Parent = buttonHolder

        local closed = false
        local result = {}
        local dialogObject
        local escapeConnection

        local function closeDialog()
            if closed then
                return
            end
            closed = true
            result.Closed = true
            if escapeConnection then
                pcall(function()
                    escapeConnection:Disconnect()
                end)
                escapeConnection = nil
            end
            if overlay.Parent then
                overlay:Destroy()
            end
        end

        local buttons = options.Buttons
        if type(buttons) ~= "table" or #buttons == 0 then
            buttons = {
                {Title = "Cancel"},
                {Title = "Accept", Primary = true}
            }
        end

        for _, buttonConfig in ipairs(buttons) do
            if type(buttonConfig) == "string" then
                buttonConfig = {Title = buttonConfig}
            else
                buttonConfig = safe(buttonConfig)
            end

            local button = Instance.new("TextButton")
            button.Size = UDim2.fromOffset(
                tonumber(buttonConfig.Width) or 92,
                36
            )
            button.BackgroundColor3 = buttonConfig.Primary and Library.Theme.Accent or Library.Theme.Button
            button.BorderSizePixel = 0
            button.Text = tostring(buttonConfig.Title or "OK")
            button.Font = Font.Medium
            button.TextSize = 12
            button.TextColor3 = buttonConfig.Primary and Library.Theme.AccentText or Library.Theme.Text
            button.AutoButtonColor = false
            button.ZIndex = 103
            button.Parent = buttonHolder
            themeRole(button, buttonConfig.Primary and "DialogPrimary" or "DialogButton")
            corner(button, 8)

            connect(button.MouseEnter, function()
                button.BackgroundColor3 = buttonConfig.Primary and Library.Theme.Hover or Library.Theme.Hover
            end)
            connect(button.MouseLeave, function()
                button.BackgroundColor3 = buttonConfig.Primary and Library.Theme.Accent or Library.Theme.Button
            end)
            connect(button.MouseButton1Click, function()
                result.Button = buttonConfig.Title
                invoke(buttonConfig.Callback, dialogObject)
                if buttonConfig.Close ~= false then
                    closeDialog()
                end
            end)
        end

        connect(closeButton.MouseButton1Click, closeDialog)
        escapeConnection = connect(UIS.InputBegan, function(input, processed)
            if processed or closed then
                return
            end
            if input.KeyCode == Enum.KeyCode.Escape and options.CloseOnEscape ~= false then
                closeDialog()
            end
        end)

        dialogObject = {
            Frame = dialog,
            Overlay = overlay,
            Close = closeDialog,
            IsOpen = function()
                return not closed and overlay.Parent ~= nil
            end,
            GetResult = function()
                return result.Button
            end
        }

        tween(overlay, .16, {BackgroundTransparency = Library.Theme.DialogOverlayTransparency or .42}):Play()
        return dialogObject
    end

    function window:Confirm(title, content, callback)
        return self:Dialog({
            Title = title,
            Content = content,
            Buttons = {
                {Title = "Cancel"},
                {Title = "Accept", Primary = true, Callback = callback}
            }
        })
    end

    function window:Open()
        setMinimized(false)
        setOpen(true)
    end

    function window:Close()
        setOpen(false)
    end

    function window:Toggle()
        if self:IsOpen() then
            setOpen(false)
        else
            self:Open()
        end
    end

    function window:Minimize()
        setMinimized(true)
    end

    function window:Hide()
        setOpen(false)
    end

    function window:IsOpen()
        return not self.Destroyed
            and self.IsWindowOpen
            and not self.IsWindowMinimized
    end

    function window:IsMinimized()
        return not self.Destroyed and self.IsWindowMinimized
    end

    function window:IsDestroyed()
        return self.Destroyed == true
    end

    function window:Refresh()
        if self.Destroyed then return end
        updateScrolling(tabList, tabLayout)
        updateAllPages()
    end

    function window:SetScale(value)
        scale.Scale = math.clamp(tonumber(value) or 1, .5, 1.5)
    end

    function window:GetScale()
        return scale.Scale
    end

    function window:SetTransparency(value)
        transparency = math.clamp(tonumber(value) or 0, 0, .85)

        main.BackgroundTransparency = transparency
        sidebar.BackgroundTransparency = math.clamp(
        tonumber(Library.Theme.ContentTransparency) or (transparency + .02),
        0,
        .92
    )
        pages.BackgroundTransparency = math.clamp(
        tonumber(Library.Theme.ContentTransparency) or (transparency + .02),
        0,
        .92
    )

        if profile then
            -- User info is intentionally transparent so the avatar/name never
            -- creates a bright rectangle over Glass or other themes.
            profile.BackgroundTransparency = math.clamp(
                tonumber(Library.Theme.ProfileTransparency) or 1,
                0,
                1
            )
        end

        for _, descendant in ipairs(main:GetDescendants()) do
            if descendant:IsA("TextButton")
                or descendant:IsA("TextBox")
                or descendant:IsA("ImageButton")
                or descendant:IsA("ImageLabel")
                or descendant:IsA("Frame") then

                if descendant ~= header
                    and descendant ~= body
                    and descendant ~= sidebar
                    and descendant ~= pages
                    and descendant ~= profile
                    and descendant ~= dragArea then

                    if descendant:GetAttribute("CIDFixedTransparency") ~= true then
                        local base = descendant:GetAttribute("CIDBaseTransparency")

                        if base == nil then
                            base = descendant.BackgroundTransparency
                            descendant:SetAttribute(
                                "CIDBaseTransparency",
                                base
                            )
                        end

                        descendant.BackgroundTransparency =
                            math.clamp(
                                base + transparency,
                                0,
                                .95
                            )
                    end
                end
            elseif descendant:IsA("UIStroke") then
                descendant.Transparency =
                    math.clamp(.35 + transparency * .35, 0, .95)
            end
        end
    end

    function window:GetTransparency()
        return transparency
    end

    function window:SetTitle(value)
        title.Text = tostring(value or "")
    end

    function window:SetSubtitle(value)
        subtitle.Text = tostring(value or "")
    end

    function window:SetVersion(value)
        if version then
            version.Text = "v" .. tostring(value or "")
        end
    end

    function window:GetVersion()
        if not version then
            return nil
        end

        return tostring(version.Text):gsub("^v", "")
    end

    function window:SetToggleKey(value)
        if typeof(value) == "EnumItem"
            and value.EnumType == Enum.KeyCode then

            toggleKey = value
        end
    end

    function window:SetOpenButtonText(value)
        if openButton then
            openButton.Text = tostring(value or "")
        end
    end

    function window:SetOpenButtonTransparency(value)
        if openButton then
            openButton.BackgroundTransparency =
                math.clamp(tonumber(value) or 0, 0, .9)
        end
    end

    function window:SetOpenButtonVisible(value)
        if openButton then
            openButton.Visible = value == true
        end
    end

    function window:SetOpenButtonPosition(value)
        if openButton and typeof(value) == "UDim2" then
            openButton.Position = value
        end
    end

    function window:GetTab(name)
        for _, tab in ipairs(self.Tabs) do
            if tab.Name == tostring(name) then
                return tab
            end
        end

        return nil
    end

    function window:SelectTab(name)
        local tab = self:GetTab(name)

        if tab then
            selectTab(tab)
            return true
        end

        return false
    end

    -- Optional simple settings tab. This is intentionally not an Interface Manager.
    function window:CreateSettingsTab(options)
        options = safe(options)

        local settings = self:CreateTab(options.Name or "Settings")
        settings:CreateSection("Appearance")

        local themeDropdown = settings:CreateDropdown({
            Title = "Theme",
            Options = Library:GetThemes(),
            Default = Library:GetTheme(),
            Callback = function(value)
                Library:SetTheme(value)
            end
        })

        settings:CreateSlider({
            Title = "UI Scale",
            Min = 0.75,
            Max = 1.25,
            Step = 0.05,
            Default = self:GetScale(),
            Callback = function(value)
                self:SetScale(value)
            end
        })

        settings:CreateSlider({
            Title = "Transparency",
            Min = 0,
            Max = 0.65,
            Step = 0.05,
            Default = self:GetTransparency(),
            Callback = function(value)
                self:SetTransparency(value)
            end
        })

        settings:CreateButton({
            Title = "Reset Theme",
            Callback = function()
                Library:ResetTheme()
                themeDropdown:Set(Library:GetTheme())
            end
        })

        return settings
    end

    function window:SetUserProfileVisible(value)
        if profile then
            profile.Visible = value == true
        end
    end

    function window:IsUserProfileVisible()
        return profile and profile.Visible or false
    end

    function window:_ApplyTheme(theme)
        if not config.Transparency then
            transparency = math.clamp(tonumber(theme.Transparency) or transparency, 0, .85)
        end

        main.BackgroundColor3 = theme.Bg
        main.BackgroundTransparency = transparency
        sidebar.BackgroundColor3 = theme.Content
        sidebar.BackgroundTransparency = math.clamp(tonumber(theme.ContentTransparency) or transparency, 0, .92)
        pages.BackgroundColor3 = theme.Content
        pages.BackgroundTransparency = math.clamp(tonumber(theme.ContentTransparency) or transparency, 0, .92)

        applyThemeToRoot(gui, theme)

        local glassVisible = Library.ActiveTheme == "Glass"
        if mainGlassGradient then mainGlassGradient.Enabled = glassVisible end
        if sidebarGlassGradient then sidebarGlassGradient.Enabled = glassVisible end
        if pagesGlassGradient then pagesGlassGradient.Enabled = glassVisible end

        if profile then
            profile.BackgroundColor3 = theme.Bg
            profile.BackgroundTransparency = math.clamp(
                tonumber(theme.ProfileTransparency) or 1,
                0,
                1
            )
        end

        if openButton then
            openButton.BackgroundTransparency = math.clamp(
                tonumber(theme.OpenButtonTransparency) or openButton.BackgroundTransparency,
                0,
                .9
            )
        end

        if window.SelectedTab then
            selectTab(window.SelectedTab)
        end
    end

    function window:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, connection in ipairs(connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        connections = {}

        if gui then
            gui:Destroy()
        end
    end

    local initialGlass = Library.ActiveTheme == "Glass"
    mainGlassGradient.Enabled = initialGlass
    sidebarGlassGradient.Enabled = initialGlass
    pagesGlassGradient.Enabled = initialGlass

    task.defer(function()
        updateScrolling(tabList, tabLayout)
    end)

    table.insert(Library._Windows, window)

    return window
end

function Library:SetTheme(name)
    local themeName = tostring(name or "")
    local source = Library.Themes[themeName]

    if not source then
        return false
    end

    Library.Theme = copyTheme(source)
    Library.ActiveTheme = themeName

    for index = #Library._Windows, 1, -1 do
        local window = Library._Windows[index]

        if not window or window.Destroyed then
            table.remove(Library._Windows, index)
        elseif window._ApplyTheme then
            window:_ApplyTheme(Library.Theme)
        end
    end

    return true
end

function Library:GetTheme()
    return Library.ActiveTheme
end

function Library:AddTheme(theme)
    if type(theme) ~= "table" then
        return false
    end

    local name = tostring(theme.Name or "")
    if name == "" then
        return false
    end

    local custom = {}
    for key, value in pairs(theme) do
        if key ~= "Name" then
            custom[key] = value
        end
    end

    Library.Themes[name] = mergeTheme(DefaultTheme, custom)
    return true
end

function Library:RemoveTheme(name)
    name = tostring(name or "")

    if name == "Dark" or name == "Glass" or name == "Midnight" or name == "Rose" or name == "Slate" then
        return false
    end

    if Library.Themes[name] then
        Library.Themes[name] = nil
        return true
    end

    return false
end

function Library:ResetTheme()
    return self:SetTheme("Dark")
end

function Library:GetThemes()
    local result = {}
    for name in pairs(Library.Themes) do
        table.insert(result, name)
    end
    table.sort(result)
    return result
end

function Library:GetName()
    return self.Name
end

function Library:GetVersion()
    return self.Version
end

return Library
