                optionLayout.Parent = optionScroller

                local opened = false
                local maxVisibleHeight = 200
                local previousPageScrolling = true
                local optionButtons = {}

                local function clearOptions()
                    for _, child in ipairs(optionScroller:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    optionButtons = {}
                end

                local function refreshOption(opt, btn)
                    local isSel = selectedSet[opt] == true
                    btn.BackgroundColor3 = isSel and windowTheme.Hover or windowTheme.Button
                    btn.TextColor3 = isSel and windowTheme.Accent or windowTheme.Text
                    btn.Text = (isSel and "[X]  " or "[  ]  ") .. tostring(opt)
                end

                local function closeDropdown()
                    if not opened then return end
                    opened = false
                    page.ScrollingEnabled = previousPageScrolling
                    clearOptions()
                    optionScroller.CanvasPosition = Vector2.new(0, 0)
                    tween(optionScroller, .18, { Size = UDim2.new(1, -18, 0, 0) }):Play()
                    tween(frame, .18, { Size = UDim2.new(1, 0, 0, 56) }):Play()
                    arrow.Text = "+"
                    unregisterDropdown(closeDropdown)
                    task.delay(.2, function()
                        if not opened then updateScrolling(page, layout) end
                    end)
                end

                local function openDropdown()
                    if #opts == 0 then return end
                    opened = true
                    previousPageScrolling = page.ScrollingEnabled
                    page.ScrollingEnabled = false
                    clearOptions()
                    optionScroller.CanvasPosition = Vector2.new(0, 0)

                    for index, option in ipairs(opts) do
                        local optionButton = Instance.new("TextButton")
                        optionButton.Size = UDim2.new(1, 0, 0, 32)
                        optionButton.BorderSizePixel = 0
                        optionButton.Font = Font.Regular
                        optionButton.TextSize = 11
                        optionButton.LayoutOrder = index
                        optionButton.AutoButtonColor = false
                        optionButton.Parent = optionScroller
                        themeRole(optionButton, "Button")
                        corner(optionButton, 8)
                        padding(optionButton, 10, 10, 0, 0)
                        optionButton.TextXAlignment = Enum.TextXAlignment.Left
                        optionButtons[option] = optionButton
                        refreshOption(option, optionButton)

                        connect(optionButton.MouseEnter, function()
                            if not selectedSet[option] then
