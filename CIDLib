local function copyTheme(source)
    local result = {}
    for key, value in pairs(source or {}) do
        result[key] = value
    end
    return result
end

local function mergeTheme(base, custom)
    local result = copyTheme(base)
    for key, value in pairs(custom or {}) do
        if result[key] ~= nil or key == "Name" then
            result[key] = value
        end
    end
    return result
end

local function themeRole(object, role)
    if object and object:IsA("Instance") then
        object:SetAttribute("CIDThemeRole", role)
    end
    return object
end

local function applyThemeRole(object, role, theme)
    if not object or not object.Parent then
        return
    end

    if role == "Stroke" and object:IsA("UIStroke") then
        object.Color = theme.Stroke
        if theme.StrokeTransparency ~= nil then
            object.Transparency = theme.StrokeTransparency
        end
        return
    end

    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
        if role == "Text" then
            object.TextColor3 = theme.Text
        elseif role == "Sub" then
            object.TextColor3 = theme.Sub
        elseif role == "AccentText" then
            object.TextColor3 = theme.AccentText
        elseif object:GetAttribute("CIDTextRole") == "Text" then
            object.TextColor3 = theme.Text
        elseif role == "Button" and object:IsA("TextButton") then
            object.TextColor3 = theme.Sub
        elseif role == "Accent" and object:IsA("TextButton") then
            object.TextColor3 = theme.AccentText
        elseif role == "OpenButton" and object:IsA("TextButton") then
            object.TextColor3 = theme.Text
        elseif role == "DialogPrimary" and object:IsA("TextButton") then
            object.TextColor3 = theme.AccentText
        elseif role == "DialogButton" and object:IsA("TextButton") then
            object.TextColor3 = theme.Text
        end
    end

    if role == "ImageButton" and object:IsA("ImageButton") then
        object.BackgroundColor3 = theme.Button
    elseif object:IsA("GuiObject") then
        local color = theme[role]

        if role == "OpenButton" then
            color = theme.Bg
        elseif role == "Notification" or role == "Dialog" then
            color = theme.Panel
        elseif role == "DialogButton" then
            color = theme.Button
        elseif role == "DialogPrimary" then
            color = theme.Accent
        end

        if typeof(color) == "Color3" then
            object.BackgroundColor3 = color
        end
    end
end

local function applyThemeTransparency(object, role, theme)
    if not object or not object.Parent or not object:IsA("GuiObject") then
        return
    end

    local value
    if role == "Bg" then
        value = theme.Transparency
    elseif role == "Panel" then
        value = theme.PanelTransparency
    elseif role == "Content" then
        value = theme.ContentTransparency
    elseif role == "Button" then
        value = theme.ButtonTransparency
    elseif role == "Input" then
        value = theme.InputTransparency
    elseif role == "OpenButton" then
        value = theme.OpenButtonTransparency
    elseif role == "Notification" then
        value = theme.NotificationTransparency
    elseif role == "DialogOverlay" then
        value = theme.DialogOverlayTransparency
    end

    if value ~= nil then
        object.BackgroundTransparency = value
    end
end

local function applyThemeToRoot(root, theme)
    if not root then
        return
    end

    local objects = {root}
    for _, descendant in ipairs(root:GetDescendants()) do
        table.insert(objects, descendant)
    end

    for _, object in ipairs(objects) do
        local role = object:GetAttribute("CIDThemeRole")
        if role then
            applyThemeRole(object, role, theme)
            applyThemeTransparency(object, role, theme)
        end
    end
end

local Font = {
    Title = Enum.Font.GothamBold,
    Medium = Enum.Font.GothamMedium,
    Regular = Enum.Font.Gotham,
    Code = Enum.Font.Code
}

local function safe(value)
    return type(value) == "table" and value or {}
end

local function corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = object
    return c
end

local function stroke(object, color, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Transparency = transparency or 0
    s.Parent = object
    themeRole(s, "Stroke")
    return s
end

local function surfaceGradient(object)
    local gradient = Instance.new("UIGradient")
    gradient.Name = "CIDGlassGradient"
    gradient.Rotation = 90
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(.45, Color3.fromRGB(225, 235, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 190, 220))
    })
    gradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, .90),
        NumberSequenceKeypoint.new(.5, .97),
        NumberSequenceKeypoint.new(1, .94)
    })
    gradient.Parent = object
    return gradient
end


local function label(parent, text, position, size, font, textSize, textColor)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = tostring(text or "")
    l.Position = position
    l.Size = size
    l.Font = font
    l.TextSize = textSize
    l.TextColor3 = textColor
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = parent

    if textColor == Library.Theme.Text then
        themeRole(l, "Text")
    elseif textColor == Library.Theme.Sub then
        themeRole(l, "Sub")
    elseif textColor == Library.Theme.Accent then
        themeRole(l, "Accent")
    else
        themeRole(l, "Text")
    end

    return l
end

local function tween(object, duration, properties)
    return TweenService:Create(
        object,
        TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        properties
    )
end

local function invoke(fn, ...)
    if type(fn) ~= "function" then
        return
    end

    local args = table.pack(...)

    task.spawn(function()
        local ok, err = pcall(function()
            fn(table.unpack(args, 1, args.n))
        end)

        if not ok then
            warn("[CID UI] Callback:", err)
        end
    end)
end

local function getParent()
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and typeof(result) == "Instance" then
            return result
        end
    end

    return CoreGui
end

local function createGui(config)
    local parent = getParent()
    local name = config.GuiName or "CID_UI"

    local old = parent:FindFirstChild(name)

    if old then
        old:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = config.DisplayOrder or 999
    gui.Parent = parent

    return gui
end

local function makeBase(parent, height)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, height)
    frame.BackgroundColor3 = Library.Theme.Panel
    frame.BorderSizePixel = 0
    frame.Parent = parent
    themeRole(frame, "Panel")

    corner(frame, 9)
    stroke(frame, Library.Theme.Stroke, .35)

    return frame
end

