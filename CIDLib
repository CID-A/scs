        function tab:Slider(optionsOrName, min, max, default, callback, description)
            if type(optionsOrName) == "table" then
                local options = safe(optionsOrName)
                local mn = tonumber(options.Min) or 0
                local mx = tonumber(options.Max) or 100
                if mx < mn then mn, mx = mx, mn end
                local step = math.abs(tonumber(options.Step) or 1)
                if step <= 0 then step = 1 end

                local value = math.clamp(tonumber(options.Default) or mn, mn, mx)
                local hasDesc = options.Description ~= nil
                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 0, hasDesc and 84 or 72)
                frame.BackgroundColor3 = windowTheme.Panel
                frame.BorderSizePixel = 0
                addItem(frame)
                frame.Parent = page
                themeRole(frame, "Panel")
                corner(frame, 9)
                stroke(frame, windowTheme.Stroke, .35)

                label(frame, options.Title or options.Name or "Slider",
                    UDim2.fromOffset(14, 6), UDim2.new(.7, 0, 0, 20),
                    Font.Medium, 13, windowTheme.Text, "Text")

                if hasDesc then
                    label(frame, options.Description,
                        UDim2.fromOffset(14, 27), UDim2.new(1, -28, 0, 17),
                        Font.Regular, 12, windowTheme.Sub, "Sub")
                end

                local function formatValue(v)
                    local s = string.format("%.2f", v)
                    s = s:gsub("%.?0+$", "")
                    return s
                end

                local valueLabel = label(frame, formatValue(value),
                    UDim2.new(.7, 0, 0, 6), UDim2.new(.3, -14, 0, 20),
                    Font.Code, 11, windowTheme.Sub, "Sub")
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right

                local track = Instance.new("Frame")
                track.Position = UDim2.fromOffset(14, hasDesc and 62 or 48)
                track.Size = UDim2.new(1, -28, 0, 7)
                track.BackgroundColor3 = windowTheme.ToggleOff
                track.Parent = frame
                corner(track, 100)

                local fill = Instance.new("Frame")
                fill.Size = UDim2.fromScale(0, 1)
                fill.BackgroundColor3 = windowTheme.Accent
                fill.BorderSizePixel = 0
                fill.Parent = track
                corner(fill, 100)

                local knob = Instance.new("Frame")
                knob.AnchorPoint = Vector2.new(.5, .5)
                knob.Size = UDim2.fromOffset(16, 16)
                knob.Position = UDim2.new(0, 0, .5, 0)
                knob.BackgroundColor3 = windowTheme.Accent
                knob.BorderSizePixel = 0
                knob.Parent = track
                corner(knob, 100)

                local dragging = false
                local fireCallback
                if options.Debounce then
                    fireCallback = debounce(options.Callback, tonumber(options.Debounce) or 0.1)
                else
                    fireCallback = throttle(options.Callback, tonumber(options.Throttle) or 0.05)
                end

                local function render()
                    local alpha = mx > mn and math.clamp((value - mn) / (mx - mn), 0, 1) or 0
                    fill.Size = UDim2.new(alpha, 0, 1, 0)
                    knob.Position = UDim2.new(alpha, 0, .5, 0)
                    valueLabel.Text = formatValue(value)
                end

                local function setFromX(x)
                    local trackW = track.AbsoluteSize.X
                    if trackW <= 0 then return end
                    local alpha = math.clamp((x - track.AbsolutePosition.X) / trackW, 0, 1)
                    local raw = mn + (mx - mn) * alpha
                    value = math.clamp(mn + math.floor((raw - mn) / step + .5) * step, mn, mx)
                    render()
                    fireCallback(value)
                end

                render()

                connect(track.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        setFromX(input.Position.X)
                    end
                end)
                connect(UIS.InputChanged, function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch) then
                        setFromX(input.Position.X)
                    end
                end)
                connect(UIS.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                return {
                    Frame = frame,
                    Set = function(_, nv)
                        value = math.clamp(tonumber(nv) or mn, mn, mx)
                        render()
                        invoke(options.Callback, value)
                    end,
                    Get = function() return value end
                }
            end

            return self:Slider({
                Title = tostring(optionsOrName or "Slider"),
                Description = description,
                Min = min,
                Max = max,
                Default = default,
                Callback = callback
            })
        end

