                    connect(optionButton.MouseLeave, function()
                        optionButton.BackgroundColor3 = Library.Theme.Button
                    end)
                    connect(optionButton.MouseButton1Click, function()
                        selected = option
                        selectedLabel.Text = tostring(option)
                        invoke(options.Callback, option)
                        closeDropdown()
                    end)
                end

                local visibleHeight = getDropdownHeight()
                optionScroller.Size = UDim2.new(1, -18, 0, visibleHeight)
                frame.Size = UDim2.new(1, 0, 0, 61 + visibleHeight)
                updateScrolling(page, layout)
            end

            connect(headerButton.MouseButton1Click, function()
                if opened then
                    closeDropdown()
                else
                    openDropdown()
                end
            end)

            return {
                Frame = frame,

                Set = function(_, value)
                    for _, option in ipairs(optionsList) do
                        if option == value then
                            selected = value
                            selectedLabel.Text = tostring(value)
                            invoke(options.Callback, value)
                            return true
                        end
                    end

                    return false
                end,

                Get = function()
                    return selected
                end,

                SetOptions = function(_, newOptions)
                    optionsList = type(newOptions) == "table" and newOptions or {}
                    local found = false
                    for _, option in ipairs(optionsList) do
                        if option == selected then
                            found = true
                            break
                        end
                    end
                    if not found then
                        selected = optionsList[1]
                        selectedLabel.Text = tostring(selected or "None")
                    end
                    closeDropdown()
                end
            }
        end

