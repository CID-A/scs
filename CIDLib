local existingRegistry = pruneRegistry()

if type(_G) == "table" and type(_G.CID_UI_Instance) == "table"
and type(_G.CID_UI_Instance.Destroy) == "function"
and not _G.CID_UI_Instance._Destroyed then
    local alreadyListed = false
    for _, entry in ipairs(existingRegistry) do
        if entry.Library == _G.CID_UI_Instance then
            alreadyListed = true
            break
        end
    end
    if not alreadyListed then
        table.insert(existingRegistry, {
            Library = _G.CID_UI_Instance,
            ResolvedName = "CID_UI"
        })
    end
end

local forceCoexist = false
local preForcedName = nil

if type(_G) == "table" and type(_G.CID_UI_ForceName) == "string" then
    preForcedName = _G.CID_UI_ForceName
end

if preForcedName then
    Library._InstanceName = preForcedName
    Library._ForceName = preForcedName
    for i = #existingRegistry, 1, -1 do
        local entry = existingRegistry[i]
        if entry.ResolvedName == preForcedName then
            pcall(function() entry.Library:Destroy() end)
            table.remove(existingRegistry, i)
        end
    end
elseif #existingRegistry > 0 then
    local behavior = nil
    if type(_G) == "table" then
        behavior = _G.CID_UI_ConflictBehavior
    end

    if behavior == "cancel" then
        return makeStub()
    elseif behavior == "replace" then
        for _, entry in ipairs(existingRegistry) do
            pcall(function() entry.Library:Destroy() end)
        end
    elseif behavior == "coexist" then
        forceCoexist = true
    else
        local picked = showConflictDialog(#existingRegistry)
        if picked == "cancel" then
            return makeStub()
        elseif picked == "replace" then
            for _, entry in ipairs(existingRegistry) do
                pcall(function() entry.Library:Destroy() end)
            end
        elseif picked == "coexist" then
            forceCoexist = true
        end
    end
end

