            optionScroller.CanvasSize = UDim2.new()
            optionScroller.ClipsDescendants = true
            optionScroller.Parent = frame
            themeRole(optionScroller, "Content")
            corner(optionScroller, 9)
            padding(optionScroller, 5, 5, 5, 5)

            local optionLayout = Instance.new("UIListLayout")
            optionLayout.Padding = UDim.new(0, 4)
            optionLayout.SortOrder = Enum.SortOrder.LayoutOrder
            optionLayout.Parent = optionScroller

            local opened = false
            local maxVisibleHeight = 200
            local previousPageScrolling = true
            local optionButtons = {}

            local function clearOptions()
                for _, child in ipairs(optionScroller:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                optionButtons = {}
            end

            local function refreshOption(opt, btn)
                local isSel = selectedSet[opt] == true
                btn.BackgroundColor3 = isSel and windowTheme.Hover or windowTheme.Button
                btn.TextColor3 = isSel and windowTheme.Accent or windowTheme.Text
                btn.Text = (isSel and "[X]  " or "[  ]  ") .. tostring(opt)
            end

            local function closeDropdown()
                if not opened then return end
                opened = false
                page.ScrollingEnabled = previousPageScrolling
                clearOptions()
                optionScroller.CanvasPosition = Vector2.new(0, 0)
                tween(optionScroller, .18, { Size = UDim2.new(1, -18, 0, 0) }):Play()
                tween(frame, .18, { Size = UDim2.new(1, 0, 0, 56) }):Play()
                arrow.Text = "+"
                unregisterDropdown(closeDropdown)
                task.delay(.2, function()
                    if not opened then updateScrolling(page, layout) end
                end)
            end

            local function openDropdown()
                if #optionsList == 0 then return end
                opened = true
                previousPageScrolling = page.ScrollingEnabled
                page.ScrollingEnabled = false
                clearOptions()
                optionScroller.CanvasPosition = Vector2.new(0, 0)

                for index, option in ipairs(optionsList) do
                    local optionButton = Instance.new("TextButton")
                    optionButton.Size = UDim2.new(1, 0, 0, 32)
                    optionButton.BorderSizePixel = 0
                    optionButton.Font = Font.Regular
                    optionButton.TextSize = 11
                    optionButton.LayoutOrder = index
                    optionButton.AutoButtonColor = false
                    optionButton.Parent = optionScroller
                    themeRole(optionButton, "Button")
                    corner(optionButton, 8)
                    padding(optionButton, 10, 10, 0, 0)
                    optionButton.TextXAlignment = Enum.TextXAlignment.Left
                    optionButtons[option] = optionButton
                    refreshOption(option, optionButton)

                    connect(optionButton.MouseEnter, function()
                        if not selectedSet[option] then
                            optionButton.BackgroundColor3 = windowTheme.Hover
                        end
                    end)
                    connect(optionButton.MouseLeave, function()
                        refreshOption(option, optionButton)
                    end)
                    connect(optionButton.MouseButton1Click, function()
                        selectedSet[option] = not selectedSet[option]
                        refreshOption(option, optionButton)
                        selectedLabel.Text = getSummary()
                        local list = {}
                        for _, o in ipairs(optionsList) do
                            if selectedSet[o] then table.insert(list, o) end
                        end
                        invoke(options.Callback, list)
                    end)
                end

                local visibleHeight = math.min(#optionsList * 36 + 10, maxVisibleHeight)
                tween(optionScroller, .18, { Size = UDim2.new(1, -18, 0, visibleHeight) }):Play()
                tween(frame, .18, { Size = UDim2.new(1, 0, 0, 61 + visibleHeight) }):Play()
                arrow.Text = "-"
                registerDropdown(frame, closeDropdown)
                task.delay(.2, function()
                    if opened then updateScrolling(page, layout) end
                end)
            end

            connect(headerButton.MouseButton1Click, function()
                if opened then closeDropdown() else openDropdown() end
            end)

            return {
                Frame = frame,
                Get = function()
                    local list = {}
                    for _, o in ipairs(optionsList) do
                        if selectedSet[o] then table.insert(list, o) end
                    end
                    return list
                end,
                Set = function(_, list)
                    selectedSet = {}
                    if type(list) == "table" then
                        for _, v in ipairs(list) do selectedSet[v] = true end
                    end
                    selectedLabel.Text = getSummary()
                    if opened then
                        for opt, btn in pairs(optionButtons) do refreshOption(opt, btn) end
                    end
                    local result = {}
                    for _, o in ipairs(optionsList) do
                        if selectedSet[o] then table.insert(result, o) end
                    end
                    invoke(options.Callback, result)
                end,
                SelectAll = function()
                    for _, o in ipairs(optionsList) do selectedSet[o] = true end
                    selectedLabel.Text = getSummary()
                    if opened then
                        for opt, btn in pairs(optionButtons) do refreshOption(opt, btn) end
                    end
                end,
                ClearAll = function()
                    selectedSet = {}
                    selectedLabel.Text = getSummary()
                    if opened then
                        for opt, btn in pairs(optionButtons) do refreshOption(opt, btn) end
                    end
                    invoke(options.Callback, {})
                end,
                Close = closeDropdown
            }
        end

        function tab:CreateInput(options)
            options = safe(options)
            local hasDesc = options.Description ~= nil
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, hasDesc and 92 or 74)
            frame.BackgroundColor3 = windowTheme.Panel
            frame.BorderSizePixel = 0
            addItem(frame)
            frame.Parent = page
            themeRole(frame, "Panel")
            corner(frame, 9)
            stroke(frame, windowTheme.Stroke, .35)

            label(frame, options.Title or options.Name or "Input",
                UDim2.fromOffset(14, 6), UDim2.new(1, -28, 0, 20),
                Font.Medium, 13, windowTheme.Text, "Text")

            if hasDesc then
                label(frame, options.Description,
                    UDim2.fromOffset(14, 27), UDim2.new(1, -28, 0, 17),
                    Font.Regular, 12, windowTheme.Sub, "Sub")
            end

            local box = Instance.new("TextBox")
            box.Position = UDim2.fromOffset(11, hasDesc and 52 or 36)
            box.Size = UDim2.new(1, -22, 0, 30)
            box.BackgroundColor3 = windowTheme.Input
            box.BorderSizePixel = 0
            box.ClearTextOnFocus = false
            box.PlaceholderText = options.Placeholder or "Escribe algo..."
            box.PlaceholderColor3 = windowTheme.Sub
            box.Text = tostring(options.Default or "")
            box.TextColor3 = windowTheme.Text
            box.Font = Font.Regular
            box.TextSize = 12
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.Parent = frame
            themeRole(box, "Input")
            corner(box, 8)
            padding(box, 10, 10, 0, 0)

            local errorLabel = label(frame, "",
                UDim2.fromOffset(14, hasDesc and 82 or 68),
                UDim2.new(1, -28, 0, 14),
                Font.Regular, 10, Color3.fromRGB(240, 90, 90))

            local function validate(text)
                if type(options.Validate) ~= "function" then
                    errorLabel.Text = ""
                    return true
                end
                local ok, msg = options.Validate(text)
                if ok == false or ok == nil then
                    errorLabel.Text = tostring(msg or "Invalid value")
                    return false
                end
                errorLabel.Text = ""
                return true
            end

            local debouncedCallback
            if options.Debounce then
                debouncedCallback = debounce(function(text)
                    if validate(text) then invoke(options.Callback, text) end
                end, tonumber(options.Debounce) or 0.3)
            end

            connect(box.FocusLost, function()
                if validate(box.Text) then invoke(options.Callback, box.Text) end
            end)
            connect(box:GetPropertyChangedSignal("Text"), function()
                if debouncedCallback then debouncedCallback(box.Text) end
            end)

            return {
                Frame = frame,
                Box = box,
                Set = function(_, value)
                    box.Text = tostring(value or "")
                    validate(box.Text)
                end,
                Get = function() return box.Text end,
                Validate = validate
            }
        end

        function tab:CreateSlider(options)
            options = safe(options)
            local min = tonumber(options.Min) or 0
            local max = tonumber(options.Max) or 100
            if max < min then min, max = max, min end
            local step = math.abs(tonumber(options.Step) or 1)
            if step <= 0 then step = 1 end

            local value = math.clamp(tonumber(options.Default) or min, min, max)
            local hasDesc = options.Description ~= nil
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, hasDesc and 84 or 72)
            frame.BackgroundColor3 = windowTheme.Panel
            frame.BorderSizePixel = 0
            addItem(frame)
            frame.Parent = page
            themeRole(frame, "Panel")
            corner(frame, 9)
            stroke(frame, windowTheme.Stroke, .35)

            label(frame, options.Title or options.Name or "Slider",
                UDim2.fromOffset(14, 6), UDim2.new(.7, 0, 0, 20),
                Font.Medium, 13, windowTheme.Text, "Text")

            if hasDesc then
                label(frame, options.Description,
                    UDim2.fromOffset(14, 27), UDim2.new(1, -28, 0, 17),
                    Font.Regular, 12, windowTheme.Sub, "Sub")
            end

            local function formatValue(v)
                local s = string.format("%.2f", v)
                s = s:gsub("%.?0+$", "")
                return s
            end

            local valueLabel = label(frame, formatValue(value),
                UDim2.new(.7, 0, 0, 6), UDim2.new(.3, -14, 0, 20),
                Font.Code, 11, windowTheme.Sub, "Sub")
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right

            local track = Instance.new("Frame")
            track.Position = UDim2.fromOffset(14, hasDesc and 62 or 48)
            track.Size = UDim2.new(1, -28, 0, 7)
            track.BackgroundColor3 = windowTheme.ToggleOff
            track.Parent = frame
            corner(track, 100)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.fromScale(0, 1)
            fill.BackgroundColor3 = windowTheme.Accent
            fill.BorderSizePixel = 0
            fill.Parent = track
            corner(fill, 100)

            local knob = Instance.new("Frame")
            knob.AnchorPoint = Vector2.new(.5, .5)
            knob.Size = UDim2.fromOffset(16, 16)
            knob.Position = UDim2.new(0, 0, .5, 0)
            knob.BackgroundColor3 = windowTheme.Accent
            knob.BorderSizePixel = 0
            knob.Parent = track
            corner(knob, 100)

            local dragging = false
            local fireCallback
            if options.Debounce then
                fireCallback = debounce(options.Callback, tonumber(options.Debounce) or 0.1)
            else
                fireCallback = throttle(options.Callback, tonumber(options.Throttle) or 0.05)
            end

            local function render()
                local alpha = max > min and math.clamp((value - min) / (max - min), 0, 1) or 0
                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, .5, 0)
                valueLabel.Text = formatValue(value)
            end

            local function setFromX(x)
                local trackW = track.AbsoluteSize.X
                if trackW <= 0 then return end
                local alpha = math.clamp((x - track.AbsolutePosition.X) / trackW, 0, 1)
                local raw = min + (max - min) * alpha
                value = math.clamp(min + math.floor((raw - min) / step + .5) * step, min, max)
                render()
                fireCallback(value)
            end

            render()

            connect(track.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    setFromX(input.Position.X)
                end
            end)
            connect(UIS.InputChanged, function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    setFromX(input.Position.X)
                end
            end)
            connect(UIS.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            return {
                Frame = frame,
                Set = function(_, nv)
                    value = math.clamp(tonumber(nv) or min, min, max)
                    render()
                    invoke(options.Callback, value)
                end,
                Get = function() return value end
            }
        end

