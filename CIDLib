            local opened = false
            local maxVisibleHeight = 184
            local previousPageScrolling = true
            local optionButtons = {}

            local function clearOptions()
                for _, child in ipairs(optionScroller:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                optionButtons = {}
            end

            local function refreshOptionHighlight()
                for opt, btn in pairs(optionButtons) do
                    if opt == selected then
                        btn.BackgroundColor3 = windowTheme.Hover
                        btn.TextColor3 = windowTheme.Accent
                    else
                        btn.BackgroundColor3 = windowTheme.Button
                        btn.TextColor3 = windowTheme.Text
                    end
                end
            end

            local function closeDropdown()
                if not opened then return end
                opened = false
                page.ScrollingEnabled = previousPageScrolling
                clearOptions()
                optionScroller.CanvasPosition = Vector2.new(0, 0)
                tween(optionScroller, .18, { Size = UDim2.new(1, -18, 0, 0) }):Play()
                tween(frame, .18, { Size = UDim2.new(1, 0, 0, 56) }):Play()
                arrow.Text = "+"
                unregisterDropdown(closeDropdown)
                task.delay(.2, function()
                    if not opened then updateScrolling(page, layout) end
                end)
            end

            local function openDropdown()
                if #optionsList == 0 then return end
                opened = true
                previousPageScrolling = page.ScrollingEnabled
                page.ScrollingEnabled = false
                clearOptions()
                optionScroller.CanvasPosition = Vector2.new(0, 0)

                for index, option in ipairs(optionsList) do
                    local optionButton = Instance.new("TextButton")
                    optionButton.Size = UDim2.new(1, 0, 0, 32)
                    optionButton.BackgroundColor3 = windowTheme.Button
                    optionButton.BorderSizePixel = 0
                    optionButton.Text = tostring(option)
