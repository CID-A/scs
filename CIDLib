                    frame,
                    options.Description,
                    UDim2.fromOffset(14, 27),
                    UDim2.new(1, -28, 0, 17),
                    Font.Regular,
                    12,
                    Library.Theme.Sub
                )
            end

            local valueLabel = label(
                frame,
                tostring(value),
                UDim2.new(.7, 0, 0, 6),
                UDim2.new(.3, -14, 0, 20),
                Font.Code,
                10,
                Library.Theme.Sub
            )

            valueLabel.TextXAlignment = Enum.TextXAlignment.Right

            local track = Instance.new("Frame")
            track.Position = UDim2.fromOffset(14, options.Description and 60 or 46)
            track.Size = UDim2.new(1, -28, 0, 7)
            track.BackgroundColor3 = Library.Theme.ToggleOff
            track.Parent = frame
            themeRole(track, "ToggleOff")

            corner(track, 100)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.fromScale(0, 1)
            fill.BackgroundColor3 = Library.Theme.Accent
            fill.Parent = track
            themeRole(fill, "Accent")

            corner(fill, 100)

            local knob = Instance.new("Frame")
            knob.AnchorPoint = Vector2.new(.5, .5)
            knob.Size = UDim2.fromOffset(16, 16)
            knob.Position = UDim2.new(0, 0, .5, 0)
            knob.BackgroundColor3 = Library.Theme.Accent
            knob.Parent = track
            themeRole(knob, "Accent")

            corner(knob, 100)

            local dragging = false

            local function render()
                local alpha =
                    max > min and math.clamp((value - min) / (max - min), 0, 1) or 0

                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, .5, 0)
                valueLabel.Text = tostring(value)
            end

            local function setFromX(x)
                local trackWidth = track.AbsoluteSize.X

                if trackWidth <= 0 then
                    return
                end

                local alpha = math.clamp(
                    (x - track.AbsolutePosition.X) / trackWidth,
                    0,
                    1
                )

                local raw = min + (max - min) * alpha

                value = math.clamp(
                    min + math.floor((raw - min) / step + .5) * step,
                    min,
                    max
                )

                render()
                invoke(options.Callback, value)
            end

            render()

            connect(track.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then

                    dragging = true
                    setFromX(input.Position.X)
                end
            end)

            connect(UIS.InputChanged, function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    setFromX(input.Position.X)
                end
            end)

            connect(UIS.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then

                    dragging = false
                end
            end)

            return {
                Frame = frame,

                Set = function(_, newValue)
                    value = math.clamp(
                        tonumber(newValue) or min,
                        min,
                        max
                    )

                    render()
                    invoke(options.Callback, value)
                end,

                Get = function()
                    return value
                end
            }
        end

