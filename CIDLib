                        end
                        return list
                    end,
                    Set = function(_, list)
                        selectedSet = {}
                        if type(list) == "table" then
                            for _, v in ipairs(list) do selectedSet[v] = true end
                        end
                        selectedLabel.Text = getSummary()
                        if opened then
                            for opt, btn in pairs(optionButtons) do refreshOption(opt, btn) end
                        end
                        local result = {}
