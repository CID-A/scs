                label.Text = inputConfig.Title
                label.TextColor3 = Style.Text
                label.TextSize = 13
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.BackgroundTransparency = 1
                label.Parent = frame
                
                local textBox = Instance.new("TextBox")
                textBox.Size = UDim2.new(1, -30, 0, 35)
                textBox.Position = UDim2.new(0, 15, 0, 35)
                textBox.PlaceholderText = inputConfig.Placeholder or ""
                textBox.Text = tostring(inputConfig.Default or "")
                textBox.TextColor3 = Style.Text
                textBox.TextSize = 13
                textBox.Font = Enum.Font.Gotham
                textBox.BackgroundColor3 = Style.Background
                textBox.BackgroundTransparency = 0.5
                textBox.BorderSizePixel = 0
                textBox.Parent = frame
                applyCorner(textBox, 6)
                
                local function onFocusLost()
                    if inputConfig.Callback then
                        if inputConfig.Numeric then
                            local num = tonumber(textBox.Text)
                            if num then
                                inputConfig.Callback(num)
                                if inputId then
                                    window._elements[inputId] = {get = function() return num end, set = function(v) textBox.Text = tostring(v) end}
                                end
                            end
                        else
                            inputConfig.Callback(textBox.Text)
                            if inputId then
                                window._elements[inputId] = {get = function() return textBox.Text end, set = function(v) textBox.Text = v end}
                            end
                        end
                    end
                end
                
                textBox.FocusLost:Connect(onFocusLost)
                
                local obj = {SetValue = function(v) textBox.Text = tostring(v) end, GetValue = function() 
                    if inputConfig.Numeric then return tonumber(textBox.Text) or 0 end
                    return textBox.Text 
                end}
                if inputId then window._elements[inputId] = obj end
                return obj
            end,
            
