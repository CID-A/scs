local CIDUI = {}

-- Servicios
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer

-- Obtener información del juego
local gamePlaceId = game.PlaceId
local gameName = game:GetService("MarketplaceService"):GetProductInfo(gamePlaceId).Name or tostring(gamePlaceId)
local safeGameName = gameName:gsub("[^%w]", "_")

-- Sistema de archivos
local FileSystem = {}

function FileSystem:GetGameFolder()
    return "CID-UI_CONFIGS/" .. safeGameName
end

function FileSystem:EnsureFolders()
    pcall(function()
        if makefolder then
            makefolder("CID-UI_CONFIGS")
            makefolder(self:GetGameFolder())
        elseif syn and syn.makefolder then
            syn.makefolder("CID-UI_CONFIGS")
            syn.makefolder(self:GetGameFolder())
        end
    end)
end

function FileSystem:Save(name, data)
    self:EnsureFolders()
    local json = HttpService:JSONEncode(data)
    local path = self:GetGameFolder() .. "/" .. name .. ".txt"
    local success = false
    pcall(function()
        if writefile then
            writefile(path, json)
            success = true
        elseif syn and syn.writefile then
            syn.writefile(path, json)
            success = true
        end
    end)
    return success
end

function FileSystem:Load(name)
    local path = self:GetGameFolder() .. "/" .. name .. ".txt"
    local content = nil
    pcall(function()
        if readfile then
            content = readfile(path)
        elseif syn and syn.readfile then
            content = syn.readfile(path)
        end
    end)
    if content then
        return HttpService:JSONDecode(content)
    end
    return nil
end

function FileSystem:List()
    local path = self:GetGameFolder()
    local files = {}
    pcall(function()
        if listfiles then
            files = listfiles(path)
        elseif syn and syn.listfiles then
            files = syn.listfiles(path)
        end
    end)
    
    local configs = {}
    for _, file in pairs(files) do
        local name = file:match("([^/\\]+)%.txt$")
        if name then
            table.insert(configs, name)
        end
    end
    return configs
end

-- Estilo
local Style = {
    Background = Color3.fromRGB(28, 28, 33),
    BackgroundTrans = 0.88,
    BackgroundSecondary = Color3.fromRGB(38, 38, 45),
    BackgroundSecondaryTrans = 0.92,
    Accent = Color3.fromRGB(0, 120, 215),
    Text = Color3.fromRGB(240, 240, 245),
    TextDim = Color3.fromRGB(170, 175, 190),
    Border = Color3.fromRGB(55, 60, 70),
    CornerRadius = 8,
}

local function applyCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or Style.CornerRadius)
    corner.Parent = instance
end

-- Ventana principal
function CIDUI:CreateWindow(config)
    config = config or {}
    local title = config.Title or "CID UI"
    local subtitle = config.SubTitle or ""
    local size = config.Size or UDim2.new(0, 600, 0, 480)
    
    local gui = Instance.new("ScreenGui")
    gui.Name = "CIDUI"
    gui.Parent = game:GetService("CoreGui")
    
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = size
    mainFrame.Position = UDim2.new(0.5, -size.X.Offset/2, 0.5, -size.Y.Offset/2)
    mainFrame.BackgroundColor3 = Style.Background
    mainFrame.BackgroundTransparency = Style.BackgroundTrans
    mainFrame.BorderSizePixel = 1
    mainFrame.BorderColor3 = Style.Border
    mainFrame.ClipsDescendants = true
    mainFrame.Parent = gui
    applyCorner(mainFrame)
    
    -- Arrastrar
    local dragging = false
    local dragStart, startPos
    
    mainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
