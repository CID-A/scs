local safeGameName = gameName:gsub("[^%w]", "_")

-- Estilo moderno con transparencia
local Style = {
    Background = Color3.fromRGB(20, 20, 25),
    BackgroundTrans = 0.85,
    BackgroundSecondary = Color3.fromRGB(30, 30, 38),
    BackgroundSecondaryTrans = 0.9,
    Accent = Color3.fromRGB(100, 150, 255),
    AccentHover = Color3.fromRGB(130, 175, 255),
    Text = Color3.fromRGB(245, 245, 250),
    TextDim = Color3.fromRGB(170, 175, 190),
    Border = Color3.fromRGB(50, 55, 65),
    BorderTrans = 0.6,
    CornerRadius = 10,
    ShadowSize = 15,
    Glow = true,
}

-- Función para esquinas redondeadas
local function applyCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or Style.CornerRadius)
    corner.Parent = instance
end

-- Función para añadir borde
local function addStroke(instance, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Style.Border
    stroke.Thickness = thickness or 1
    stroke.Transparency = Style.BorderTrans
    stroke.Parent = instance
    return stroke
end

-- Sistema de configuración
local ConfigSystem = {
    _gameFolder = safeGameName,
}

function ConfigSystem:GetBaseFolder()
    return "ModernUI_Configs/" .. self._gameFolder
end

function ConfigSystem:EnsureFolder()
    pcall(function()
        if makefolder then
            makefolder("ModernUI_Configs")
            makefolder(self:GetBaseFolder())
        elseif syn and syn.makefolder then
            syn.makefolder("ModernUI_Configs")
            syn.makefolder(self:GetBaseFolder())
        end
    end)
end

function ConfigSystem:SaveConfig(name, data)
    self:EnsureFolder()
    local json = HttpService:JSONEncode(data)
    pcall(function()
        if writefile then
            writefile(self:GetBaseFolder() .. "/" .. name .. ".json", json)
        elseif syn and syn.writefile then
            syn.writefile(self:GetBaseFolder() .. "/" .. name .. ".json", json)
        end
    end)
end

function ConfigSystem:LoadConfig(name)
    local content = nil
    pcall(function()
        if readfile then
            content = readfile(self:GetBaseFolder() .. "/" .. name .. ".json")
        elseif syn and syn.readfile then
            content = syn.readfile(self:GetBaseFolder() .. "/" .. name .. ".json")
        end
    end)
    if content then
        return HttpService:JSONDecode(content)
    end
    return nil
end

function ConfigSystem:ListConfigs()
    local files = {}
    pcall(function()
        if listfiles then
            files = listfiles(self:GetBaseFolder())
        elseif syn and syn.listfiles then
            files = syn.listfiles(self:GetBaseFolder())
        end
    end)
    
    local configs = {}
    for _, file in pairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then
            table.insert(configs, name)
        end
    end
    return configs
end

