                applyCorner(frame, 8)
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -20, 0, 25)
                label.Position = UDim2.new(0, 15, 0, 8)
                label.Text = dropdownConfig.Title
                label.TextColor3 = Style.Text
                label.TextSize = 13
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.BackgroundTransparency = 1
                label.Parent = frame
                
                local dropdownBtn = Instance.new("TextButton")
                dropdownBtn.Size = UDim2.new(1, -30, 0, 35)
                dropdownBtn.Position = UDim2.new(0, 15, 0, 35)
                dropdownBtn.Text = dropdownConfig.Values[dropdownConfig.Default or 1] or dropdownConfig.Values[1]
                dropdownBtn.TextColor3 = Style.Text
                dropdownBtn.TextSize = 13
                dropdownBtn.Font = Enum.Font.Gotham
                dropdownBtn.BackgroundColor3 = Style.Background
                dropdownBtn.BackgroundTransparency = 0.5
                dropdownBtn.BorderSizePixel = 0
                dropdownBtn.Parent = frame
                applyCorner(dropdownBtn, 6)
                
                local valueIndex = dropdownConfig.Default or 1
                local values = dropdownConfig.Values
                
                dropdownBtn.MouseButton1Click:Connect(function()
                    local dropdownMenu = Instance.new("Frame")
                    dropdownMenu.Size = UDim2.new(1, -30, 0, math.min(#values * 35, 150))
                    dropdownMenu.Position = UDim2.new(0, 15, 0, 70)
                    dropdownMenu.BackgroundColor3 = Style.Background
                    dropdownMenu.BackgroundTransparency = 0.1
                    dropdownMenu.BorderSizePixel = 1
                    dropdownMenu.BorderColor3 = Style.Border
                    dropdownMenu.Parent = frame
                    applyCorner(dropdownMenu, 6)
                    
                    local menuLayout = Instance.new("UIListLayout")
                    menuLayout.Padding = UDim.new(0, 2)
                    menuLayout.Parent = dropdownMenu
                    
                    for i, v in pairs(values) do
                        local optBtn = Instance.new("TextButton")
                        optBtn.Size = UDim2.new(1, 0, 0, 32)
                        optBtn.Text = v
                        optBtn.TextColor3 = Style.Text
                        optBtn.TextSize = 12
                        optBtn.Font = Enum.Font.Gotham
                        optBtn.BackgroundColor3 = Style.BackgroundSecondary
                        optBtn.BackgroundTransparency = 0.5
                        optBtn.BorderSizePixel = 0
                        optBtn.Parent = dropdownMenu
                        
                        optBtn.MouseButton1Click:Connect(function()
                            valueIndex = i
                            dropdownBtn.Text = v
                            dropdownMenu:Destroy()
                            if dropdownConfig.Callback then dropdownConfig.Callback(v) end
                            if dropdownId then
                                window._elements[dropdownId] = {get = function() return v end, set = function(idx) valueIndex = idx; dropdownBtn.Text = values[idx] end}
                            end
                        end)
                    end
                    
                    local function closeMenu()
                        if dropdownMenu and dropdownMenu.Parent then
                            dropdownMenu:Destroy()
                        end
                    end
                    
                    task.wait(0.1)
                    local connection
                    connection = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            task.wait(0.05)
                            closeMenu()
                            connection:Disconnect()
                        end
                    end)
                end)
                
                local obj = {SetValue = function(i) valueIndex = i; dropdownBtn.Text = values[i] end, GetValue = function() return values[valueIndex] end}
                if dropdownId then window._elements[dropdownId] = obj end
                return obj
            end,
        }
        
        window._tabs[tabName] = tabObj
        return tabObj
    end
    
    -- Notificación
    function window:Notify(notification)
        local notifyFrame = Instance.new("Frame")
        notifyFrame.Size = UDim2.new(0, 320, 0, 65)
        notifyFrame.Position = UDim2.new(1, -340, 1, -85)
        notifyFrame.BackgroundColor3 = Style.BackgroundSecondary
        notifyFrame.BackgroundTransparency = 0.15
        notifyFrame.BorderSizePixel = 1
        notifyFrame.BorderColor3 = Style.Border
        notifyFrame.Parent = gui
        applyCorner(notifyFrame, 8)
        
        local titleLabel = Instance.new("TextLabel")
        titleLabel.Size = UDim2.new(1, -25, 0, 25)
        titleLabel.Position = UDim2.new(0, 15, 0, 8)
        titleLabel.Text = notification.Title or "Notificación"
        titleLabel.TextColor3 = Style.Accent
        titleLabel.TextSize = 14
        titleLabel.Font = Enum.Font.GothamBold
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        titleLabel.BackgroundTransparency = 1
        titleLabel.Parent = notifyFrame
        
        local contentLabel = Instance.new("TextLabel")
        contentLabel.Size = UDim2.new(1, -25, 0, 35)
        contentLabel.Position = UDim2.new(0, 15, 0, 30)
        contentLabel.Text = notification.Content or ""
        contentLabel.TextColor3 = Style.TextDim
        contentLabel.TextSize = 12
        contentLabel.Font = Enum.Font.Gotham
        contentLabel.TextXAlignment = Enum.TextXAlignment.Left
        contentLabel.TextYAlignment = Enum.TextYAlignment.Top
        contentLabel.BackgroundTransparency = 1
        contentLabel.Parent = notifyFrame
        
        notifyFrame.Position = UDim2.new(1, -320, 1, -85)
        notifyFrame:TweenPosition(UDim2.new(1, -340, 1, -85), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
        
        task.wait(notification.Duration or 3)
        notifyFrame:TweenPosition(UDim2.new(1, -320, 1, -85), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true)
        task.wait(0.3)
        notifyFrame:Destroy()
    end
    
    -- Sistema de configuración
    function window:SetupConfigSystem()
        local configTab = nil
        for _, tab in pairs(window._tabs) do
            if tab.name == "⚙ Configuración" then
                configTab = tab
                break
            end
        end
        
        if not configTab then
            configTab = window:AddTab({Title = "⚙ Configuración"})
        end
        
        configTab:AddSection("Gestión de configuraciones")
        
        -- Input para nombre
        local nameInput = configTab:AddInput({
            Id = "cfg_name",
            Title = "Nombre de la configuración",
            Placeholder = "Ej: MiConfig",
        })
        
        -- Dropdown de configuraciones
        local configs = ConfigSystem:ListConfigs()
        local dropdown = configTab:AddDropdown({
            Id = "cfg_dropdown",
            Title = "Configuraciones guardadas",
            Values = #configs > 0 and configs or {"-- Vacío --"},
        })
        
        -- Botón guardar
        configTab:AddButton({
            Title = "💾 Guardar configuración",
            Callback = function()
                local name = nameInput:GetValue()
                if name == "" then
                    window:Notify({Title = "Error", Content = "Ingresa un nombre", Duration = 2})
                    return
                end
                
                local data = {}
                for id, element in pairs(window._elements) do
                    if element.GetValue then
                        data[id] = element:GetValue()
                    end
                end
                
                ConfigSystem:SaveConfig(name, data)
                window:Notify({Title = "Guardado", Content = "Configuración '" .. name .. "' guardada", Duration = 2})
            end
        })
        
        -- Botón cargar
        configTab:AddButton({
            Title = "📂 Cargar configuración",
            Callback = function()
                local selected = dropdown:GetValue()
                if selected == "-- Vacío --" or not selected then
                    window:Notify({Title = "Error", Content = "No hay configuración seleccionada", Duration = 2})
                    return
                end
                
                local data = ConfigSystem:LoadConfig(selected)
                if data then
                    for id, value in pairs(data) do
                        if window._elements[id] and window._elements[id].SetValue then
                            window._elements[id]:SetValue(value)
                        end
                    end
                    window:Notify({Title = "Cargado", Content = "Configuración '" .. selected .. "' cargada", Duration = 2})
                end
            end
        })
        
        configTab:AddSection("Información")
        configTab:AddParagraph({
            Title = "📁 Carpeta de configuraciones",
            Content = safeGameName
        })
    end
    
    return window
end

return ModernUI
