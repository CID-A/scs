        contentLabel.TextSize = 12
        contentLabel.Font = Enum.Font.Gotham
        contentLabel.TextXAlignment = Enum.TextXAlignment.Left
        contentLabel.TextYAlignment = Enum.TextYAlignment.Top
        contentLabel.BackgroundTransparency = 1
        contentLabel.Parent = notifyFrame
        
        notifyFrame.Position = UDim2.new(1, -300, 1, -80)
        notifyFrame:TweenPosition(UDim2.new(1, -320, 1, -80), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
        
        task.wait(notification.Duration or 3)
        notifyFrame:TweenPosition(UDim2.new(1, -300, 1, -80), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true)
        task.wait(0.3)
        notifyFrame:Destroy()
    end
    
    -- Sistema de configuración
    function window:SetupConfigSystem()
        ConfigSystem:SetFolder("ModernUI")
        
        -- Añadir pestaña de configuraciones si no existe
        local configTab = nil
        for _, tab in pairs(window._tabs) do
            if tab.name == "Configuración" then
                configTab = tab
                break
            end
        end
        
        if not configTab then
            configTab = window:AddTab({Title = "⚙ Configuración"})
        end
        
        -- Lista de configuraciones
        local configList = configTab:AddDropdown({
            Title = "Configuraciones guardadas",
            Values = {"-- Seleccionar --"},
            Callback = function(selected)
                if selected ~= "-- Seleccionar --" then
                    local data = ConfigSystem:LoadConfig(selected)
                    if data then
                        -- Cargar valores guardados
                        for id, value in pairs(data) do
                            if id ~= "_autoload" and window._elements[id] then
                                if window._elements[id].SetValue then
                                    window._elements[id]:SetValue(value)
                                end
                            end
                        end
                        window:Notify({Title = "Cargado", Content = "Configuración " .. selected .. " cargada", Duration = 2})
                    end
                end
            end
        })
        
        -- Actualizar lista de configuraciones
        local function refreshConfigList()
            local configs = ConfigSystem:ListConfigs()
            if #configs == 0 then
                configList:SetValue("-- Seleccionar --")
            else
                table.insert(configs, 1, "-- Seleccionar --")
                -- Nota: Para actualizar dropdown completamente necesitarías recrearlo
                -- Por simplicidad, se mantiene así
            end
        end
        
        -- Guardar configuración
        local configNameInput = nil
        configTab:AddButton({
            Title = "Guardar configuración actual",
            Callback = function()
                local data = {}
                for id, element in pairs(window._elements) do
                    if element.GetValue then
                        data[id] = element:GetValue()
                    elseif type(element) ~= "table" then
                        data[id] = element
                    end
                end
                
                local name = "config_" .. os.time()
                ConfigSystem:SaveConfig(name, data)
                refreshConfigList()
                window:Notify({Title = "Guardado", Content = "Configuración " .. name .. " guardada", Duration = 2})
            end
        })
        
        configTab:AddButton({
            Title = "Cargar última configuración (auto)",
            Callback = function()
                local data = ConfigSystem:AutoLoad()
                if data then
                    for id, value in pairs(data) do
                        if id ~= "_autoload" and window._elements[id] and window._elements[id].SetValue then
                            window._elements[id]:SetValue(value)
                        end
                    end
                    window:Notify({Title = "Auto-cargado", Content = "Configuración automática cargada", Duration = 2})
                else
                    window:Notify({Title = "Info", Content = "No hay configuración para auto-cargar", Duration = 2})
                end
            end
        })
        
        -- Auto-cargar al inicio
        local autoData = ConfigSystem:AutoLoad()
        if autoData then
            task.spawn(function()
                task.wait(0.5)
                for id, value in pairs(autoData) do
                    if id ~= "_autoload" and window._elements[id] and window._elements[id].SetValue then
                        window._elements[id]:SetValue(value)
                    end
                end
            end)
        end
    end
    
    return window
end

return ModernUI
