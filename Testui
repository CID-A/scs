            AddButton = function(self, btnConfig)
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 38)
                btn.Text = btnConfig.Title or "Button"
                btn.TextColor3 = Style.Text
                btn.TextSize = 14
                btn.Font = Enum.Font.Gotham
                btn.BackgroundColor3 = Style.BackgroundSecondary
                btn.BorderSizePixel = 0
                btn.Parent = tabContent
                applyCorner(btn, 6)
                
                btn.MouseEnter:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Style.Background}):Play()
                end)
                
                btn.MouseLeave:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Style.BackgroundSecondary}):Play()
                end)
                
                btn.MouseButton1Click:Connect(function()
                    if btnConfig.Callback then btnConfig.Callback() end
                end)
                
                table.insert(self.elements, {type = "button", ref = btn, config = btnConfig})
                return btn
            end,
            
            AddToggle = function(self, toggleConfig)
                local toggleId = toggleConfig.Id
                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 0, 40)
                frame.BackgroundColor3 = Style.BackgroundSecondary
                frame.BorderSizePixel = 0
                frame.Parent = tabContent
                applyCorner(frame, 6)
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -60, 1, 0)
                label.Position = UDim2.new(0, 15, 0, 0)
                label.Text = toggleConfig.Title
                label.TextColor3 = Style.Text
                label.TextSize = 14
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.BackgroundTransparency = 1
                label.Parent = frame
                
                local toggleBtn = Instance.new("TextButton")
                toggleBtn.Size = UDim2.new(0, 50, 0, 26)
                toggleBtn.Position = UDim2.new(1, -60, 0, 7)
                toggleBtn.Text = ""
                toggleBtn.BackgroundColor3 = Style.Background
                toggleBtn.BorderSizePixel = 0
                toggleBtn.Parent = frame
                applyCorner(toggleBtn, 13)
                
                local toggleIndicator = Instance.new("Frame")
                toggleIndicator.Size = UDim2.new(0, 22, 0, 22)
                toggleIndicator.Position = UDim2.new(0, 2, 0, 2)
                toggleIndicator.BackgroundColor3 = Style.TextDim
                toggleIndicator.BorderSizePixel = 0
                toggleIndicator.Parent = toggleBtn
                applyCorner(toggleIndicator, 11)
                
                local state = toggleConfig.Default or false
                
                local function updateToggle()
                    if state then
                        TweenService:Create(toggleBtn, TweenInfo.new(0.15), {BackgroundColor3 = Style.Accent}):Play()
                        TweenService:Create(toggleIndicator, TweenInfo.new(0.15), {Position = UDim2.new(1, -24, 0, 2), BackgroundColor3 = Style.Background}):Play()
                    else
                        TweenService:Create(toggleBtn, TweenInfo.new(0.15), {BackgroundColor3 = Style.Background}):Play()
                        TweenService:Create(toggleIndicator, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0, 2), BackgroundColor3 = Style.TextDim}):Play()
                    end
                end
                
                toggleBtn.MouseButton1Click:Connect(function()
                    state = not state
                    updateToggle()
                    if toggleConfig.Callback then toggleConfig.Callback(state) end
                    if toggleId then
                        window._elements[toggleId] = {value = state, type = "toggle", set = function(v) state = v; updateToggle() end, get = function() return state end}
                    end
                end)
                
                updateToggle()
                
                local toggleObj = { SetValue = function(v) state = v; updateToggle() end, GetValue = function() return state end }
                table.insert(self.elements, {type = "toggle", ref = toggleObj, config = toggleConfig, id = toggleId})
                
                if toggleId then
                    window._elements[toggleId] = toggleObj
                end
                
                return toggleObj
            end,
            
            AddSlider = function(self, sliderConfig)
                local sliderId = sliderConfig.Id
                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 0, 70)
                frame.BackgroundColor3 = Style.BackgroundSecondary
                frame.BorderSizePixel = 0
                frame.Parent = tabContent
                applyCorner(frame, 6)
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -20, 0, 25)
                label.Position = UDim2.new(0, 15, 0, 5)
                label.Text = sliderConfig.Title
                label.TextColor3 = Style.Text
                label.TextSize = 14
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.BackgroundTransparency = 1
                label.Parent = frame
                
                local valueLabel = Instance.new("TextLabel")
                valueLabel.Size = UDim2.new(0, 50, 0, 25)
                valueLabel.Position = UDim2.new(1, -65, 0, 5)
                valueLabel.Text = tostring(sliderConfig.Default or 0)
                valueLabel.TextColor3 = Style.Accent
                valueLabel.TextSize = 14
                valueLabel.Font = Enum.Font.GothamBold
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right
                valueLabel.BackgroundTransparency = 1
                valueLabel.Parent = frame
                
                local sliderTrack = Instance.new("Frame")
                sliderTrack.Size = UDim2.new(1, -30, 0, 4)
                sliderTrack.Position = UDim2.new(0, 15, 0, 45)
                sliderTrack.BackgroundColor3 = Style.Background
                sliderTrack.BorderSizePixel = 0
                sliderTrack.Parent = frame
                applyCorner(sliderTrack, 2)
                
                local sliderFill = Instance.new("Frame")
                sliderFill.Size = UDim2.new(0, 0, 1, 0)
                sliderFill.BackgroundColor3 = Style.Accent
                sliderFill.BorderSizePixel = 0
                sliderFill.Parent = sliderTrack
                applyCorner(sliderFill, 2)
                
                local sliderKnob = Instance.new("Frame")
                sliderKnob.Size = UDim2.new(0, 14, 0, 14)
                sliderKnob.Position = UDim2.new(0, -7, 0, -5)
                sliderKnob.BackgroundColor3 = Style.Accent
                sliderKnob.BorderSizePixel = 0
                sliderKnob.Parent = sliderFill
                applyCorner(sliderKnob, 7)
                
                local min = sliderConfig.Min or 0
                local max = sliderConfig.Max or 100
                local value = sliderConfig.Default or 0
                local rounding = sliderConfig.Rounding or 0
                
                local function updateSlider()
                    local percent = (value - min) / (max - min)
                    sliderFill.Size = UDim2.new(percent, 0, 1, 0)
                    valueLabel.Text = tostring(value)
                    if sliderConfig.Callback then sliderConfig.Callback(value) end
                    if sliderId then
                        window._elements[sliderId] = {value = value, type = "slider", set = function(v) value = v; updateSlider() end, get = function() return value end}
                    end
                end
                
                local dragging = false
                local connection1, connection2, connection3
                
                local function startDrag(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        local percent = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
                        value = min + (max - min) * percent
                        if rounding > 0 then
                            value = math.floor(value * (10^rounding) + 0.5) / (10^rounding)
                        end
                        updateSlider()
                    end
                end
                
                local function dragMove(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local percent = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
                        value = min + (max - min) * percent
                        if rounding > 0 then
                            value = math.floor(value * (10^rounding) + 0.5) / (10^rounding)
                        end
                        updateSlider()
                    end
                end
                
                local function endDrag(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end
                
                sliderTrack.InputBegan:Connect(startDrag)
                connection1 = UserInputService.InputChanged:Connect(dragMove)
                connection2 = UserInputService.InputEnded:Connect(endDrag)
                
                updateSlider()
                
                local sliderObj = { 
                    SetValue = function(v) value = math.clamp(v, min, max); updateSlider() end, 
                    GetValue = function() return value end 
                }
                table.insert(self.elements, {type = "slider", ref = sliderObj, config = sliderConfig, id = sliderId})
                
                if sliderId then
                    window._elements[sliderId] = sliderObj
                end
                
                return sliderObj
            end,
            
            AddInput = function(self, inputConfig)
                local inputId = inputConfig.Id
                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 0, 70)
                frame.BackgroundColor3 = Style.BackgroundSecondary
                frame.BorderSizePixel = 0
                frame.Parent = tabContent
                applyCorner(frame, 6)
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -20, 0, 25)
                label.Position = UDim2.new(0, 15, 0, 5)
                label.Text = inputConfig.Title
                label.TextColor3 = Style.Text
                label.TextSize = 14
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.BackgroundTransparency = 1
                label.Parent = frame
                
                local textBox = Instance.new("TextBox")
                textBox.Size = UDim2.new(1, -30, 0, 35)
                textBox.Position = UDim2.new(0, 15, 0, 30)
                textBox.PlaceholderText = inputConfig.Placeholder or ""
                textBox.Text = inputConfig.Default or ""
                textBox.TextColor3 = Style.Text
                textBox.TextSize = 14
                textBox.Font = Enum.Font.Gotham
                textBox.BackgroundColor3 = Style.Background
                textBox.BorderSizePixel = 0
                textBox.Parent = frame
                applyCorner(textBox, 6)
                
                local function onFocusLost()
                    if inputConfig.Callback then
                        if inputConfig.Numeric then
                            local num = tonumber(textBox.Text)
                            if num then
                                inputConfig.Callback(num)
                                if inputId then
                                    window._elements[inputId] = num
                                end
                            end
                        else
                            inputConfig.Callback(textBox.Text)
                            if inputId then
                                window._elements[inputId] = textBox.Text
                            end
                        end
                    end
                end
                
                textBox.FocusLost:Connect(onFocusLost)
                
                local inputObj = { 
                    SetValue = function(v) textBox.Text = tostring(v) end, 
                    GetValue = function() 
                        if inputConfig.Numeric then
                            return tonumber(textBox.Text) or 0
                        end
                        return textBox.Text 
                    end 
                }
                table.insert(self.elements, {type = "input", ref = inputObj, config = inputConfig, id = inputId})
                
                if inputId then
                    window._elements[inputId] = inputObj
                end
                
                return inputObj
            end,
        }
        
        window._tabs[tabName] = tabObj
        return tabObj
    end
    
