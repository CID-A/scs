                valueLabel.Font = Enum.Font.GothamBold
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right
                valueLabel.BackgroundTransparency = 1
                valueLabel.Parent = frame
                
                local track = Instance.new("Frame")
                track.Size = UDim2.new(1, -30, 0, 4)
                track.Position = UDim2.new(0, 15, 0, 48)
                track.BackgroundColor3 = Style.Background
                track.BackgroundTransparency = 0.5
                track.BorderSizePixel = 0
                track.Parent = frame
                applyCorner(track, 2)
                
                local fill = Instance.new("Frame")
                fill.Size = UDim2.new(0, 0, 1, 0)
                fill.BackgroundColor3 = Style.Accent
                fill.BorderSizePixel = 0
                fill.Parent = track
                applyCorner(fill, 2)
                
                local knob = Instance.new("Frame")
                knob.Size = UDim2.new(0, 14, 0, 14)
                knob.Position = UDim2.new(0, -7, 0, -5)
                knob.BackgroundColor3 = Style.Accent
                knob.BorderSizePixel = 0
                knob.Parent = fill
                applyCorner(knob, 7)
                
                local min = sliderConfig.Min or 0
                local max = sliderConfig.Max or 100
                local value = sliderConfig.Default or 0
                local rounding = sliderConfig.Rounding or 0
                
                local function updateSlider()
                    local percent = (value - min) / (max - min)
                    fill.Size = UDim2.new(percent, 0, 1, 0)
                    valueLabel.Text = tostring(value)
                    if sliderConfig.Callback then sliderConfig.Callback(value) end
                end
                
                local dragging = false
                
                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        value = min + (max - min) * percent
                        if rounding > 0 then
                            value = math.floor(value * (10^rounding) + 0.5) / (10^rounding)
                        end
                        updateSlider()
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        value = min + (max - min) * percent
                        if rounding > 0 then
                            value = math.floor(value * (10^rounding) + 0.5) / (10^rounding)
                        end
                        updateSlider()
                    end
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                
                updateSlider()
                
                local obj = {
                    SetValue = function(v) value = math.clamp(v, min, max); updateSlider() end,
                    GetValue = function() return value end
                }
                if sliderId then elements[sliderId] = obj end
                return obj
            end,
            
