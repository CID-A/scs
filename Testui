                    menu.Parent = frame
                    applyCorner(menu, 6)
                    activeDropdown = menu
                    
                    local menuLayout = Instance.new("UIListLayout")
                    menuLayout.Padding = UDim.new(0, 2)
                    menuLayout.Parent = menu
                    
                    for i, v in pairs(values) do
                        local opt = Instance.new("TextButton")
                        opt.Size = UDim2.new(1, 0, 0, 32)
                        opt.Text = v
                        opt.TextColor3 = Style.Text
                        opt.TextSize = 12
                        opt.Font = Enum.Font.Gotham
                        opt.BackgroundColor3 = Style.BackgroundSecondary
                        opt.BackgroundTransparency = 0.4
                        opt.BorderSizePixel = 0
                        opt.Parent = menu
                        
                        opt.MouseButton1Click:Connect(function()
                            selectedValue = v
                            dropdownBtn.Text = v
                            if dropConfig.Callback then dropConfig.Callback(v) end
                            menu:Destroy()
                            activeDropdown = nil
                        end)
                    end
                end)
                
                local obj = {
                    SetValue = function(newValue)
                        for i, v in pairs(values) do
                            if v == newValue then
                                selectedValue = v
                                dropdownBtn.Text = v
                                break
                            end
                        end
                    end,
                    GetValue = function() return selectedValue end
                }
                if dropId then elements[dropId] = obj end
                return obj
            end,
        }
        
        window._tabs[tabName] = tabObj
        return tabObj
    end
    
    -- Sistema de configuración
    function window:SetupConfigSystem()
        local configTab = nil
        for _, tab in pairs(window._tabs) do
            if tab.name == "⚙ Configuración" then
                configTab = tab
                break
            end
        end
        
        if not configTab then
            configTab = window:AddTab({Title = "⚙ Configuración"})
        end
        
        configTab:AddSection("Gestión de configuraciones")
        
        local nameInput = configTab:AddInput({
            Title = "Nombre de la configuración",
            Placeholder = "Ej: MiConfig",
        })
        
        -- Variables para el dropdown
        local configValues = {"-- Vacío --"}
        local configDropdownObj = nil
        local lastConfigs = {}
        
        -- Función para actualizar el dropdown
        local function refreshConfigList()
            local configs = FileSystem:List()
            local newValues = {}
            if #configs > 0 then
                newValues = configs
            else
                newValues = {"-- Vacío --"}
            end
            
            -- Solo actualizar si hay cambios
            local changed = false
            if #lastConfigs ~= #newValues then
                changed = true
            else
                for i = 1, #lastConfigs do
                    if lastConfigs[i] ~= newValues[i] then
                        changed = true
                        break
                    end
                end
            end
            
            if changed and configDropdownObj then
                lastConfigs = newValues
                -- Actualizar el dropdown
                local currentVal = configDropdownObj:GetValue()
                configDropdownObj:SetValue(newValues[1] or "-- Vacío --")
            end
        end
        
        -- Crear dropdown
        configDropdownObj = configTab:AddDropdown({
            Id = "config_dropdown",
            Title = "Configuraciones guardadas",
            Values = configValues,
            Callback = function(selected)
                -- Solo seleccionar
            end
        })
        
        -- Botón guardar
        configTab:AddButton({
            Title = "💾 Guardar configuración",
            Callback = function()
                local name = nameInput:GetValue()
                if name == "" or name == "-- Vacío --" then
                    window:Notify({Title = "Error", Content = "Ingresa un nombre válido", Duration = 2})
                    return
                end
                
                local data = {}
                for id, element in pairs(elements) do
                    if element.GetValue then
                        data[id] = element:GetValue()
                    end
                end
                
                if FileSystem:Save(name, data) then
                    window:Notify({Title = "Guardado", Content = "Configuración '" .. name .. "' guardada", Duration = 2})
                    refreshConfigList()
                else
                    window:Notify({Title = "Error", Content = "No se pudo guardar", Duration = 2})
                end
            end
        })
        
        -- Botón cargar
        configTab:AddButton({
            Title = "📂 Cargar configuración",
            Callback = function()
                local selected = configDropdownObj:GetValue()
                if selected == "-- Vacío --" then
                    window:Notify({Title = "Error", Content = "No hay configuración seleccionada", Duration = 2})
                    return
                end
                
                local data = FileSystem:Load(selected)
                if data then
                    for id, value in pairs(data) do
                        if elements[id] and elements[id].SetValue then
                            elements[id]:SetValue(value)
                        end
                    end
                    window:Notify({Title = "Cargado", Content = "Configuración '" .. selected .. "' cargada", Duration = 2})
                else
                    window:Notify({Title = "Error", Content = "No se pudo cargar", Duration = 2})
                end
            end
        })
        
        -- Inicializar lista
        refreshConfigList()
        
        configTab:AddSection("Información")
        configTab:AddParagraph({
            Title = "📁 Carpeta actual",
            Content = "CID-UI_CONFIGS/" .. safeGameName
        })
    end
    
    return window
end

return CIDUI
