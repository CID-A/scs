                box.BackgroundTransparency = 0.4
                box.BorderSizePixel = 0
                box.Parent = frame
                applyCorner(box, 6)
                
                box.FocusLost:Connect(function()
                    if inputConfig.Callback then
                        if inputConfig.Numeric then
                            local num = tonumber(box.Text)
                            if num then
                                inputConfig.Callback(num)
                            end
                        else
                            inputConfig.Callback(box.Text)
                        end
                    end
                end)
                
                local obj = {
                    SetValue = function(v) box.Text = tostring(v) end,
                    GetValue = function() 
                        if inputConfig.Numeric then return tonumber(box.Text) or 0 end
                        return box.Text 
                    end
                }
                if inputId then elements[inputId] = obj end
                return obj
            end,
            
