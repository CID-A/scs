-- Configuración global de estilo
local Style = {
    Background = Color3.fromRGB(25, 25, 30),
    BackgroundSecondary = Color3.fromRGB(35, 35, 42),
    Accent = Color3.fromRGB(220, 220, 235),
    AccentHover = Color3.fromRGB(200, 200, 215),
    Text = Color3.fromRGB(240, 240, 245),
    TextDim = Color3.fromRGB(160, 160, 175),
    Border = Color3.fromRGB(55, 55, 65),
    CornerRadius = 8,
    ShadowSize = 12,
}

-- Función para crear esquinas redondeadas
local function applyCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or Style.CornerRadius)
    corner.Parent = instance
end

-- Función para crear sombra
local function addShadow(frame)
    local shadow = Instance.new("Frame")
    shadow.Name = "Shadow"
    shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    shadow.BackgroundTransparency = 0.6
    shadow.BorderSizePixel = 0
    shadow.ZIndex = -1
    shadow.Size = UDim2.new(1, Style.ShadowSize * 2, 1, Style.ShadowSize * 2)
    shadow.Position = UDim2.new(0, -Style.ShadowSize, 0, -Style.ShadowSize)
    shadow.Parent = frame
    applyCorner(shadow, Style.CornerRadius + 4)
    return shadow
end

-- Sistema de configuración por juego (sin errores)
local ConfigSystem = {
    _data = {},
    _currentConfig = nil,
    _autoLoadEnabled = false,
    _gameFolder = safeGameName,
}

function ConfigSystem:GetBaseFolder()
    return "ModernUI_Configs/" .. self._gameFolder
end

function ConfigSystem:EnsureFolder()
    local folderPath = self:GetBaseFolder()
    local success, err = pcall(function()
        if makefolder then
            makefolder("ModernUI_Configs")
            makefolder(folderPath)
        elseif syn and syn.makefolder then
            syn.makefolder("ModernUI_Configs")
            syn.makefolder(folderPath)
        end
    end)
    return success
end

function ConfigSystem:SaveConfig(name, data)
    self:EnsureFolder()
    local folderPath = self:GetBaseFolder()
    local json = HttpService:JSONEncode(data)
    
    local success, err = pcall(function()
        if writefile then
            writefile(folderPath .. "/" .. name .. ".json", json)
        elseif syn and syn.writefile then
            syn.writefile(folderPath .. "/" .. name .. ".json", json)
        else
            return false
        end
    end)
    return success
end

function ConfigSystem:LoadConfig(name)
    local folderPath = self:GetBaseFolder()
    local content = nil
    
    local success, err = pcall(function()
        if readfile then
            content = readfile(folderPath .. "/" .. name .. ".json")
        elseif syn and syn.readfile then
            content = syn.readfile(folderPath .. "/" .. name .. ".json")
        end
    end)
    
    if content then
        return HttpService:JSONDecode(content)
    end
    return nil
end

function ConfigSystem:ListConfigs()
    local folderPath = self:GetBaseFolder()
    local files = {}
    
    local success, err = pcall(function()
        if listfiles then
            files = listfiles(folderPath)
        elseif syn and syn.listfiles then
            files = syn.listfiles(folderPath)
        end
    end)
    
    if not success then return {} end
    
    local configs = {}
    for _, file in pairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then
            table.insert(configs, name)
        end
    end
    return configs
end

function ConfigSystem:SetAutoLoad(enabled, configName)
    self._autoLoadEnabled = enabled
    if enabled and configName then
        self._currentConfig = configName
        local data = self:LoadConfig(configName)
        if data then
            data._autoload = true
            self:SaveConfig(configName, data)
        end
    elseif not enabled and self._currentConfig then
        local data = self:LoadConfig(self._currentConfig)
        if data then
            data._autoload = false
            self:SaveConfig(self._currentConfig, data)
        end
    end
end

function ConfigSystem:AutoLoad()
    if not self._autoLoadEnabled then return nil end
    
    if self._currentConfig then
        return self:LoadConfig(self._currentConfig)
    end
    
    local configs = self:ListConfigs()
    for _, cfg in pairs(configs) do
        local data = self:LoadConfig(cfg)
        if data and data._autoload then
            self._currentConfig = cfg
            return data
        end
    end
    return nil
end

-- Ventana principal
function ModernUI:CreateWindow(config)
