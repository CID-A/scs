--[[
    ModernUI Library v1.0
    Estilo: Fluent mejorado, sin Acrylic, compatible con todos los executores
    Características:
    - Ventana con borde redondeado y sombra
    - Sistema completo de configuración (guardar/cargar)
    - Auto-carga de última configuración
    - Tabs, Botones, Toggles, Sliders, Dropdowns, Inputs
]]

local ModernUI = {}

-- Servicios
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Configuración global de estilo
local Style = {
    Background = Color3.fromRGB(25, 25, 30),      -- Gris oscuro
    BackgroundSecondary = Color3.fromRGB(35, 35, 42),
    Accent = Color3.fromRGB(220, 220, 235),       -- Blanco claro como acento
    AccentHover = Color3.fromRGB(200, 200, 215),
    Text = Color3.fromRGB(240, 240, 245),
    TextDim = Color3.fromRGB(160, 160, 175),
    Border = Color3.fromRGB(55, 55, 65),
    CornerRadius = 8,
    ShadowSize = 12,
}

-- Función para crear esquinas redondeadas
local function applyCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or Style.CornerRadius)
    corner.Parent = instance
end

-- Función para crear sombra
local function addShadow(frame)
    local shadow = Instance.new("Frame")
    shadow.Name = "Shadow"
    shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    shadow.BackgroundTransparency = 0.6
    shadow.BorderSizePixel = 0
    shadow.ZIndex = -1
    shadow.Size = UDim2.new(1, Style.ShadowSize * 2, 1, Style.ShadowSize * 2)
    shadow.Position = UDim2.new(0, -Style.ShadowSize, 0, -Style.ShadowSize)
    shadow.Parent = frame
    applyCorner(shadow, Style.CornerRadius + 4)
    return shadow
end

-- Sistema de configuración
local ConfigSystem = {
    _data = {},
    _folder = "ModernUI",
    _currentConfig = nil,
}

function ConfigSystem:SetFolder(folderName)
    self._folder = folderName
    if not isfolder and syn and syn.isfolder then
        if not syn.isfolder(folderName) then
            syn.makefolder(folderName)
        end
    elseif not isfolder and makefolder then
        makefolder(folderName)
    end
end

function ConfigSystem:SaveConfig(name, data)
    self._currentConfig = name
    local json = HttpService:JSONEncode(data)
    
    if writefile then
        writefile(self._folder .. "/" .. name .. ".json", json)
        return true
    elseif syn and syn.writefile then
        syn.writefile(self._folder .. "/" .. name .. ".json", json)
        return true
    end
    return false
end

function ConfigSystem:LoadConfig(name)
    local content = nil
    if readfile then
        content = readfile(self._folder .. "/" .. name .. ".json")
    elseif syn and syn.readfile then
        content = syn.readfile(self._folder .. "/" .. name .. ".json")
    end
    
    if content then
        self._currentConfig = name
        return HttpService:JSONDecode(content)
    end
    return nil
end

function ConfigSystem:ListConfigs()
    local files = {}
    if listfiles then
        files = listfiles(self._folder)
    elseif syn and syn.listfiles then
        files = syn.listfiles(self._folder)
    end
    
    local configs = {}
    for _, file in pairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then
            table.insert(configs, name)
        end
    end
    return configs
end

function ConfigSystem:AutoLoad()
    if self._currentConfig then
        return self:LoadConfig(self._currentConfig)
    end
    
    -- Buscar si hay una configuración marcada como autoload
    local configs = self:ListConfigs()
    for _, cfg in pairs(configs) do
        local data = self:LoadConfig(cfg)
        if data and data._autoload then
            self._currentConfig = cfg
            return data
        end
    end
    return nil
end

-- Elementos UI
local UIElements = {} -- Para guardar referencias y poder guardar/cargar configuraciones

-- Ventana principal
function ModernUI:CreateWindow(config)
    config = config or {}
    local title = config.Title or "ModernUI"
    local subtitle = config.SubTitle or ""
    local size = config.Size or UDim2.new(0, 580, 0, 460)
    
    -- Crear ScreenGui
    local gui = Instance.new("ScreenGui")
    gui.Name = "ModernUI"
    gui.Parent = game:GetService("CoreGui")
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    -- Frame principal
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = size
    mainFrame.Position = UDim2.new(0.5, -size.X.Offset/2, 0.5, -size.Y.Offset/2)
    mainFrame.BackgroundColor3 = Style.Background
    mainFrame.BorderSizePixel = 1
    mainFrame.BorderColor3 = Style.Border
    mainFrame.ClipsDescendants = true
    mainFrame.Parent = gui
    applyCorner(mainFrame)
    addShadow(mainFrame)
    
    -- Hacer la ventana arrastrable
    local dragging = false
    local dragStart, startPos
    
    mainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- Barra de título
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 45)
    titleBar.BackgroundColor3 = Style.BackgroundSecondary
    titleBar.BorderSizePixel = 0
    titleBar.Parent = mainFrame
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -100, 1, 0)
    titleLabel.Position = UDim2.new(0, 15, 0, 0)
    titleLabel.Text = title
    titleLabel.TextColor3 = Style.Text
    titleLabel.TextSize = 18
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.BackgroundTransparency = 1
    titleLabel.Parent = titleBar
    
    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.Size = UDim2.new(1, -100, 1, 0)
    subtitleLabel.Position = UDim2.new(0, 15, 0, 22)
    subtitleLabel.Text = subtitle
    subtitleLabel.TextColor3 = Style.TextDim
    subtitleLabel.TextSize = 11
    subtitleLabel.Font = Enum.Font.Gotham
    subtitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Parent = titleBar
    
    -- Botón cerrar
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -40, 0, 8)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Style.TextDim
    closeBtn.TextSize = 16
    closeBtn.Font = Enum.Font.Gotham
    closeBtn.BackgroundColor3 = Style.BackgroundSecondary
    closeBtn.BorderSizePixel = 0
    closeBtn.Parent = titleBar
    applyCorner(closeBtn, 6)
    
    closeBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)
    
    -- Contenedor de pestañas
    local tabContainer = Instance.new("Frame")
    tabContainer.Size = UDim2.new(1, 0, 0, 40)
    tabContainer.Position = UDim2.new(0, 0, 0, 45)
    tabContainer.BackgroundTransparency = 1
    tabContainer.Parent = mainFrame
    
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.Padding = UDim.new(0, 5)
    tabLayout.Parent = tabContainer
    
    -- Contenedor de contenido
    local contentContainer = Instance.new("Frame")
    contentContainer.Size = UDim2.new(1, -20, 1, -95)
    contentContainer.Position = UDim2.new(0, 10, 0, 90)
    contentContainer.BackgroundTransparency = 1
    contentContainer.Parent = mainFrame
    
    -- Objeto ventana
    local window = {
        _gui = gui,
        _mainFrame = mainFrame,
        _contentContainer = contentContainer,
        _tabs = {},
        _currentTab = nil,
        _elements = {}, -- Guardar elementos para configuración
    }
    
    -- Método para añadir pestaña
    function window:AddTab(tabConfig)
        local tabName = tabConfig.Title or "Tab"
        local tabButton = Instance.new("TextButton")
        tabButton.Size = UDim2.new(0, 100, 1, 0)
        tabButton.Text = tabName
        tabButton.TextColor3 = Style.TextDim
        tabButton.TextSize = 14
        tabButton.Font = Enum.Font.GothamSemibold
        tabButton.BackgroundColor3 = Style.BackgroundSecondary
        tabButton.BorderSizePixel = 0
        tabButton.Parent = tabContainer
        applyCorner(tabButton, 6)
        
        -- Frame de contenido de esta pestaña
        local tabContent = Instance.new("ScrollingFrame")
        tabContent.Size = UDim2.new(1, 0, 1, 0)
        tabContent.BackgroundTransparency = 1
        tabContent.ScrollBarThickness = 6
        tabContent.ScrollBarImageColor3 = Style.Accent
        tabContent.Visible = false
        tabContent.Parent = contentContainer
        
        local contentLayout = Instance.new("UIListLayout")
        contentLayout.Padding = UDim.new(0, 10)
        contentLayout.Parent = tabContent
        
        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 5)
        padding.PaddingRight = UDim.new(0, 5)
        padding.PaddingTop = UDim.new(0, 5)
        padding.PaddingBottom = UDim.new(0, 5)
        padding.Parent = tabContent
        
        -- Efecto hover en botón de pestaña
        tabButton.MouseEnter:Connect(function()
            if window._currentTab ~= tabName then
                TweenService:Create(tabButton, TweenInfo.new(0.2), {BackgroundColor3 = Style.Background}):Play()
            end
        end)
        
        tabButton.MouseLeave:Connect(function()
            if window._currentTab ~= tabName then
                TweenService:Create(tabButton, TweenInfo.new(0.2), {BackgroundColor3 = Style.BackgroundSecondary}):Play()
            end
        end)
        
        tabButton.MouseButton1Click:Connect(function()
            for _, content in pairs(window._contentContainer:GetChildren()) do
                if content:IsA("ScrollingFrame") then
                    content.Visible = false
                end
            end
            for _, btn in pairs(window._tabs) do
                TweenService:Create(btn.button, TweenInfo.new(0.2), {BackgroundColor3 = Style.BackgroundSecondary, TextColor3 = Style.TextDim}):Play()
            end
            tabContent.Visible = true
            TweenService:Create(tabButton, TweenInfo.new(0.2), {BackgroundColor3 = Style.Accent, TextColor3 = Style.Background}):Play()
            window._currentTab = tabName
        end)
        
        if next(window._tabs) == nil then
            tabContent.Visible = true
            TweenService:Create(tabButton, TweenInfo.new(0), {BackgroundColor3 = Style.Accent, TextColor3 = Style.Background}):Play()
            window._currentTab = tabName
        end
        
        local tabObj = {
            name = tabName,
            button = tabButton,
            content = tabContent,
            elements = {},
            
            -- Añadir sección
            AddSection = function(self, sectionTitle)
                local sectionFrame = Instance.new("Frame")
                sectionFrame.Size = UDim2.new(1, 0, 0, 35)
                sectionFrame.BackgroundColor3 = Style.BackgroundSecondary
                sectionFrame.BorderSizePixel = 0
                sectionFrame.Parent = tabContent
                applyCorner(sectionFrame, 6)
                
                local sectionLabel = Instance.new("TextLabel")
                sectionLabel.Size = UDim2.new(1, -15, 1, 0)
                sectionLabel.Position = UDim2.new(0, 15, 0, 0)
                sectionLabel.Text = sectionTitle
                sectionLabel.TextColor3 = Style.Text
                sectionLabel.TextSize = 14
                sectionLabel.Font = Enum.Font.GothamBold
                sectionLabel.TextXAlignment = Enum.TextXAlignment.Left
                sectionLabel.BackgroundTransparency = 1
                sectionLabel.Parent = sectionFrame
                
                return sectionFrame
            end,
            
            -- Añadir botón
            AddButton = function(self, btnConfig)
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 38)
                btn.Text = btnConfig.Title or "Button"
                btn.TextColor3 = Style.Text
                btn.TextSize = 14
                btn.Font = Enum.Font.Gotham
                btn.BackgroundColor3 = Style.BackgroundSecondary
                btn.BorderSizePixel = 0
                btn.Parent = tabContent
                applyCorner(btn, 6)
                
                btn.MouseEnter:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Style.Background}):Play()
                end)
                
                btn.MouseLeave:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Style.BackgroundSecondary}):Play()
                end)
                
                btn.MouseButton1Click:Connect(function()
                    if btnConfig.Callback then btnConfig.Callback() end
                end)
                
                table.insert(self.elements, {type = "button", ref = btn, config = btnConfig})
                return btn
            end,
            
            -- Añadir toggle
            AddToggle = function(self, toggleConfig)
                local toggleId = toggleConfig.Id
                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 0, 40)
                frame.BackgroundColor3 = Style.BackgroundSecondary
                frame.BorderSizePixel = 0
                frame.Parent = tabContent
                applyCorner(frame, 6)
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -60, 1, 0)
                label.Position = UDim2.new(0, 15, 0, 0)
                label.Text = toggleConfig.Title
                label.TextColor3 = Style.Text
                label.TextSize = 14
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.BackgroundTransparency = 1
                label.Parent = frame
                
                local toggleBtn = Instance.new("TextButton")
                toggleBtn.Size = UDim2.new(0, 50, 0, 26)
                toggleBtn.Position = UDim2.new(1, -60, 0, 7)
                toggleBtn.Text = ""
                toggleBtn.BackgroundColor3 = Style.Background
                toggleBtn.BorderSizePixel = 0
                toggleBtn.Parent = frame
                applyCorner(toggleBtn, 13)
                
                local toggleIndicator = Instance.new("Frame")
                toggleIndicator.Size = UDim2.new(0, 22, 0, 22)
                toggleIndicator.Position = UDim2.new(0, 2, 0, 2)
                toggleIndicator.BackgroundColor3 = Style.TextDim
                toggleIndicator.BorderSizePixel = 0
                toggleIndicator.Parent = toggleBtn
                applyCorner(toggleIndicator, 11)
                
                local state = toggleConfig.Default or false
                
                local function updateToggle()
                    if state then
                        TweenService:Create(toggleBtn, TweenInfo.new(0.15), {BackgroundColor3 = Style.Accent}):Play()
                        TweenService:Create(toggleIndicator, TweenInfo.new(0.15), {Position = UDim2.new(1, -24, 0, 2), BackgroundColor3 = Style.Background}):Play()
                    else
                        TweenService:Create(toggleBtn, TweenInfo.new(0.15), {BackgroundColor3 = Style.Background}):Play()
                        TweenService:Create(toggleIndicator, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0, 2), BackgroundColor3 = Style.TextDim}):Play()
                    end
                end
                
                toggleBtn.MouseButton1Click:Connect(function()
                    state = not state
                    updateToggle()
                    if toggleConfig.Callback then toggleConfig.Callback(state) end
                    if toggleId then
                        window._elements[toggleId] = state
                    end
                end)
                
                updateToggle()
                
                local toggleObj = { SetValue = function(v) state = v; updateToggle() end, GetValue = function() return state end }
                table.insert(self.elements, {type = "toggle", ref = toggleObj, config = toggleConfig, id = toggleId})
                
                if toggleId then
                    window._elements[toggleId] = toggleObj
                end
                
                return toggleObj
            end,
            
            -- Añadir slider
            AddSlider = function(self, sliderConfig)
                local sliderId = sliderConfig.Id
                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 0, 70)
                frame.BackgroundColor3 = Style.BackgroundSecondary
                frame.BorderSizePixel = 0
                frame.Parent = tabContent
                applyCorner(frame, 6)
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -20, 0, 25)
                label.Position = UDim2.new(0, 15, 0, 5)
                label.Text = sliderConfig.Title
                label.TextColor3 = Style.Text
                label.TextSize = 14
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.BackgroundTransparency = 1
                label.Parent = frame
                
                local valueLabel = Instance.new("TextLabel")
                valueLabel.Size = UDim2.new(0, 50, 0, 25)
                valueLabel.Position = UDim2.new(1, -65, 0, 5)
                valueLabel.Text = tostring(sliderConfig.Default or 0)
                valueLabel.TextColor3 = Style.Accent
                valueLabel.TextSize = 14
                valueLabel.Font = Enum.Font.GothamBold
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right
                valueLabel.BackgroundTransparency = 1
                valueLabel.Parent = frame
                
                local sliderTrack = Instance.new("Frame")
                sliderTrack.Size = UDim2.new(1, -30, 0, 4)
                sliderTrack.Position = UDim2.new(0, 15, 0, 45)
                sliderTrack.BackgroundColor3 = Style.Background
                sliderTrack.BorderSizePixel = 0
                sliderTrack.Parent = frame
                applyCorner(sliderTrack, 2)
                
                local sliderFill = Instance.new("Frame")
                sliderFill.Size = UDim2.new(0, 0, 1, 0)
                sliderFill.BackgroundColor3 = Style.Accent
                sliderFill.BorderSizePixel = 0
                sliderFill.Parent = sliderTrack
                applyCorner(sliderFill, 2)
                
                local sliderKnob = Instance.new("Frame")
                sliderKnob.Size = UDim2.new(0, 14, 0, 14)
                sliderKnob.Position = UDim2.new(0, -7, 0, -5)
                sliderKnob.BackgroundColor3 = Style.Accent
                sliderKnob.BorderSizePixel = 0
                sliderKnob.Parent = sliderFill
                applyCorner(sliderKnob, 7)
                
                local min = sliderConfig.Min or 0
                local max = sliderConfig.Max or 100
                local value = sliderConfig.Default or 0
                local rounding = sliderConfig.Rounding or 0
                
                local function updateSlider()
                    local percent = (value - min) / (max - min)
                    sliderFill.Size = UDim2.new(percent, 0, 1, 0)
                    valueLabel.Text = tostring(value)
                    if sliderConfig.Callback then sliderConfig.Callback(value) end
                    if sliderId then
                        window._elements[sliderId] = value
                    end
                end
                
                local dragging = false
                sliderTrack.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        local percent = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
                        value = min + (max - min) * percent
                        if rounding > 0 then
                            value = math.floor(value * (10^rounding) + 0.5) / (10^rounding)
                        end
                        updateSlider()
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local percent = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
                        value = min + (max - min) * percent
                        if rounding > 0 then
                            value = math.floor(value * (10^rounding) + 0.5) / (10^rounding)
                        end
                        updateSlider()
                    end
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                
                updateSlider()
                
                local sliderObj = { 
                    SetValue = function(v) value = math.clamp(v, min, max); updateSlider() end, 
                    GetValue = function() return value end 
                }
                table.insert(self.elements, {type = "slider", ref = sliderObj, config = sliderConfig, id = sliderId})
                
                if sliderId then
                    window._elements[sliderId] = sliderObj
                end
                
                return sliderObj
            end,
            
            -- Añadir dropdown
            AddDropdown = function(self, dropdownConfig)
                local dropdownId = dropdownConfig.Id
                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 0, 50)
                frame.BackgroundColor3 = Style.BackgroundSecondary
                frame.BorderSizePixel = 0
                frame.Parent = tabContent
                applyCorner(frame, 6)
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -20, 0, 25)
                label.Position = UDim2.new(0, 15, 0, 5)
                label.Text = dropdownConfig.Title
                label.TextColor3 = Style.Text
                label.TextSize = 14
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.BackgroundTransparency = 1
                label.Parent = frame
                
                local dropdownBtn = Instance.new("TextButton")
                dropdownBtn.Size = UDim2.new(0, 150, 0, 30)
                dropdownBtn.Position = UDim2.new(1, -165, 0, 15)
                dropdownBtn.Text = dropdownConfig.Values[dropdownConfig.Default or 1] or dropdownConfig.Values[1]
                dropdownBtn.TextColor3 = Style.Text
                dropdownBtn.TextSize = 13
                dropdownBtn.Font = Enum.Font.Gotham
                dropdownBtn.BackgroundColor3 = Style.Background
                dropdownBtn.BorderSizePixel = 0
                dropdownBtn.Parent = frame
                applyCorner(dropdownBtn, 6)
                
                local value = dropdownConfig.Default or 1
                local values = dropdownConfig.Values
                
                dropdownBtn.MouseButton1Click:Connect(function()
                    -- Dropdown menu simple
                    local dropdownMenu = Instance.new("Frame")
                    dropdownMenu.Size = UDim2.new(0, 150, 0, math.min(#values * 30, 200))
                    dropdownMenu.Position = UDim2.new(1, -165, 0, 45)
                    dropdownMenu.BackgroundColor3 = Style.Background
                    dropdownMenu.BorderSizePixel = 1
                    dropdownMenu.BorderColor3 = Style.Border
                    dropdownMenu.Parent = frame
                    applyCorner(dropdownMenu, 6)
                    
                    local menuLayout = Instance.new("UIListLayout")
                    menuLayout.Padding = UDim.new(0, 2)
                    menuLayout.Parent = dropdownMenu
                    
                    for i, v in pairs(values) do
                        local optBtn = Instance.new("TextButton")
                        optBtn.Size = UDim2.new(1, 0, 0, 30)
                        optBtn.Text = v
                        optBtn.TextColor3 = Style.Text
                        optBtn.TextSize = 12
                        optBtn.Font = Enum.Font.Gotham
                        optBtn.BackgroundColor3 = Style.BackgroundSecondary
                        optBtn.BorderSizePixel = 0
                        optBtn.Parent = dropdownMenu
                        
                        optBtn.MouseButton1Click:Connect(function()
                            value = i
                            dropdownBtn.Text = v
                            dropdownMenu:Destroy()
                            if dropdownConfig.Callback then dropdownConfig.Callback(v) end
                            if dropdownId then
                                window._elements[dropdownId] = v
                            end
                        end)
                    end
                    
                    -- Cerrar al hacer clic fuera
                    local function closeMenu()
                        if dropdownMenu and dropdownMenu.Parent then
                            dropdownMenu:Destroy()
                        end
                        UserInputService.InputBegan:Disconnect(closeConnection)
                    end
                    
                    local closeConnection = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            task.wait(0.1)
                            closeMenu()
                        end
                    end)
                end)
                
                local dropdownObj = { SetValue = function(i) value = i; dropdownBtn.Text = values[i]; end, GetValue = function() return values[value] end }
                table.insert(self.elements, {type = "dropdown", ref = dropdownObj, config = dropdownConfig, id = dropdownId})
                
                if dropdownId then
                    window._elements[dropdownId] = dropdownObj
                end
                
                return dropdownObj
            end,
        }
        
        window._tabs[tabName] = tabObj
        return tabObj
    end
    
    -- Sistema de notificación
    function window:Notify(notification)
