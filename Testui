        contentLabel.TextSize = 12
        contentLabel.Font = Enum.Font.Gotham
        contentLabel.TextXAlignment = Enum.TextXAlignment.Left
        contentLabel.TextYAlignment = Enum.TextYAlignment.Top
        contentLabel.BackgroundTransparency = 1
        contentLabel.Parent = notifyFrame
        
        notifyFrame.Position = UDim2.new(1, -300, 1, -80)
        notifyFrame:TweenPosition(UDim2.new(1, -320, 1, -80), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
        
        task.wait(notification.Duration or 3)
        notifyFrame:TweenPosition(UDim2.new(1, -300, 1, -80), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true)
        task.wait(0.3)
        notifyFrame:Destroy()
    end
    
    -- Sistema de configuración completo (como pides)
    function window:SetupConfigSystem()
        -- Buscar o crear pestaña de Configuración
        local configTab = nil
        for _, tab in pairs(window._tabs) do
            if tab.name == "⚙ Configuración" or tab.name == "Configuración" then
                configTab = tab
                break
            end
        end
        
        if not configTab then
            configTab = window:AddTab({Title = "⚙ Configuración"})
        end
        
        configTab:AddSection("Gestión de configuraciones")
        
        -- Input para nombre de configuración
        local configNameInput = configTab:AddInput({
            Id = "config_name_input",
            Title = "Nombre de la configuración",
            Placeholder = "Ej: Settings_V1",
            Default = "",
        })
        
        -- Dropdown de configuraciones guardadas
        local configDropdown = nil
        local lastConfigList = {}
        
        local function refreshDropdown()
            local configs = ConfigSystem:ListConfigs()
            lastConfigList = configs
            if #configs == 0 then
                if configDropdown then
                    configDropdown:SetValue("-- Sin configuraciones --")
                end
            else
                if configDropdown then
                    local current = configDropdown:GetValue()
                    if current == "-- Sin configuraciones --" or not current then
                        configDropdown:SetValue(configs[1])
                    end
                end
            end
        end
        
        configDropdown = configTab:AddDropdown({
            Id = "config_dropdown",
            Title = "Configuraciones guardadas",
            Values = {"-- Sin configuraciones --"},
            Callback = function(selected)
                if selected ~= "-- Sin configuraciones --" then
                    -- Solo seleccionar, no cargar automáticamente
                end
            end
        })
        
        -- Botón Guardar configuración
        configTab:AddButton({
            Title = "💾 Guardar configuración",
            Callback = function()
                local name = configNameInput:GetValue()
                if name == "" then
                    window:Notify({Title = "Error", Content = "Ingresa un nombre para la configuración", Duration = 2})
                    return
                end
                
                -- Recopilar datos de todos los elementos con ID
                local data = {}
                for id, element in pairs(window._elements) do
                    if element.GetValue then
                        data[id] = element:GetValue()
                    end
                end
                
                if ConfigSystem:SaveConfig(name, data) then
                    window:Notify({Title = "Guardado", Content = "Configuración '" .. name .. "' guardada", Duration = 2})
                    refreshDropdown()
                    -- Actualizar valores del dropdown
                    local configs = ConfigSystem:ListConfigs()
                    if #configs > 0 then
                        -- Recrear dropdown con nuevos valores
                        configDropdown:SetValue(configs[1])
                    end
                else
                    window:Notify({Title = "Error", Content = "No se pudo guardar la configuración", Duration = 2})
                end
            end
        })
        
        -- Botón Cargar configuración (solo para esta sesión)
        configTab:AddButton({
            Title = "📂 Cargar configuración (esta sesión)",
            Callback = function()
                local selected = configDropdown:GetValue()
                if not selected or selected == "-- Sin configuraciones --" then
                    window:Notify({Title = "Error", Content = "No hay configuración seleccionada", Duration = 2})
                    return
                end
                
                local data = ConfigSystem:LoadConfig(selected)
                if data then
                    for id, value in pairs(data) do
                        if window._elements[id] and window._elements[id].SetValue then
                            window._elements[id]:SetValue(value)
                        end
                    end
                    window:Notify({Title = "Cargado", Content = "Configuración '" .. selected .. "' cargada (solo esta sesión)", Duration = 2})
                else
                    window:Notify({Title = "Error", Content = "No se pudo cargar la configuración", Duration = 2})
                end
            end
        })
        
        configTab:AddSection("Configuración automática")
        
        -- Toggle para auto-carga
        local autoLoadToggle = configTab:AddToggle({
            Id = "auto_load_toggle",
            Title = "Cargar configuración automáticamente al iniciar",
            Default = false,
            Callback = function(state)
                if state then
                    local selected = configDropdown:GetValue()
                    if selected and selected ~= "-- Sin configuraciones --" then
                        ConfigSystem:SetAutoLoad(true, selected)
                        window:Notify({Title = "Auto-carga activada", Content = "Se cargará '" .. selected .. "' al iniciar", Duration = 2})
                    else
                        autoLoadToggle:SetValue(false)
                        window:Notify({Title = "Error", Content = "Selecciona una configuración primero", Duration = 2})
                    end
                else
                    ConfigSystem:SetAutoLoad(false, nil)
                    window:Notify({Title = "Auto-carga desactivada", Content = "No se cargará ninguna configuración automática", Duration = 2})
                end
            end
        })
        
        -- Botón para forzar auto-carga ahora
        configTab:AddButton({
            Title = "🔄 Forzar auto-carga ahora",
            Callback = function()
                local data = ConfigSystem:AutoLoad()
                if data then
                    for id, value in pairs(data) do
                        if window._elements[id] and window._elements[id].SetValue then
                            window._elements[id]:SetValue(value)
                        end
                    end
                    window:Notify({Title = "Auto-cargado", Content = "Configuración cargada automáticamente", Duration = 2})
                else
                    window:Notify({Title = "Info", Content = "No hay configuración para auto-cargar o auto-carga desactivada", Duration = 2})
                end
            end
        })
        
        -- Mostrar carpeta donde se guardan las configuraciones
        configTab:AddSection("Información")
        configTab:AddParagraph({
            Title = "📁 Ubicación de configuraciones",
            Content = "Juego: " .. gameName .. "\nCarpeta: ModernUI_Configs/" .. safeGameName
        })
        
        -- Inicializar dropdown
        refreshDropdown()
        
        -- Auto-cargar si está activado
        local autoData = ConfigSystem:AutoLoad()
        if autoData then
            task.spawn(function()
                task.wait(0.5)
                for id, value in pairs(autoData) do
                    if window._elements[id] and window._elements[id].SetValue then
                        window._elements[id]:SetValue(value)
                    end
                end
                -- Actualizar el toggle para reflejar que auto-carga está activada
                if autoLoadToggle then
                    autoLoadToggle:SetValue(ConfigSystem._autoLoadEnabled)
                end
                window:Notify({Title = "Auto-carga", Content = "Configuración cargada automáticamente", Duration = 2})
            end)
        end
    end
    
    -- Método para añadir párrafo
    function window:AddParagraph(config)
        local tab = self._tabs[self._currentTab]
        if not tab then return end
        
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 50)
        frame.BackgroundColor3 = Style.BackgroundSecondary
        frame.BorderSizePixel = 0
        frame.Parent = tab.content
        applyCorner(frame, 6)
        
        local titleLabel = Instance.new("TextLabel")
        titleLabel.Size = UDim2.new(1, -20, 0, 20)
        titleLabel.Position = UDim2.new(0, 15, 0, 5)
        titleLabel.Text = config.Title or ""
        titleLabel.TextColor3 = Style.Accent
        titleLabel.TextSize = 14
        titleLabel.Font = Enum.Font.GothamBold
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        titleLabel.BackgroundTransparency = 1
        titleLabel.Parent = frame
        
        local contentLabel = Instance.new("TextLabel")
        contentLabel.Size = UDim2.new(1, -20, 0, 25)
        contentLabel.Position = UDim2.new(0, 15, 0, 25)
        contentLabel.Text = config.Content or ""
        contentLabel.TextColor3 = Style.TextDim
        contentLabel.TextSize = 12
        contentLabel.Font = Enum.Font.Gotham
        contentLabel.TextXAlignment = Enum.TextXAlignment.Left
        contentLabel.TextYAlignment = Enum.TextYAlignment.Top
        contentLabel.BackgroundTransparency = 1
        contentLabel.Parent = frame
    end
    
    return window
end

return ModernUI
